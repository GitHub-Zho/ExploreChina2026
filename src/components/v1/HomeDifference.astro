---
const fruits = [
  {
    id: 'people',
    label: 'A professional tour guide with UofT co-leads who actually live there',
    size: 172,
    left: '5%',
    top: '60px',
    pips: [
      { text: 'Your co-lead actually lives there.\nThey know the city the way locals do —\nthat\'s the culture itself.', x: 240, y: -110 },
      { text: 'A culture adventure\nwith friends.', x: 390, y: 20 },
      { text: 'Professional bilingual guides throughout —\nso nothing gets lost.', x: 310, y: 145 },
      { text: 'Your co-lead grew up here —\nfrom how people pay to how they eat,\nthey walk you into the culture\nfrom the inside.', x: 155, y: 245 },
    ],
  },
  {
    id: 'culture',
    label: 'Every layer of the culture',
    size: 158,
    left: '28%',
    top: '210px',
    pips: [
      { text: 'Designed by people who\'ve felt\nthe same cultural gap —\nthey know what\'s worth slowing down for.', x: -260, y: -120 },
      { text: 'Architecture, history, food culture, nightlife —\neverything has a story here,\nand you\'ll know it.', x: 240, y: -105 },
      { text: 'Hang out with local university students —\nthe way people actually connect here.', x: 250, y: 115 },
    ],
  },
  {
    id: 'live',
    label: 'For ten days, you\'re not a tourist.',
    size: 184,
    left: '55%',
    top: '28px',
    pips: [
      { text: 'No cash. Scan for anything.\nMove like you\'ve always been here.', x: -290, y: -85 },
      { text: 'Time built in to wander.\nGet a little lost.\nDraw your own map as you go.', x: 215, y: -75 },
      { text: 'By the end, you\'re not\npassing through —\nyou\'re part of it.', x: -270, y: 115 },
    ],
  },
  {
    id: 'memory',
    label: 'The moments that only happen on the road',
    size: 162,
    left: '75%',
    top: '172px',
    pips: [
      { text: 'The Friday night\nthat wasn\'t in the itinerary', x: -310, y: -110 },
      { text: 'Day one strangers.\nFriends by day ten.', x: -430, y: 35 },
      { text: 'You can\'t go back\nto a time like this —\nthis is the only moment it exists.', x: -310, y: 155 },
    ],
  },
];
---

<section class="hdiff">
  <div class="hdiff__intro">
    <p class="hdiff__eyebrow">What makes this different</p>
    <p class="hdiff__lead">Not just a trip. A chance to feel a world that is genuinely different.</p>
  </div>

  <div class="hdiff__stage" id="hdiff-stage">
    {fruits.map((fruit) => (
      <div
        class="hdiff__fruit"
        data-fruit-id={fruit.id}
        style={`--fruit-size:${fruit.size}px;--fruit-left:${fruit.left};--fruit-top:${fruit.top};`}
      >
        <button class="hdiff__core" aria-label={fruit.label}>
          <span class="hdiff__core-text">{fruit.label}</span>
          <span class="hdiff__core-ring" aria-hidden="true"></span>
        </button>
        {fruit.pips.map((pip, i) => (
          <div
            class="hdiff__pip"
            aria-hidden="true"
            style={`--px:${pip.x}px;--py:${pip.y}px;--pip-delay:${i * 0.07}s;`}
          >
            {pip.text}
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<!-- Mobile fullscreen overlay -->
<div class="hdiff__overlay" id="hdiff-overlay" role="dialog" aria-modal="true" aria-hidden="true">
  <button class="hdiff__overlay-close" id="hdiff-close" aria-label="Close">✕</button>
  <p class="hdiff__overlay-title" id="hdiff-overlay-title"></p>
  <div class="hdiff__overlay-pips" id="hdiff-overlay-pips"></div>
</div>

<script>
(function () {
  var isMobile = window.matchMedia('(max-width: 860px)').matches;

  if (!isMobile) {
    // Desktop: click to pin fruit on top; click again or outside to unpin
    var pinned = null;

    document.querySelectorAll('.hdiff__fruit').forEach(function (fruit) {
      fruit.addEventListener('click', function (e) {
        e.stopPropagation();
        if (pinned === fruit) {
          fruit.classList.remove('is-pinned');
          pinned = null;
        } else {
          if (pinned) pinned.classList.remove('is-pinned');
          fruit.classList.add('is-pinned');
          pinned = fruit;
        }
      });
    });

    document.addEventListener('click', function () {
      if (pinned) { pinned.classList.remove('is-pinned'); pinned = null; }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && pinned) { pinned.classList.remove('is-pinned'); pinned = null; }
    });
    return;
  }

  var overlay   = document.getElementById('hdiff-overlay');
  var title     = document.getElementById('hdiff-overlay-title');
  var pipsWrap  = document.getElementById('hdiff-overlay-pips');
  var closeBtn  = document.getElementById('hdiff-close');
  if (!overlay || !title || !pipsWrap || !closeBtn) return;

  var positions = [
    { top: '10%', left: '6%',  rotate: '-2.5deg' },
    { top: '32%', left: '18%', rotate: '1.5deg'  },
    { top: '54%', left: '5%',  rotate: '-1deg'   },
    { top: '72%', left: '14%', rotate: '2deg'    },
  ];

  document.querySelectorAll('.hdiff__fruit').forEach(function (fruit) {
    fruit.querySelector('.hdiff__core')?.addEventListener('click', function () {
      var labelEl = fruit.querySelector('.hdiff__core-text');
      var pipEls  = fruit.querySelectorAll('.hdiff__pip');
      if (!labelEl) return;

      title.textContent = labelEl.textContent || '';
      pipsWrap.innerHTML = '';

      pipEls.forEach(function (pip, i) {
        var el = document.createElement('div');
        el.className = 'hdiff__overlay-pip';
        el.textContent = pip.textContent || '';
        var pos = positions[i] || { top: (15 + i * 22) + '%', left: '8%', rotate: '0deg' };
        el.style.cssText = 'top:' + pos.top + ';left:' + pos.left + ';transform:rotate(' + pos.rotate + ')';
        pipsWrap.appendChild(el);
      });

      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeOverlay() {
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeOverlay);
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeOverlay();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeOverlay();
  });
}());
</script>
