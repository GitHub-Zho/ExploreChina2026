---
const { lang = 'en', route = 'east' } = Astro.props;
const zh = lang === 'zh';
const isSouth = route === 'south';

const rotatorItems = zh ? [
  { what: '历史',   desc: '塑造历史的思维与交流方式' },
  { what: '食物',   desc: '每道菜背后的故事与起源' },
  { what: '行程',   desc: '让一个地方鲜活的日常节奏' },
  { what: '旅行',   desc: '真正感受一个截然不同的世界的机会' },
] : [
  { what: 'history',    desc: 'the conversations and ways of thinking that shape it' },
  { what: 'food',       desc: 'the stories and origins behind every dish' },
  { what: 'activities', desc: 'the daily rhythms that make a place alive' },
  { what: 'a trip',     desc: 'a chance to feel a world that is genuinely different' },
];

const eastColumnsZh = [
  {
    cat: '吃',
    bg: '吃',
    tagline: '光美食就值这趟旅程',
    items: ['北京烤鸭', '小笼包', '炸酱面', '深夜火锅', '夜市小吃'],
    more: '更多等你发现',
  },
  {
    cat: '看',
    bg: '看',
    tagline: '那些真的值得来看的地方',
    items: ['长城（全天）', '故宫', '外滩夜景', '西湖（杭州）', '苏州古典园林'],
    more: '更多因路线而异',
  },
  {
    cat: '玩',
    bg: '玩',
    tagline: '只有在这里才能体验的事',
    items: ['高铁（时速350公里）', '逛电车展厅——一堆你从没听过的国产品牌', '茶道体验', '扎染手工艺', '汉服穿着', '中医体验（正骨、针灸——如果你敢的话）'],
    more: '更多待定',
  },
  {
    cat: '夜场',
    bg: '夜',
    tagline: '你回去之后还会聊的那些',
    items: ['夜市夜游', '结束派对', '城市自由日', '学生交流之夜'],
    more: '更多等大家一起决定',
  },
];

const eastColumnsEn = [
  {
    cat: 'Eat',
    bg: 'E',
    tagline: 'The food alone is worth the trip.',
    items: ['Peking duck', 'Xiaolongbao', 'Zhajiang noodles', 'Hot pot — late night', 'Night market snacks'],
    more: 'More along the way',
  },
  {
    cat: 'See',
    bg: 'S',
    tagline: 'The places that live up to the photos.',
    items: ['Great Wall — full day', 'Forbidden City', 'The Bund at night', 'West Lake, Hangzhou', 'Classical gardens, Suzhou'],
    more: 'More depending on route',
  },
  {
    cat: 'Try',
    bg: 'T',
    tagline: 'Things you can only do here.',
    items: ['High-speed rail — 350 km/h', "EV showroom crawl — every brand you've never heard of", 'Tea ceremony', 'Hand tie-dye (zha ran)', 'Hanfu dress-up', 'TCM — bone-setting & acupuncture if you dare'],
    more: 'More to be announced',
  },
  {
    cat: 'Go out',
    bg: 'G',
    tagline: "The parts you'll actually talk about after.",
    items: ['Night market runs', 'Closing party', 'Free city days', 'Student exchange nights'],
    more: "More depending on what the group finds",
  },
];

const southColumnsZh = [
  {
    cat: '吃',
    bg: '吃',
    tagline: '这条路线的食物，本身就是目的地',
    items: ['潮汕牛肉火锅（现切现涮）', '功夫茶——喝的是仪式，不是茶', '厦门沙茶面', '海蛎煎', '潮州手打牛肉丸'],
    more: '更多等你发现',
  },
  {
    cat: '看',
    bg: '看',
    tagline: '那些真的值得来看的地方',
    items: ['鼓浪屿——无车小岛，13国领事馆旧址', '泉州开元寺（唐代）', '潮州广济桥与古城', '深圳天际线与大芬油画村', '妈祖天后宫'],
    more: '更多因路线而异',
  },
  {
    cat: '玩',
    bg: '玩',
    tagline: '只有在这里才能体验的事',
    items: ['功夫茶道完整体验', '泉州海上丝绸之路博物馆', '宗祠参访与族谱寻根', '福建土楼（客家圆楼）', '高铁沿海路段'],
    more: '更多待定',
  },
  {
    cat: '夜场',
    bg: '夜',
    tagline: '你回去之后还会聊的那些',
    items: ['厦门中山路夜游', '深圳夜生活', '城市自由日', '结营之夜'],
    more: '更多等大家一起决定',
  },
];

const southColumnsEn = [
  {
    cat: 'Eat',
    bg: 'E',
    tagline: "The food on this route is the destination.",
    items: ['Chaoshan beef hotpot — fresh-cut, clear broth', 'Gongfu tea — ritual, not a drink', 'Xiamen shacha noodles', 'Oyster omelette', 'Hand-pounded Teochew beef balls'],
    more: 'More along the way',
  },
  {
    cat: 'See',
    bg: 'S',
    tagline: 'The places that live up to the photos.',
    items: ['Gulangyu Island — no cars, 13 former consulates', 'Kaiyuan Temple, Quanzhou (Tang dynasty)', 'Chaozhou Ancient City & Guangji Bridge', 'Shenzhen skyline & Dafen Oil Painting Village', 'Mazu Temple'],
    more: 'More depending on route',
  },
  {
    cat: 'Try',
    bg: 'T',
    tagline: 'Things you can only do here.',
    items: ['Gongfu tea ceremony — the full session', 'Quanzhou Maritime Silk Road Museum', 'Ancestral clan hall visit', 'Fujian Tulou (Hakka roundhouse)', 'Coastal high-speed rail leg'],
    more: 'More to be announced',
  },
  {
    cat: 'Go out',
    bg: 'G',
    tagline: "The parts you'll actually talk about after.",
    items: ['Xiamen Zhongshan Road at night', 'Shenzhen nightlife', 'Free city days', 'Closing night'],
    more: "More depending on what the group finds",
  },
];

const columns = zh
  ? (isSouth ? southColumnsZh : eastColumnsZh)
  : (isSouth ? southColumnsEn : eastColumnsEn);
---

<section class="trip-rundown">
  <div class="trip-rundown__inner">

    <div class="trip-rundown__header">
      <p class="trip-rundown__eyebrow">{zh ? '旅程体验' : 'The experience'}</p>
      <h2 class="trip-rundown__title">
        {zh ? '十天，你会经历这些' : 'Ten days. Here\'s what\'s in them.'}
      </h2>
      <div class="trip-rundown__nj" aria-live="polite">
        <div class="trip-rundown__nj-pair">
          <span class="trip-rundown__nj-label">{zh ? '不只是' : 'NOT JUST'}</span>
          <div class="trip-rundown__nj-swap trip-rundown__nj-swap--big">
            {rotatorItems.map((item, i) => (
              <span class={`trip-rundown__nj-item${i === 0 ? ' is-active' : ''}`}>{item.what}</span>
            ))}
          </div>
        </div>
        <div class="trip-rundown__nj-pair trip-rundown__nj-pair--but">
          <span class="trip-rundown__nj-label">{zh ? '而是' : 'BUT'}</span>
          <div class="trip-rundown__nj-swap trip-rundown__nj-swap--small">
            {rotatorItems.map((item, i) => (
              <span class={`trip-rundown__nj-item${i === 0 ? ' is-active' : ''}`}>{item.desc}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="trip-rundown__grid">
      {columns.map((col) => (
        <div class="trip-rundown__col">
          <span class="trip-rundown__bg-word" aria-hidden="true">{col.bg}</span>
          <h3 class="trip-rundown__cat">{col.cat}</h3>
          <p class="trip-rundown__tagline">{col.tagline}</p>
          <ul class="trip-rundown__list">
            {col.items.map(item => (
              <li class="trip-rundown__item">{item}</li>
            ))}
            <li class="trip-rundown__item trip-rundown__item--more">{col.more}</li>
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
(function () {
  var bigItems   = Array.from(document.querySelectorAll('.trip-rundown__nj-swap--big .trip-rundown__nj-item'));
  var smallItems = Array.from(document.querySelectorAll('.trip-rundown__nj-swap--small .trip-rundown__nj-item'));
  if (!bigItems.length || !smallItems.length) return;
  var current = 0;
  setInterval(function () {
    bigItems[current].classList.remove('is-active');
    smallItems[current].classList.remove('is-active');
    current = (current + 1) % bigItems.length;
    bigItems[current].classList.add('is-active');
    smallItems[current].classList.add('is-active');
  }, 5000);
}());
</script>
