---
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const rotatorItems = zh ? [
  { what: '历史',   desc: '塑造历史的思维与交流方式' },
  { what: '食物',   desc: '每道菜背后的故事与起源' },
  { what: '行程',   desc: '让一个地方鲜活的日常节奏' },
  { what: '旅行',   desc: '真正感受一个截然不同的世界的机会' },
] : [
  { what: 'history',    desc: 'the conversations and ways of thinking that shape it' },
  { what: 'food',       desc: 'the stories and origins behind every dish' },
  { what: 'activities', desc: 'the daily rhythms that make a place alive' },
  { what: 'a trip',     desc: 'a chance to feel a world that is genuinely different' },
];

const columns = zh ? [
  {
    cat: '吃',
    bg: '吃',
    tagline: '光美食就值这趟旅程',
    items: [
      '北京烤鸭',
      '小笼包',
      '炸酱面',
      '深夜火锅',
      '夜市小吃',
    ],
    more: '更多等你发现',
  },
  {
    cat: '看',
    bg: '看',
    tagline: '那些真的值得来看的地方',
    items: [
      '长城（全天）',
      '故宫',
      '外滩夜景',
      '西湖（杭州）',
      '苏州古典园林',
    ],
    more: '更多因路线而异',
  },
  {
    cat: '玩',
    bg: '玩',
    tagline: '只有在这里才能体验的事',
    items: [
      '高铁（时速350公里）',
      '逛电车展厅——一堆你从没听过的国产品牌',
      '茶道体验',
      '扎染手工艺',
      '汉服穿着',
      '中医体验（正骨、针灸——如果你敢的话）',
    ],
    more: '更多待定',
  },
  {
    cat: '夜场',
    bg: '夜',
    tagline: '你回去之后还会聊的那些',
    items: [
      '夜市夜游',
      '结束派对',
      '城市自由日',
      '学生交流之夜',
    ],
    more: '更多等大家一起决定',
  },
] : [
  {
    cat: 'Eat',
    bg: 'E',
    tagline: 'The food alone is worth the trip.',
    items: [
      'Peking duck',
      'Xiaolongbao',
      'Zhajiang noodles',
      'Hot pot — late night',
      'Night market snacks',
    ],
    more: 'More along the way',
  },
  {
    cat: 'See',
    bg: 'S',
    tagline: 'The places that live up to the photos.',
    items: [
      'Great Wall — full day',
      'Forbidden City',
      'The Bund at night',
      'West Lake, Hangzhou',
      'Classical gardens, Suzhou',
    ],
    more: 'More depending on route',
  },
  {
    cat: 'Try',
    bg: 'T',
    tagline: 'Things you can only do here.',
    items: [
      'High-speed rail — 350 km/h',
      "EV showroom crawl — every brand you've never heard of",
      'Tea ceremony',
      'Hand tie-dye (zha ran)',
      'Hanfu dress-up',
      'TCM — bone-setting & acupuncture if you dare',
    ],
    more: 'More to be announced',
  },
  {
    cat: 'Go out',
    bg: 'G',
    tagline: "The parts you'll actually talk about after.",
    items: [
      'Night market runs',
      'Closing party',
      'Free city days',
      'Student exchange nights',
    ],
    more: "More depending on what the group finds",
  },
];
---

<section class="trip-rundown">
  <div class="trip-rundown__inner">

    <div class="trip-rundown__header">
      <p class="trip-rundown__eyebrow">{zh ? '旅程体验' : 'The experience'}</p>
      <h2 class="trip-rundown__title">
        {zh ? '十天，你会经历这些' : 'Ten days. Here\'s what\'s in them.'}
      </h2>
      <div class="trip-rundown__nj" aria-live="polite">
        <div class="trip-rundown__nj-row">
          <span class="trip-rundown__nj-label">{zh ? '不只是' : 'NOT JUST'}</span>
          <div class="trip-rundown__nj-swap trip-rundown__nj-swap--big">
            {rotatorItems.map((item, i) => (
              <span class={`trip-rundown__nj-item${i === 0 ? ' is-active' : ''}`}>{item.what}</span>
            ))}
          </div>
        </div>
        <div class="trip-rundown__nj-row trip-rundown__nj-row--but">
          <span class="trip-rundown__nj-label">{zh ? '而是' : 'BUT'}</span>
          <div class="trip-rundown__nj-swap trip-rundown__nj-swap--small">
            {rotatorItems.map((item, i) => (
              <span class={`trip-rundown__nj-item${i === 0 ? ' is-active' : ''}`}>{item.desc}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="trip-rundown__grid">
      {columns.map((col) => (
        <div class="trip-rundown__col">
          <span class="trip-rundown__bg-word" aria-hidden="true">{col.bg}</span>
          <h3 class="trip-rundown__cat">{col.cat}</h3>
          <p class="trip-rundown__tagline">{col.tagline}</p>
          <ul class="trip-rundown__list">
            {col.items.map(item => (
              <li class="trip-rundown__item">{item}</li>
            ))}
            <li class="trip-rundown__item trip-rundown__item--more">{col.more}</li>
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
(function () {
  var bigItems   = Array.from(document.querySelectorAll('.trip-rundown__nj-swap--big .trip-rundown__nj-item'));
  var smallItems = Array.from(document.querySelectorAll('.trip-rundown__nj-swap--small .trip-rundown__nj-item'));
  if (!bigItems.length || !smallItems.length) return;
  var current = 0;
  setInterval(function () {
    bigItems[current].classList.remove('is-active');
    smallItems[current].classList.remove('is-active');
    current = (current + 1) % bigItems.length;
    bigItems[current].classList.add('is-active');
    smallItems[current].classList.add('is-active');
  }, 3200);
}());
</script>
