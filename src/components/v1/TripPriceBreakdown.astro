---
import { EAST_CHINA_PRICE_CAD } from '../../data/registry';
const { lang = 'en', route = 'east', price = EAST_CHINA_PRICE_CAD } = Astro.props;
const zh = lang === 'zh';

const eastItems = [
  { labelEn: 'Accommodation',       labelZh: '住宿',       noteEn: '4–5★ hotel, shared double room',        noteZh: '4–5星酒店，双人间',        amount: 700, pct: 29 },
  { labelEn: 'Food & dining',        labelZh: '餐饮',       noteEn: 'Local specialty restaurants daily',      noteZh: '每日特色餐厅',             amount: 600, pct: 25 },
  { labelEn: 'Activities & tickets', labelZh: '活动与门票', noteEn: 'Entrance fees + special programming',    noteZh: '景点门票及特色活动',       amount: 400, pct: 17 },
  { labelEn: 'Guide & local transport', labelZh: '导游及市内交通', noteEn: 'Professional guide + daily in-city', noteZh: '专业导游及每日市内交通', amount: 200, pct: 8  },
  { labelEn: 'City-to-city transfers',  labelZh: '城市间交通',    noteEn: 'High-speed rail & domestic flights', noteZh: '高铁及国内航班',         amount: 300, pct: 12 },
];

const southItems = [
  { labelEn: 'Accommodation',       labelZh: '住宿',       noteEn: '4–5★ hotel, shared double room',        noteZh: '4–5星酒店，双人间',        amount: 600, pct: 33 },
  { labelEn: 'Food & dining',        labelZh: '餐饮',       noteEn: 'Local specialty restaurants daily',      noteZh: '每日特色餐厅',             amount: 400, pct: 22 },
  { labelEn: 'Activities & tickets', labelZh: '活动与门票', noteEn: 'Entrance fees + special programming',    noteZh: '景点门票及特色活动',       amount: 300, pct: 17 },
  { labelEn: 'Guide & local transport', labelZh: '导游及市内交通', noteEn: 'Professional guide + daily in-city', noteZh: '专业导游及每日市内交通', amount: 300, pct: 17 },
  { labelEn: 'City-to-city transfers',  labelZh: '城市间交通',    noteEn: 'High-speed rail & coastal trains',   noteZh: '高铁及沿海列车',          amount: 200, pct: 11 },
];

const items = route === 'south' ? southItems : eastItems;
---

<section class="price-breakdown">
  <div class="price-breakdown__inner">

    <div class="price-breakdown__copy">
      <p class="price-breakdown__eyebrow">{zh ? '关于价格' : 'About the price'}</p>
      <h2 class="price-breakdown__title">
        {zh ? `CAD $${price.toLocaleString()}，钱花在了哪里` : `CAD $${price.toLocaleString()} — here's where it goes`}
      </h2>
      <p class="price-breakdown__hook">
        {zh
          ? '你要飞到地球另一端——来了，就要认真对待。'
          : "You're flying to the other side of the world. Make it count."
        }
      </p>

      <div class="price-breakdown__reveal">
        <p class="price-breakdown__reveal-trigger">
          {zh ? '为什么是这个价格？' : 'Why does it cost this much?'}
        </p>
        <div class="price-breakdown__reveal-body">
          {zh ? (
            <>
              <p>你或许能找到同价位、甚至更便宜的中国行程。但我们想做的，不是那种普通的旅行。</p>
              <p>不只是景点，还有游戏、派对、深夜美食、手工艺体验，以及真正与当地人相处的时间。这些都有成本。但这正是重点所在。</p>
              <strong>我们希望你离开时带走的是回忆，而不是遗憾。</strong>
            </>
          ) : (
            <>
              <p>You could find a similar itinerary for the same price. Maybe cheaper. But that kind of trip isn't what we're building.</p>
              <p>Not just the views — games, parties, local food nights, craft workshops, time with people who actually live there. That costs something. But that's exactly the point.</p>
              <strong>We designed this so you leave with memories, not regrets.</strong>
            </>
          )}
        </div>
      </div>
    </div>

    <div class="price-breakdown__bars">
      {items.map(item => (
        <div class="price-bar">
          <div class="price-bar__labels">
            <span class="price-bar__name">{zh ? item.labelZh : item.labelEn}</span>
            <span class="price-bar__amount">~${item.amount}</span>
          </div>
          <p class="price-bar__note">{zh ? item.noteZh : item.noteEn}</p>
          <div class="price-bar__track">
            <div class="price-bar__fill" style={`width: ${item.pct}%`}></div>
          </div>
        </div>
      ))}

      <div class="price-bar__total">
        <span>{zh ? '合计（不含机票）' : 'Total (excl. flights)'}</span>
        <span>~${price.toLocaleString()}</span>
      </div>

      <p class="price-breakdown__disclaimer">
        {zh ? '✈ 国际往返机票不含在内' : '✈ International flights not included'}
      </p>
    </div>

  </div>
</section>
