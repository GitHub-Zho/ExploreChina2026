---
const { isZh = false } = Astro.props;
---
<section class="hero" aria-label="Hero" id="overview">
  <div class="hero__bg">
    <img src="https://images.unsplash.com/photo-1508804185872-d7badad00f7d?auto=format&fit=crop&w=1920&q=85" alt="" aria-hidden="true" fetchpriority="high" />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__content">
    <p class="hero__eyebrow">{isZh ? 'UofT 探索旅行社团 · 文化系列' : 'UofT Exploration and Travel Club · Culture Series'}</p>
    <h1 class="hero__title">{isZh ? <>探索中国<br/>2026</> : <>Explore China<br/>2026</>}</h1>
    <p class="hero__standalone">{isZh ? '不只是旅行，而是真正感受一个截然不同的世界的机会。' : 'Not just a trip, but a chance to feel a world that is genuinely different.'}</p>
    <a href="https://www.instagram.com/camcapysoc" target="_blank" rel="noopener noreferrer" class="hero__prev-link">{isZh ? '查看往期行程 ↗' : 'See Previous Trips ↗'}</a>
  </div>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>
