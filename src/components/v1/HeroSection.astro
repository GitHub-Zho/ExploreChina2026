---
const { isZh = false } = Astro.props;
---
<section class="hero" aria-label="Hero" id="overview">
  <div class="hero__bg">
    <img src="https://images.unsplash.com/photo-1508804185872-d7badad00f7d?auto=format&fit=crop&w=1920&q=85" alt="" aria-hidden="true" fetchpriority="high" />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__content">
    <p class="hero__eyebrow">{isZh ? 'UofT 探索旅行社团' : 'UofT Travel Club'}</p>
    <h1 class="hero__title">{isZh ? <>文化探索<br/>2026</> : <>Cultural<br/>Exploration 2026</>}</h1>
    <p class="hero__explore">{isZh ? '探索中国' : 'Explore China'}</p>
    <p class="hero__sub">{isZh ? '由专业双语导游与UofT学生带队，10天游览上海、苏州、杭州与北京。' : 'Led by professional bilingual tour guides and UofT students. 10 days through Shanghai, Suzhou, Hangzhou, and Beijing.'}</p>
  </div>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span>Scroll</span>
    <div class="hero__scroll-line"></div>
  </div>
</section>
