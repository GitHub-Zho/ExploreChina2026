---
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const rotatorItems = zh ? [
  { what: '历史',   desc: '塑造历史的思维与交流方式' },
  { what: '食物',   desc: '每道菜背后的故事与起源' },
  { what: '行程',   desc: '让一个地方鲜活的日常节奏' },
  { what: '旅行',   desc: '真正感受一个截然不同的世界的机会' },
] : [
  { what: 'history',    desc: 'the conversations and ways of thinking that shape it' },
  { what: 'food',       desc: 'the stories and origins behind every dish' },
  { what: 'activities', desc: 'the daily rhythms that make a place alive' },
  { what: 'a trip',     desc: 'a chance to feel a world that is genuinely different' },
];
---

<section class="why-us">
  <div class="why-us__inner">
    <div class="why-us__header">
      <p class="why-us__eyebrow">{zh ? '为什么选我们' : 'Why this trip'}</p>
      <h2 class="why-us__title">
        {zh ? '不只是另一趟中国行' : "Not just another China trip."}
      </h2>

      <div class="why-us__nj-block" aria-live="polite">
        <div class="why-us__nj-row">
          <span class="why-us__nj-label">{zh ? '不只是' : 'NOT JUST'}</span>
          <div class="why-us__nj-swap why-us__nj-swap--big">
            {rotatorItems.map((item, i) => (
              <span class={`why-us__nj-item${i === 0 ? ' is-active' : ''}`}>{item.what}</span>
            ))}
          </div>
        </div>
        <div class="why-us__nj-row why-us__nj-row--but">
          <span class="why-us__nj-label">{zh ? '而是' : 'BUT'}</span>
          <div class="why-us__nj-swap why-us__nj-swap--small">
            {rotatorItems.map((item, i) => (
              <span class={`why-us__nj-item${i === 0 ? ' is-active' : ''}`}>{item.desc}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var bigItems   = Array.from(document.querySelectorAll('.why-us__nj-swap--big .why-us__nj-item'));
  var smallItems = Array.from(document.querySelectorAll('.why-us__nj-swap--small .why-us__nj-item'));
  if (!bigItems.length || !smallItems.length) return;
  var current = 0;
  setInterval(function () {
    bigItems[current].classList.remove('is-active');
    smallItems[current].classList.remove('is-active');
    current = (current + 1) % bigItems.length;
    bigItems[current].classList.add('is-active');
    smallItems[current].classList.add('is-active');
  }, 3200);
}());
</script>
