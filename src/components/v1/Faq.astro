---
const { isZh = false } = Astro.props;
const faqs = isZh
  ? [
      { question: '我不会说中文，能参加吗？', answer: '完全可以。我们全程双语支持，而且很多人正是因为不会中文才想来。语言不是障碍——它是体验的一部分。你会发现，一句"谢谢"能打开很多门。' },
      { question: '这和普通旅行团有什么区别？', answer: '没有导游举小旗、没有购物店、没有赶行程。我们更像是一群朋友一起旅行，只是有人提前帮你把住宿、交通和节奏都安排好了。你有自由时间去走自己想走的路。' },
      { question: '安全吗？我家人会担心', answer: '中国是全球治安最好的国家之一——这不是宣传，是你到了以后会亲自感受到的。我们全程有在地团队、提前确认的住宿、和紧急预案。但说实话，大部分参与者到了第二天就不再想这个问题了。' },
      { question: '我一个人报名会不会很尴尬？', answer: '大部分人都是一个人报名的。这也是我们设计行程的方式——通过一起吃饭、一起走路、一起迷路来认识彼此。很多人出发前是陌生人，回来后是朋友。' },
      { question: '报名流程是什么？', answer: '提交表单后，我们会在 24 小时内邮件联系你，聊聊你的背景和期望。确认合适后再谈下一步。不会上来就要订金——我们想先确认彼此都是对的人。' },
    ]
  : [
      { question: "I don't speak Chinese — can I still come?", answer: "Yes. Our team is fully bilingual and you'll have support throughout. Most people join precisely because they don't speak Chinese. It's not a barrier — it's part of what makes the trip worth taking. You'll be surprised how far a smile and \"xièxie\" can get you." },
      { question: "How is this different from a regular tour?", answer: "No tour guide with a flag. No gift shops. No being herded onto a bus. This is more like traveling with a group of friends who happen to have someone handling the logistics. You get free time, shared meals, and the space to actually feel each city — not just photograph it." },
      { question: "Is it safe? My parents are worried.", answer: "China is genuinely one of the safest countries in the world — not as a talking point, but as something you'll feel on day one. We have on-ground support, pre-confirmed stays, and contingency plans. But honestly, most participants stop thinking about safety by day two." },
      { question: "I'm applying alone — will it be awkward?", answer: "Most people apply solo. That's kind of the point. The route is designed so you get to know people through shared meals, walks, and getting happily lost together. A lot of strangers before the trip become friends after it." },
      { question: "What's the application process?", answer: "Submit the form. We'll email you within 5 business days to chat about your background and what you're hoping for. If it's a good fit, we talk next steps. No deposit upfront — we want to make sure we're right for each other first." },
    ];

const faqStructuredData = JSON.stringify(
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  null,
  2
);
---
<section class="faq" id="faq">
  <div class="container">
    <div class="section-header">
      <p class="section-eyebrow">{isZh ? '常见问题' : 'Questions'}</p>
      <h2 class="section-title">{isZh ? '报名前须知' : 'Before You Apply'}</h2>
    </div>
    <div class="faq__list">
      {faqs.map((item, i) => (
        <div class="faq__item" id={`faq-${i}`}>
          <button class="faq__q" aria-expanded="false" aria-controls={`faq-answer-${i}`}>
            <span>{item.question}</span>
            <svg class="faq__icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
          <div class="faq__a" id={`faq-answer-${i}`} role="region" aria-labelledby={`faq-${i}`}>
            <div class="faq__a-inner">{item.answer}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={faqStructuredData}></script>

<script is:inline>
  document.querySelectorAll('.faq__q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq__q').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      if (!expanded) btn.setAttribute('aria-expanded', 'true');
    });
  });
</script>
