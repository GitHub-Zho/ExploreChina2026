---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/v1/HeroSection.astro';
import DestinationCarousel from '../components/v1/DestinationCarousel.astro';
import DestinationGrid from '../components/v1/DestinationGrid.astro';
import Faq from '../components/v1/Faq.astro';
import { tripsMeta } from '../data/trips-meta.ts';

const homeStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Explore China core pages',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Explore China home',
      url: 'https://www.explorechina.ca/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '2026 China summer trip',
      url: 'https://www.explorechina.ca/trips/explore-china-2026-summer',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Participant handbook',
      url: 'https://www.explorechina.ca/handbook',
    },
  ],
};
---
<Layout
  title="Explore China 2026 | Student Travel Program from Canada"
  description="A student-led China cultural travel program for Canada-based students and young travelers, featuring Shanghai, Suzhou, Hangzhou, and Beijing."
  lang="en"
  alternateHref="/zh/"
  alternateLabel="中文"
  canonical="/"
  structuredData={homeStructuredData}
  heroNav={true}
>
  <HeroSection />

  <!-- ═══════════════════════════════════════════════════════════
       STORY SECTION — Version C look + Curtain + Version B Typewriter
  ════════════════════════════════════════════════════════════ -->
  <section id="story-section" class="story-c-section" aria-label="Our Story">

    <!-- STATE 1: Idle — Version C visual style -->
    <div class="story-c-inner" id="story-idle">
      <p class="story-c-item story-c-context" data-story-c-item style="opacity:0.5; font-size:clamp(14px,2vw,18px);">
        We went overseas to study. We thought we'd seen the world.
      </p>
      <p class="story-c-item story-c-hero" data-story-c-item>
        There's a version of the world you can only find by living in it.
      </p>
      <div class="story-drag-prompt story-c-item" id="story-drag-prompt" aria-hidden="true" data-story-c-item>
        <div class="story-drag-indicator">
          <div class="story-drag-line"></div>
          <div class="story-drag-circle">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1c1917" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 10h12"/>
              <path d="M12 6l4 4-4 4"/>
            </svg>
          </div>
          <div class="story-drag-line"></div>
        </div>
        <p class="story-drag-prompt__text">Swipe to reveal</p>
      </div>
    </div>

    <!-- STATE 2: Curtain overlay -->
    <div class="story-curtain" id="story-curtain" aria-hidden="true"></div>

    <!-- STATE 3: Typewriter — centred credits roll -->
    <div class="story-b-section" id="story-typewriter" aria-live="polite">
      <div class="story-poem" id="story-poem">
        <!-- poem lines appear here via JS -->
      </div>
      <!-- Replay — appears inside scroll after text -->
      <div class="story-replay" id="story-replay" role="button" tabindex="0" aria-label="Read again">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M29 18c0 6-4.9 11-11 11S7 24 7 18 11.9 7 18 7c3.3 0 6.2 1.4 8.2 3.7"/>
          <polyline points="27,5 27,12 20,12"/>
        </svg>
        <p class="story-replay__text">Read again</p>
      </div>
    </div>

    <!-- Noscript fallback: show Version C's 3 lines statically -->
    <noscript>
      <style>.story-c-inner { display: none !important; }</style>
      <div class="story-noscript">
        <p class="story-c-context">We went overseas to study. We thought we'd seen the world.</p>
        <p class="story-c-hero">There's a version of the world you can only find by living in it.</p>
        <p class="story-c-closer">Now we're in Canada. Your turn.</p>
      </div>
    </noscript>
  </section>

  <DestinationCarousel />
  <DestinationGrid />

  <!-- SEO context — visually subtle, content-rich for search engines -->
  <section class="section" style="padding: 1.5rem 2rem 0;">
    <div style="max-width:54rem; margin:0 auto; border-top:1px solid #e8e5e0; padding-top:1.5rem;">
      <p style="font-size:13px; line-height:1.9; color:#9a9590; margin-bottom:0.6rem;">This is a student-led China travel program designed for people in Canada who want more than a generic tour. It combines city highlights, social energy, practical support, and a route that feels manageable for first-time visitors.</p>
      <p style="font-size:13px; line-height:1.9; color:#9a9590;">Comparing student trips to China from Canada? See the <a href="/trips/explore-china-2026-summer" style="color:#b8524a;">full itinerary</a>, <a href="/handbook" style="color:#b8524a;">participant handbook</a>, and <a href="/about" style="color:#b8524a;">about page</a>.</p>
    </div>
  </section>

  <section id="itinerary" class="py-20">
    <div class="container">
      <p class="section-eyebrow">Our Routes</p>
      <h2 class="section-title">Choose Your China</h2>
      <div class="home-trip-grid mt-8">
        {tripsMeta.map((trip) => (
          trip.status === 'open' ? (
            <a href={trip.href} class="home-trip-card">
              <div class="home-trip-card__img">
                {trip.image && <img src={trip.image} alt={trip.imageAlt} loading="lazy" />}
              </div>
              <div class="home-trip-card__body">
                <p class="home-trip-card__subtitle">{trip.subtitle}</p>
                <h3 class="home-trip-card__title">{trip.title}</h3>
                <p class="home-trip-card__desc">{trip.description}</p>
                <span class="home-trip-card__cta">View itinerary →</span>
              </div>
            </a>
          ) : (
            <div class="home-trip-card home-trip-card--soon">
              <div class="home-trip-card__img home-trip-card__img--placeholder"></div>
              <div class="home-trip-card__body">
                <p class="home-trip-card__subtitle">{trip.subtitle}</p>
                <h3 class="home-trip-card__title">{trip.title}</h3>
                <p class="home-trip-card__desc">{trip.description}</p>
                <span class="home-trip-card__cta home-trip-card__cta--soon">Coming soon</span>
              </div>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <Faq />

  <section id="apply" class="py-20">
    <div class="container">
      <div style="max-width:44rem; margin:0 auto;">
      <p class="section-eyebrow">Contact</p>
      <h2 class="section-title" style="text-align:left;">Contact Us</h2>
      <p class="section-sub" style="max-width:none; margin:0 0 2rem;">ExploreChina is a student-run program — trips are organized in partnership with university clubs and student organizations. If you're interested in joining a trip, connect with a partner club at your school first. Use this form for general inquiries and we'll get back to you within 5 business days.</p>
      <form id="apply-form" class="grid md:grid-cols-2 gap-4" action="https://formsubmit.co/hello@explorechina.ca" method="POST">
        <input type="hidden" name="_subject" value="New Inquiry — Explore China" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value="https://www.explorechina.ca/#apply" />
        <input type="text" name="_honey" style="display:none" />
        <input class="border border-stone-300 p-3 bg-white" name="name" aria-label="Name" placeholder="Name" data-ph="Name" required />
        <input class="border border-stone-300 p-3 bg-white" name="email" type="email" aria-label="Email" placeholder="Email" data-ph="Email" required />
        <input class="border border-stone-300 p-3 bg-white" name="phone" aria-label="Phone" placeholder="Phone" data-ph="Phone" />
        <input class="border border-stone-300 p-3 bg-white" name="school" aria-label="Your university or school" placeholder="Your university / school" data-ph="Your university / school" />
        <textarea class="md:col-span-2 border border-stone-300 p-3 bg-white min-h-[120px]" name="goals" aria-label="Your message" placeholder="Your message" data-ph="Your message"></textarea>
        <button type="button" id="apply-btn" class="md:col-span-2 justify-self-start bg-red-700 text-white px-7 py-3 hover:bg-red-800 transition-colors">Send Message</button>
      </form>

      <!-- Confirmation Modal -->
      <div id="apply-modal" class="apply-modal" style="display:none">
        <div class="apply-modal__backdrop"></div>
        <div class="apply-modal__box">
          <h3 class="apply-modal__title">Confirm message</h3>
          <p class="apply-modal__text">Your message will be sent to our team. We'll get back to you by email within 5 business days.</p>
          <div class="apply-modal__actions">
            <button type="button" id="modal-cancel" class="apply-modal__btn apply-modal__btn--cancel">Cancel</button>
            <button type="button" id="modal-confirm" class="apply-modal__btn apply-modal__btn--confirm">Send message</button>
          </div>
        </div>
      </div>

      <!-- Toast notification -->
      <div id="apply-toast" class="apply-toast" style="display:none"></div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
.apply-modal { position:fixed; inset:0; z-index:9999; display:flex; align-items:center; justify-content:center; padding:1rem; }
.apply-modal__backdrop { position:absolute; inset:0; background:rgba(0,0,0,0.4); backdrop-filter:blur(4px); }
.apply-modal__box { position:relative; background:#fff; border-radius:12px; padding:2rem; max-width:420px; width:100%; box-shadow:0 20px 60px rgba(0,0,0,0.15); animation:modalIn 0.25s ease; }
@keyframes modalIn { from{opacity:0;transform:scale(0.95) translateY(8px)} to{opacity:1;transform:scale(1) translateY(0)} }
.apply-modal__title { font-size:1.25rem; font-weight:600; color:#1c1917; margin-bottom:0.5rem; }
.apply-modal__text { font-size:0.95rem; color:#78716c; line-height:1.6; margin-bottom:1.5rem; }
.apply-modal__actions { display:flex; gap:0.75rem; justify-content:flex-end; }
.apply-modal__btn { padding:0.6rem 1.25rem; border-radius:8px; font-size:0.9rem; font-weight:500; cursor:pointer; border:none; transition:background 0.2s; }
.apply-modal__btn--cancel { background:#f5f5f4; color:#57534e; }
.apply-modal__btn--cancel:hover { background:#e7e5e4; }
.apply-modal__btn--confirm { background:#b91c1c; color:#fff; }
.apply-modal__btn--confirm:hover { background:#991b1b; }
.apply-toast { position:fixed; bottom:2rem; left:50%; transform:translateX(-50%) translateY(20px); padding:1rem 2.5rem; border-radius:12px; font-size:1rem; font-weight:500; z-index:10000; opacity:0; transition:opacity 0.3s ease,transform 0.3s ease; pointer-events:none; min-width:320px; max-width:90vw; text-align:center; box-shadow:0 8px 30px rgba(0,0,0,0.15); }
.apply-toast.toast-visible { opacity:1; transform:translateX(-50%) translateY(0); }
.apply-toast.toast-success { background:#166534; color:#fff; }
.apply-toast.toast-error { background:#991b1b; color:#fff; }
</style>

<style>
/* ══ Story Section: Version C + Curtain + Version B Typewriter ══════════════ */

/* ── Container ─────────────────────────────────────────────── */
.story-c-section {
  position: relative;
  height: 100vh;
  height: 100dvh; /* dynamic viewport — accounts for mobile address bar */
  background: #fdfcfb;
  overflow: hidden;
  user-select: none;
  touch-action: manipulation;
}

/* ── STATE 1: Version C idle ────────────────────────────────── */
.story-c-inner {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2.5rem;
  padding: 4rem 2rem;
  text-align: center;
  z-index: 1;
  cursor: grab;
}
.story-c-inner:active { cursor: grabbing; }

.story-c-item {
  margin: 0;
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.story-c-item.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.story-c-context {
  font-size: 1rem;
  font-weight: 300;
  color: #78716c;
  line-height: 1.6;
}
@media (min-width: 768px) {
  .story-c-context { font-size: 1.125rem; }
}

.story-c-hero {
  font-size: clamp(1.875rem, 5vw, 3.75rem);
  font-weight: 600;
  color: #1c1917;
  line-height: 1.2;
}

.story-c-closer {
  font-size: 1rem;
  font-weight: 300;
  color: #78716c;
  line-height: 1.6;
}
@media (min-width: 768px) {
  .story-c-closer { font-size: 1.125rem; }
}

/* ── Drag prompt + indicator ─────────────────────────────────── */
.story-drag-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  margin: 1.5rem 0 0;
}
.story-drag-prompt__text {
  font-size: 0.8rem;
  color: #a8a09a;
  font-weight: 300;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin: 0;
}
.story-drag-indicator {
  display: flex;
  align-items: center;
  gap: 0;
}
.story-drag-line {
  width: 48px;
  height: 1px;
  background: #d6d3d1;
}
.story-drag-circle {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid #d6d3d1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  animation: dragPulse 2.5s ease-in-out infinite;
  flex-shrink: 0;
}
.story-drag-circle svg {
  animation: dragArrow 2.5s ease-in-out infinite;
}
@keyframes dragPulse {
  0%, 100% { transform: scale(1); border-color: #d6d3d1; }
  50% { transform: scale(1.08); border-color: #a8a09a; }
}
@keyframes dragArrow {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(3px); }
}

/* ── STATE 2: Curtain ───────────────────────────────────────── */
.story-curtain {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #fdfcfb;
  transform: translateX(-100%);
  z-index: 3;
  will-change: transform;
  box-shadow: 6px 0 24px rgba(28, 25, 23, 0.12);
}

/* ── STATE 3: Typewriter — Version B ────────────────────────── */
.story-b-section {
  position: absolute;
  inset: 0;
  background: #fdfcfb;
  display: none; /* set to flex by JS when active */
  align-items: center;
  justify-content: center;
  z-index: 4;
  transition: background-color 1.5s ease;
}

/* Poem container — like an open book page */
.story-poem {
  max-width: 38rem;
  width: 100%;
  margin: 0 auto;
  padding: 0 2.5rem;
  text-align: left;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  /* Fixed top anchor — lines grow downward, no jump */
  position: absolute;
  top: 25vh;
  left: 50%;
  transform: translateX(-50%);
}

/* Breathing dot between pages */
:global(.poem-breath) {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #a8998a;
  opacity: 0;
  margin: 1.2rem 0 0 0.2rem;
  align-self: flex-start;
  animation: breathPulse 1.2s ease-in-out infinite;
}
@keyframes breathPulse {
  0%, 100% { opacity: 0.2; transform: scale(0.8); }
  50% { opacity: 0.5; transform: scale(1); }
}

:global(.poem-line) {
  font-size: clamp(1.25rem, 2.8vw + 0.4rem, 1.65rem);
  font-weight: 300;
  color: #78716c;
  line-height: 1.75;
  margin: 0 0 1rem 0;
  opacity: 0;
  visibility: hidden;
  transform: translateY(12px);
  transition: opacity 1s ease, transform 1s ease, visibility 0s;
  width: 100%;
  text-align: left;
  align-self: flex-start;
}

:global(.poem-line.is-visible) {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

:global(.poem-line.is-fading) {
  opacity: 0;
  transform: translateY(-6px);
  transition: opacity 1.4s ease-out, transform 1.4s ease-out;
}

/* Progressive color deepening — later lines get darker */
:global(.poem-line.tone-1) { color: #78716c; }
:global(.poem-line.tone-2) { color: #6b6560; }
:global(.poem-line.tone-3) { color: #57534e; }
:global(.poem-line.tone-4) { color: #44403c; }

:global(.poem-line.is-hero) {
  font-size: clamp(1.5rem, 3.5vw + 0.3rem, 2.1rem);
  font-weight: 500;
  color: #1c1917;
  line-height: 1.5;
  margin: 0.5rem 0 1.2rem;
  text-align: center;
  align-self: center;
  filter: blur(8px);
  transform: scale(0.96);
  transition: opacity 1.2s ease, transform 1.2s ease, filter 1.2s ease;
}

:global(.poem-line.is-hero.is-visible) {
  filter: blur(0);
  transform: scale(1);
  visibility: visible;
}

:global(.poem-line.is-final) {
  font-size: clamp(1.6rem, 3.8vw + 0.3rem, 2.3rem);
  font-weight: 600;
  color: #1c1917;
  letter-spacing: 0.02em;
  text-align: center;
  align-self: center;
  filter: blur(6px);
  transform: scale(0.94);
  transition: opacity 1.4s ease, transform 1.4s ease, filter 1.4s ease;
}

:global(.poem-line.is-final.is-visible) {
  filter: blur(0);
  transform: scale(1);
  visibility: visible;
}



/* ── Replay button ──────────────────────────────────────────── */
.story-replay {
  display: none;
  flex-direction: column;
  align-items: center;
  gap: 0;
  cursor: pointer;
  opacity: 0;
  color: #a8a09a;
  transition: opacity 0.6s ease;
  position: absolute;
  bottom: 15%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
}
.story-replay svg {
  transition: transform 0.6s ease;
}
.story-replay:hover {
  opacity: 0.85 !important;
}
.story-replay:hover svg {
  transform: rotate(360deg);
}
.story-replay__text {
  margin: 0.5rem 0 0;
  font-size: 0.8rem;
  color: #a8a09a;
  letter-spacing: 0.1em;
  font-weight: 300;
}

/* ── Mobile adjustments ─────────────────────────────────────── */
@media (max-width: 767px) {
  .story-c-inner {
    gap: 2rem;
    padding: 3rem 1.5rem;
  }
  .story-c-hero {
    font-size: clamp(1.5rem, 6vw, 2.25rem);
  }
  .story-drag-line { width: 32px; }
  .story-drag-circle { width: 40px; height: 40px; }
  .story-b-text-wrap {
    font-size: clamp(1rem, 4vw, 1.25rem);
    line-height: 1.8;
    padding: 0 0.5rem;
    min-height: 4rem;
  }
}

/* ── Noscript fallback ──────────────────────────────────────── */
.story-noscript {
  display: none;
  max-width: 38rem;
  margin: 0 auto;
  padding: 8rem 2rem;
  text-align: center;
}
.story-noscript p { margin: 0 0 1.25rem 0; }

/* ── Yunnan Toast ───────────────────────────────────────────── */
.yunnan-toast {
  position: fixed;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: #1c1917;
  color: #fff;
  padding: 0.875rem 1.5rem;
  border-radius: 8px;
  font-size: 0.95rem;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  z-index: 9999;
  transition: none;
}
.yunnan-toast.toast-show {
  animation: toastFade 3.4s ease forwards;
}
@keyframes toastFade {
  0%   { opacity: 0; transform: translateX(-50%) translateY(20px); }
  12%  { opacity: 1; transform: translateX(-50%) translateY(0); }
  75%  { opacity: 1; transform: translateX(-50%) translateY(0); }
  100% { opacity: 0; transform: translateX(-50%) translateY(20px); }
}
</style>

<script is:inline>
(function () {
  'use strict';

  /* ── Utils ──────────────────────────────────────────────── */
  function sleep(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }

  /* ── Elements ───────────────────────────────────────────── */
  var section    = document.getElementById('story-section');
  var idle       = document.getElementById('story-idle');
  var curtain    = document.getElementById('story-curtain');
  var typewriter = document.getElementById('story-typewriter');

  if (!section || !idle || !curtain || !typewriter) return;

  /* ── Fade-in idle items via IntersectionObserver (re-triggers) */
  var storyItems = idle.querySelectorAll('[data-story-c-item]');
  var itemObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      } else {
        entry.target.classList.remove('is-visible');
      }
    });
  }, { threshold: 0.15 });
  storyItems.forEach(function (el, i) {
    el.style.transitionDelay = (i * 0.15) + 's';
    itemObs.observe(el);
  });

  /* ── Sentences — gap = pause BEFORE this line appears ──── */
  var sentences = [
    { text: "We went overseas to study.", hold: 2200, gap: 0 },
    { text: "We thought we'd seen the world.", hold: 2000, gap: 500 },
    { text: "But there's a difference between passing through a place —", hold: 1800, gap: 0 },
    { text: "and letting it pass through you.", hold: 2800, gap: 250 },
    { text: "Eating where the locals eat.", hold: 1800, gap: 0 },
    { text: "Getting lost in streets that don't need you to understand them.", hold: 2200, gap: 400 },
    { text: "Falling into someone else's rhythm — and forgetting your own.", hold: 2800, gap: 500 },
    { text: "There's a version of the world you can only find by living in it.", hold: 4000, centre: true, gap: 800 },
    { text: "Friends kept asking — what's China actually like?", hold: 2200, gap: 0 },
    { text: "We never had a good answer.", hold: 2200, gap: 300 },
    { text: "We wanted to say: come see for yourself.", hold: 2000, gap: 0 },
    { text: "So we built a way for them to.", hold: 2800, gap: 350 },
    { text: "Not a tour. A way in.", hold: 3000, gap: 0 },
    { text: "Your turn.", hold: 0, gap: 900 }
  ];

  /* ── Credits roll state ─────────────────────────────────── */
  var twRunning  = false;
  var twPaused   = false;
  var twStarted  = false;
  var replayEl = document.getElementById('story-replay');
  var poemEl   = document.getElementById('story-poem');

  /* ── Poem pages — sentences grouped into "pages" ─────────── */
  var pages = [
    [0, 1],        /* We went overseas… / We thought… */
    [2, 3],        /* But there's a difference… / and letting it… */
    [4, 5, 6],     /* Eating… / Getting lost… / Falling into… */
    [7],           /* There's a version… (hero, solo) */
    [8, 9],        /* Friends kept asking… / We never had… */
    [10, 11],      /* We wanted to say… / So we built… */
    [12, 13],      /* Not a tour… / Your turn. */
  ];

  /* Background warmth progression per page */
  var bgColors = ['#fdfcfb', '#fdfbf9', '#faf8f5', '#f8f5f0', '#f7f4ee', '#f6f3ec', '#f5f1e9'];

  /* Tone class per page (progressive darkening) */
  var tonePerPage = ['tone-1', 'tone-1', 'tone-2', '', 'tone-2', 'tone-3', 'tone-4'];

  /* Staggered fade-out: top line fades first, each subsequent 120ms later */
  async function fadeOutPage(els) {
    /* All lines fade out together */
    for (var i = 0; i < els.length; i++) {
      els[i].classList.remove('is-visible');
      els[i].classList.add('is-fading');
    }
    await sleep(1400);
    for (var i = 0; i < els.length; i++) {
      if (els[i].parentNode) els[i].parentNode.removeChild(els[i]);
    }
  }

  async function creditsRoll() {
    if (!poemEl) return;
    poemEl.innerHTML = '';
    var tw = document.getElementById('story-typewriter');
    if (tw) tw.style.backgroundColor = bgColors[0];
    await sleep(600);

    for (var pi = 0; pi < pages.length; pi++) {
      if (!twRunning) return;
      var page = pages[pi];
      var pageEls = [];

      /* Warm the background */
      if (tw && bgColors[pi]) {
        tw.style.backgroundColor = bgColors[pi];
      }

      for (var li = 0; li < page.length; li++) {
        if (!twRunning) return;
        var idx = page[li];
        var s = sentences[idx];

        /* Variable gap before this line */
        if (s.gap > 0) await sleep(s.gap);

        var p = document.createElement('p');
        p.textContent = s.text;
        p.classList.add('poem-line');
        if (s.centre) p.classList.add('is-hero');
        if (idx === sentences.length - 1) p.classList.add('is-final');
        /* Progressive tone */
        if (tonePerPage[pi] && !s.centre && idx !== sentences.length - 1) {
          p.classList.add(tonePerPage[pi]);
        }
        poemEl.appendChild(p);
        pageEls.push(p);

        /* Trigger reflow then reveal */
        void p.offsetHeight;
        await sleep(60);
        p.classList.add('is-visible');

        /* Base pause between lines (shorter for tight pairs) */
        var basePause = 500;
        await sleep(basePause);
        while (twPaused) { await sleep(100); if (!twRunning) return; }
      }

      /* Show breathing dot alongside last line (not after waiting) */
      var breathDot = null;
      if (pi < pages.length - 1) {
        breathDot = document.createElement('div');
        breathDot.classList.add('poem-breath');
        poemEl.appendChild(breathDot);
        void breathDot.offsetHeight;
        breathDot.style.opacity = '1';
      }

      /* Hold the complete page for reading (dot is already pulsing) */
      var lastS = sentences[page[page.length - 1]];
      var holdTime = lastS.hold > 0 ? lastS.hold : 2000;

      var holdStart = Date.now();
      while (Date.now() - holdStart < holdTime) {
        if (!twRunning) return;
        while (twPaused) { await sleep(100); if (!twRunning) return; }
        await sleep(50);
      }

      if (pi < pages.length - 1) {
        /* Fade out dot */
        if (breathDot) {
          breathDot.style.transition = 'opacity 0.5s ease';
          breathDot.style.opacity = '0';
          await sleep(500);
          if (breathDot.parentNode) breathDot.parentNode.removeChild(breathDot);
        }
        /* Then fade out text */
        await fadeOutPage(pageEls);
      }
    }

    /* ── Finished — show replay ────────────────────────────── */
    twRunning = false;
    unlockScroll();
    await sleep(1200);
    if (replayEl) {
      replayEl.style.display = 'flex';
      replayEl.style.opacity = '0';
      requestAnimationFrame(function () {
        replayEl.style.transition = 'opacity 0.6s ease';
        replayEl.style.opacity = '0.6';
      });
    }
  }

  function startTypewriter() {
    /* Snap section to viewport immediately */
    section.scrollIntoView({ behavior: 'auto', block: 'start' });
    if (poemEl) poemEl.innerHTML = '';
    twRunning = true;
    lockScroll();
    creditsRoll();
  }

  /* ── Replay click handler ───────────────────────────────── */
  if (replayEl) {
    replayEl.addEventListener('click', function () {
      replayEl.style.transition = 'opacity 0.3s ease';
      replayEl.style.opacity = '0';
      /* Lock and snap FIRST, then start */
      lockScroll();
      setTimeout(function () {
        replayEl.style.display = 'none';
        startTypewriter();
      }, 350);
    });
    replayEl.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        replayEl.click();
      }
    });
  }

  /* ── Curtain completion ─────────────────────────────────── */
  var curtainDone = false;

  function completeCurtain() {
    if (curtainDone) return;
    curtainDone = true;

    curtain.style.transition = 'transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    curtain.style.transform  = 'translateX(0)';

    setTimeout(function () {
      idle.style.display       = 'none';
      curtain.style.display    = 'none';
      typewriter.style.display = 'flex';

      if (!twStarted) {
        twStarted = true;
        setTimeout(function () {
          startTypewriter();
        }, 600);
      }
    }, 520);
  }

  function snapBack() {
    curtain.style.transition = 'transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    curtain.style.transform  = 'translateX(-100%)';
  }

  /* ── Drag BACK from typewriter to idle ───────────────────── */
  function returnToIdle() {
    twRunning = false;
    /* Keep scroll locked during transition — snap to section first */
    section.scrollIntoView({ behavior: 'auto', block: 'start' });
    curtainDone = false;
    twStarted = false;
    if (replayEl) { replayEl.style.display = 'none'; replayEl.style.opacity = '0'; }
    if (poemEl) poemEl.innerHTML = '';

    /* Show curtain covering section, then slide it away to reveal idle */
    curtain.style.display = '';
    curtain.style.transition = 'none';
    curtain.style.transform = 'translateX(0)';
    idle.style.display = '';

    requestAnimationFrame(function () {
      typewriter.style.display = 'none';
      curtain.style.transition = 'transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      curtain.style.transform = 'translateX(100%)'; /* slide out to right */
      setTimeout(function () {
        curtain.style.transform = 'translateX(-100%)'; /* reset for next drag-in */
        curtain.style.transition = 'none';
        unlockScroll(); /* only unlock AFTER transition completes */
      }, 520);
    });
  }

  /* Drag-back on typewriter: mouse */
  var backMouseStartX = null;
  var backMouseDown = false;

  typewriter.addEventListener('mousedown', function (e) {
    backMouseStartX = e.clientX;
    backMouseDown = true;
  });
  document.addEventListener('mousemove', function (e) {
    if (!backMouseDown || backMouseStartX === null) return;
    var dx = backMouseStartX - e.clientX; /* drag LEFT = positive */
    if (dx > section.offsetWidth * 0.15) {
      backMouseDown = false;
      backMouseStartX = null;
      returnToIdle();
    }
  });
  document.addEventListener('mouseup', function () {
    backMouseDown = false;
    backMouseStartX = null;
  });

  /* Drag-back on typewriter: touch */
  var backTouchStartX = null;
  var backTouchStartY = null;
  var backTouching = false;
  var backTouchLocked = false;

  typewriter.addEventListener('touchstart', function (e) {
    backTouchStartX = e.touches[0].clientX;
    backTouchStartY = e.touches[0].clientY;
    backTouching = true;
    backTouchLocked = false;
  }, { passive: true });

  typewriter.addEventListener('touchmove', function (e) {
    if (!backTouching || backTouchStartX === null) return;
    var dx = backTouchStartX - e.touches[0].clientX;
    var dy = Math.abs(e.touches[0].clientY - backTouchStartY);
    if (!backTouchLocked && Math.abs(dx) + dy > 10) {
      if (Math.abs(dx) > dy && dx > 0) {
        backTouchLocked = true;
      } else {
        backTouching = false;
        return;
      }
    }
    if (backTouchLocked && dx > section.offsetWidth * 0.15) {
      backTouching = false;
      backTouchStartX = null;
      returnToIdle();
    }
  }, { passive: true });

  typewriter.addEventListener('touchend', function () {
    backTouching = false;
    backTouchStartX = null;
    backTouchStartY = null;
    backTouchLocked = false;
  });

  /* ── Shared drag logic ──────────────────────────────────── */
  var THRESHOLD = 0.3; /* 30% = easier to trigger */

  function onDragMove(startX, clientX) {
    var dx       = Math.abs(clientX - startX);
    var sectionW = section.offsetWidth;
    var progress = Math.min(dx / sectionW, 1);
    /* translateX from -100% to 0 */
    var translate = -100 + (progress * 100);
    curtain.style.transform = 'translateX(' + translate + '%)';
    return progress;
  }

  function onDragEnd(progress) {
    if (curtainDone) return;
    if (progress >= THRESHOLD) {
      completeCurtain();
    } else {
      snapBack();
    }
  }

  /* ── Desktop mouse drag ─────────────────────────────────── */
  var mouseStartX = null;
  var mouseDown   = false;
  var mouseProgress = 0;

  idle.addEventListener('mousedown', function (e) {
    if (curtainDone) return;
    mouseStartX   = e.clientX;
    mouseDown     = true;
    mouseProgress = 0;
    curtain.style.transition = 'none';
  });

  document.addEventListener('mousemove', function (e) {
    if (!mouseDown || mouseStartX === null) return;
    mouseProgress = onDragMove(mouseStartX, e.clientX);
    if (mouseProgress >= 1) {
      mouseDown = false;
      mouseStartX = null;
      completeCurtain();
    }
  });

  document.addEventListener('mouseup', function (e) {
    if (!mouseDown) return;
    mouseDown = false;
    var prog = mouseStartX !== null
      ? Math.min(Math.max(e.clientX - mouseStartX, 0) / section.offsetWidth, 1)
      : mouseProgress;
    mouseStartX   = null;
    mouseProgress = 0;
    onDragEnd(prog);
  });

  /* ── Mac trackpad / wheel drag (two-finger swipe) ────────── */
  var wheelAccum = 0;
  var wheelTimer = null;
  var wheelActive = false;

  idle.addEventListener('wheel', function (e) {
    if (curtainDone) return;
    /* Only respond to horizontal scroll (Mac two-finger) */
    if (Math.abs(e.deltaX) < Math.abs(e.deltaY) * 0.5) return;
    e.preventDefault();

    if (!wheelActive) {
      wheelActive = true;
      curtain.style.transition = 'none';
    }

    wheelAccum += e.deltaX;
    var progress = Math.min(Math.max(wheelAccum / (section.offsetWidth * 0.15), 0), 1);
    var translate = -100 + (progress * 100);
    curtain.style.transform = 'translateX(' + translate + '%)';

    /* Auto-complete if past threshold */
    if (progress >= 1) {
      wheelAccum = 0;
      wheelActive = false;
      if (wheelTimer) clearTimeout(wheelTimer);
      completeCurtain();
      return;
    }

    /* Reset accumulator after inactivity */
    if (wheelTimer) clearTimeout(wheelTimer);
    wheelTimer = setTimeout(function () {
      if (curtainDone) return;
      var finalProgress = Math.min(Math.max(wheelAccum / (section.offsetWidth * 0.15), 0), 1);
      wheelAccum = 0;
      wheelActive = false;
      onDragEnd(finalProgress);
    }, 200);
  }, { passive: false });

  /* ── Mac trackpad drag-back from typewriter ─────────────── */
  var backWheelAccum = 0;
  var backWheelTimer = null;

  typewriter.addEventListener('wheel', function (e) {
    if (Math.abs(e.deltaX) < Math.abs(e.deltaY) * 0.5) return;
    /* Only respond to leftward swipe (negative deltaX) */
    if (e.deltaX >= 0) { backWheelAccum = 0; return; }

    backWheelAccum += Math.abs(e.deltaX);
    if (backWheelAccum > section.offsetWidth * 0.15) {
      backWheelAccum = 0;
      if (backWheelTimer) clearTimeout(backWheelTimer);
      returnToIdle();
      return;
    }

    if (backWheelTimer) clearTimeout(backWheelTimer);
    backWheelTimer = setTimeout(function () { backWheelAccum = 0; }, 300);
  }, { passive: true });

  /* ── Mobile touch drag ──────────────────────────────────── */
  var touchStartX   = null;
  var touchStartY   = null;
  var touching      = false;
  var touchProgress = 0;
  var touchLocked   = false; /* true = horizontal drag committed */

  idle.addEventListener('touchstart', function (e) {
    if (curtainDone) return;
    touchStartX   = e.touches[0].clientX;
    touchStartY   = e.touches[0].clientY;
    touching      = true;
    touchProgress = 0;
    touchLocked   = false;
    curtain.style.transition = 'none';
  }, { passive: true });

  idle.addEventListener('touchmove', function (e) {
    if (!touching || touchStartX === null) return;
    var dx = Math.abs(e.touches[0].clientX - touchStartX);
    var dy = Math.abs(e.touches[0].clientY - touchStartY);

    /* Decide direction on first significant move */
    if (!touchLocked && dx + dy > 10) {
      if (dx > dy) {
        touchLocked = true; /* horizontal — we own this gesture */
      } else {
        /* vertical scroll — abort drag */
        touching = false;
        touchStartX = null;
        return;
      }
    }

    if (touchLocked) {
      e.preventDefault(); /* stop vertical scroll while dragging */
      touchProgress = onDragMove(touchStartX, e.touches[0].clientX);
      if (touchProgress >= 1) {
        touching = false;
        touchStartX = null;
        completeCurtain();
      }
    }
  }, { passive: false });

  idle.addEventListener('touchend', function () {
    if (!touching) return;
    touching = false;
    var prog = touchProgress;
    touchStartX   = null;
    touchStartY   = null;
    touchProgress = 0;
    touchLocked   = false;
    onDragEnd(prog);
  });

  /* ── Scroll lock: keep section pinned while typewriter plays ── */
  var scrollLocked = false;
  var lockTimeout = null;

  function lockScroll() {
    scrollLocked = true;
    /* Snap section to top of viewport */
    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function unlockScroll() {
    scrollLocked = false;
  }

  /* When locked, if user scrolls away, pull them back — unless they scroll past 50% */
  window.addEventListener('scroll', function () {
    if (!scrollLocked) return;
    var rect = section.getBoundingClientRect();
    var viewH = window.innerHeight;
    var visibleRatio = Math.max(0, Math.min(rect.bottom, viewH) - Math.max(rect.top, 0)) / viewH;

    if (visibleRatio < 0.5) {
      /* User scrolled past 50% — let them go */
      unlockScroll();
    } else if (Math.abs(rect.top) > 60) {
      /* Drifted but not past 50% — snap back */
      if (lockTimeout) clearTimeout(lockTimeout);
      lockTimeout = setTimeout(function () {
        if (scrollLocked) {
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 150);
    }
  }, { passive: true });

  /* ── IntersectionObserver: pause/resume typewriter ──────── */
  var sectionObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      twPaused = !entry.isIntersecting;
    });
  }, { threshold: 0.2 });
  sectionObs.observe(section);

  /* ── Misc: form placeholders ────────────────────────────── */
  var phAttr = 'pl' + 'ace' + 'holder';
  document.querySelectorAll('[data-ph]').forEach(function (el) {
    el.setAttribute(phAttr, el.getAttribute('data-ph') || '');
  });

  /* ── Yunnan toast ───────────────────────────────────────── */
  document.getElementById('yunnan-card')?.addEventListener('click', function () {
    var toast = document.getElementById('yunnan-toast');
    if (!toast) return;
    toast.classList.remove('toast-show');
    void toast.offsetWidth;
    toast.classList.add('toast-show');
    setTimeout(function () { toast.classList.remove('toast-show'); }, 3500);
  });
}());

/* ── Apply form: confirmation modal + async submit + toast ── */
(function () {
  var form = document.getElementById('apply-form');
  var btn = document.getElementById('apply-btn');
  var modal = document.getElementById('apply-modal');
  var cancelBtn = document.getElementById('modal-cancel');
  var confirmBtn = document.getElementById('modal-confirm');
  var toast = document.getElementById('apply-toast');
  if (!form || !btn || !modal) return;

  function showToast(msg, type) {
    toast.textContent = msg;
    toast.className = 'apply-toast toast-visible ' + (type === 'success' ? 'toast-success' : 'toast-error');
    toast.style.display = 'block';
    setTimeout(function () {
      toast.classList.remove('toast-visible');
      setTimeout(function () { toast.style.display = 'none'; }, 300);
    }, 3500);
  }

  function showModal() { modal.style.display = 'flex'; }
  function hideModal() { modal.style.display = 'none'; }

  btn.addEventListener('click', function () {
    var name = form.querySelector('[name="name"]');
    var email = form.querySelector('[name="email"]');
    if (!name.value.trim() || !email.value.trim()) {
      showToast('Please fill in your name and email.', 'error');
      return;
    }
    if (email.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
      showToast('Please enter a valid email address.', 'error');
      return;
    }
    showModal();
  });

  cancelBtn.addEventListener('click', hideModal);
  modal.querySelector('.apply-modal__backdrop').addEventListener('click', hideModal);

  confirmBtn.addEventListener('click', function () {
    hideModal();
    confirmBtn.disabled = true;
    btn.textContent = 'Sending...';
    btn.disabled = true;

    var formData = new FormData(form);
    fetch(form.action, {
      method: 'POST',
      body: formData,
      headers: { 'Accept': 'application/json' }
    }).then(function (res) {
      if (res.ok) {
        showToast('✓ Application sent! We\'ll be in touch within 5 business days.', 'success');
        form.reset();
      } else {
        showToast('Something went wrong. Please try again or email us directly.', 'error');
      }
    }).catch(function () {
      showToast('Network error. Please check your connection and try again.', 'error');
    }).finally(function () {
      btn.textContent = 'Submit Application';
      btn.disabled = false;
      confirmBtn.disabled = false;
    });
  });
}());
</script>
