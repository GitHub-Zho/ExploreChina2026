---
import Layout from '../../../layouts/Layout.astro';
import {
  currentTrip,
  faqZh,
  includedZh,
  notIncludedZh,
  cityGuides,
  itinerary,
  recommendedVideos,
} from '../../../data/site';

// Pre-compute slides for each day in the frontmatter
type LandmarkItemEC = { name: string; nameZh: string; image: string; background: string; backgroundZh: string };
type CitySlidEC = { type: 'city'; guide: typeof cityGuides[0] };
type LandmarkSlidEC = { type: 'landmark'; lm: LandmarkItemEC };
type DaySlidEC = CitySlidEC | LandmarkSlidEC;

const itineraryWithSlides = itinerary.map((d, idx) => {
  const isFirstCityDay = idx === 0 || itinerary[idx - 1].city !== d.city;
  const cityGuide = cityGuides.find(g => g.city === d.city);
  const landmarks: LandmarkItemEC[] = (d as any).landmarks ?? [];
  const slides: DaySlidEC[] = [
    ...(isFirstCityDay && cityGuide ? [{ type: 'city' as const, guide: cityGuide }] : []),
    ...landmarks.map(lm => ({ type: 'landmark' as const, lm })),
  ];
  return { ...d, isFirstCityDay, slides };
});
---
<Layout
  title={currentTrip.titleZh}
  description="2026 年学生带队中国夏季行程，从加拿大出发，10 天走访上海、苏州、杭州与北京。"
  lang="zh"
  alternateHref="/trips/explore-china-2026-summer"
  alternateLabel="EN"
  canonical="/zh/trips/explore-china-2026-summer"
  darkNav={true}
>

  <!-- Hero Banner -->
  <div class="trip-hero">
    <img
      src="/images/highlights/forbidden-city.jpg"
      alt="北京故宫鸟瞰"
      class="trip-hero__img"
    />
    <div class="trip-hero__overlay">
      <h1 class="trip-hero__title">{currentTrip.titleZh}</h1>
      <p class="trip-hero__sub">{currentTrip.summaryZh}</p>
    </div>
  </div>

  <!-- Overview — compact info strip -->
  <section id="overview" class="trip-strip">
    <div class="trip-strip__inner">
      <div class="trip-strip__facts">
        <div class="trip-strip__fact"><span class="trip-strip__label">路线</span><span class="trip-strip__val">{currentTrip.subtitleZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">出发</span><span class="trip-strip__val">{currentTrip.departureWindowZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">价格</span><span class="trip-strip__val trip-strip__val--price">{currentTrip.priceCadZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">人数</span><span class="trip-strip__val">{currentTrip.groupSizeZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">截止</span><span class="trip-strip__val">{currentTrip.applicationDeadlineZh}</span></div>
      </div>
      <div class="trip-strip__actions">
        <a class="trip-cta" href="#apply">立即申请</a>
      </div>
    </div>
  </section>

  <section class="highlights-strip" aria-label="路线亮点">

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1545569341-9eb8b30979d9?auto=format&fit=crop&w=600&q=80" alt="上海外滩" loading="lazy" />
      <p class="highlights-strip__caption">专为震慑帝国而建的海滨，时至今日仍在运作</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=600&q=80" alt="上海小笼包" loading="lazy" />
      <p class="highlights-strip__caption">汤包里藏着汤，这门技艺花了六百年打磨</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1535082623926-b39352a03fb7?auto=format&fit=crop&w=600&q=80" alt="苏州古典园林" loading="lazy" />
      <p class="highlights-strip__caption">让你忘记身处哪个朝代的园林</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1500039436846-25ae2f11882e?auto=format&fit=crop&w=600&q=80" alt="杭州西湖" loading="lazy" />
      <p class="highlights-strip__caption">被写进民族记忆的那片湖</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1508804185872-d7badad00f7d?auto=format&fit=crop&w=600&q=80" alt="北京烤鸭" loading="lazy" />
      <p class="highlights-strip__caption">明朝传下来的烤法，两百度，从未改变</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1547981609-4b6bfe67ca0b?auto=format&fit=crop&w=600&q=80" alt="北京故宫" loading="lazy" />
      <p class="highlights-strip__caption">九千九百九十九间房，只有一个人获准清点</p>
    </div>

  </section>

  <section class="route-intro">
  <div class="route-intro__inner">
    <div class="route-intro__rule"></div>

    <p class="route-intro__headline">
      「这是我们的招牌路线——乍一看可能和所有其他中国行程没什么两样。」
    </p>

    <div class="route-intro__body">
      <p>
        上海、苏州、杭州、北京。你在无数旅游套餐上都能看到这四个名字。
        但就像巴黎有一千种游法，只有少数几种会让你真正爱上它——
        让一段旅程难忘的，从来不是城市本身，而是你怎么走过它、和谁一起走，
        以及那些任何宣传册都不会提到的瞬间。
      </p>
      <span class="route-intro__pivot">这就是那个版本的中国。</span>
    </div>

    <button class="route-intro__toggle" id="route-intro-toggle" aria-expanded="false">
      阅读完整故事 ↓
    </button>

    <div class="route-intro__expandable" id="route-intro-body">
      <div class="route-intro__body">

        <span class="route-intro__city-label">上海</span>
        <p>上海是一座还没决定自己是否建完的城市。外滩的清晨是石材与江雾；对岸的高楼入夜之后是玻璃与灯光。中间是法租界——梧桐树夹道，石库门弄堂改成了咖啡馆，石板路上有雨水的气息。你会在这里吃到一样无法准确描述的东西，然后在之后很多个星期里还会想起它。</p>

        <span class="route-intro__city-label">苏州</span>
        <p>苏州的古典园林是为了制造一种特定的感受而建造的：让你觉得自己侧身走进了另一种和时间的关系。水在其中流动得很慢。山石与花木透过窗框的取景是刻意为之的——每一个视角都是构图。园林外面，河道边的小巷窄而湿润，还有人在住。老妇人在水面上晾衣服。运河是生活设施，不是景色。</p>

        <span class="route-intro__city-label">杭州</span>
        <p>西湖在清晨最好——游船还没出来，水面还有薄雾，苏堤上安静到可以听见鸟叫。湖上方的茶园是另一种安静：整齐的、绿的、带着新叶气味的。下午湖光是金色的。宋朝的诗人写过这些，并没有夸张。</p>

        <span class="route-intro__city-label">北京</span>
        <p>北京是一座知道自己是首都的城市。那个规模是刻意的——宽阔的大道、纪念碑式的广场、大到看不到对面的故宫。但你会记住的是胡同：鼓楼后面的那些小巷，北京旧有的生活节奏还在那里，煤烟味混着炒菜声，某个二楼的窗户里有人在听京剧。</p>

      </div>

      <p class="route-intro__colophon">
        十天 &nbsp;·&nbsp; 四座城 &nbsp;·&nbsp; 一群对的人
      </p>
    </div>
  </div>
</section>

<script>
  const toggle = document.getElementById('route-intro-toggle');
  const body = document.getElementById('route-intro-body');
  if (toggle && body) {
    toggle.addEventListener('click', () => {
      const isOpen = body.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.textContent = isOpen ? '收起 ↑' : '阅读完整故事 ↓';
    });
  }
</script>

  <!-- Who is this for -->
  <section id="who-is-this-for" class="section" style="padding: 4rem 2rem;">
    <div class="max-w-3xl mx-auto" style="max-width:48rem; margin-left:auto; margin-right:auto;">
      <h2 style="font-size:clamp(20px,3vw,30px); font-weight:700; font-family:var(--font-display); line-height:1.2; margin-bottom:1.25rem;">你不需要了解中国，也可以来。</h2>
      <p class="muted" style="font-size:17px; line-height:1.85; margin-bottom:1rem;">不需要会中文，不需要有经验。那些听起来很复杂的事——翻墙、支付、出行——我们都已经帮你搞定了。</p>
      <p class="muted" style="font-size:17px; line-height:1.85; margin-bottom:1rem;">我们每个人都是第一次去的时候什么都不懂。你只需要带着好奇心和开放的态度就够了。</p>
      <p class="muted" style="font-size:17px; line-height:1.85; padding-bottom:1.5rem;">真的，这就够了。</p>
    </div>
  </section>

  <section id="itinerary" class="section card tone-sand">
    <h2 class="section-title">十天行程一览</h2>
    <p class="section-sub" style="margin-bottom:2rem;">点击每一天，探索沿途的城市与景点。</p>

    <div class="itinerary-accordion">
      {itineraryWithSlides.map((d, idx) => (
          <div
            class={`itinerary-day${d.isFirstCityDay ? ' itinerary-day--city-start' : ''}`}
            data-day-idx={idx}
          >
            <button class="itinerary-day__header" data-day-toggle aria-expanded="false">
              <span class="itinerary-day__number">{d.dayZh}</span>
              <span class="itinerary-day__dot"></span>
              <div class="itinerary-day__meta">
                <span class="itinerary-day__city">{d.cityZh}</span>
                <h3 class="itinerary-day__title">{d.titleZh ?? d.title}</h3>
                <p class="itinerary-day__plan">{d.planZh ?? d.plan}</p>
              </div>
              <span class="itinerary-day__toggle-icon" aria-hidden="true">+</span>
            </button>

            <div class="itinerary-day__body" data-day-body>
              <div class="itinerary-day__body-inner">
                {d.slides.length > 0 && (
                  <div class="landmark-carousel" data-carousel>
                    <div class="landmark-carousel__track-wrap">
                      <div class="landmark-carousel__track" data-carousel-track>

                        {d.slides.map((slide) => (
                          <div class="landmark-carousel__slide">
                            {slide.type === 'city' ? (
                              <div class="city-intro-card">
                                <div class="city-intro-card__content">
                                  <span class="city-intro-card__label">城市概览</span>
                                  <h3 class="city-intro-card__city">{slide.guide.cityZh}</h3>
                                  <p class="city-intro-card__desc">{slide.guide.contextZh}</p>
                                </div>
                                <div class="city-intro-card__image">
                                  <img
                                    src={slide.guide.heroImage}
                                    alt={slide.guide.heroAlt}
                                    loading="lazy"
                                  />
                                </div>
                              </div>
                            ) : (
                              <div class="landmark-card">
                                <div class="landmark-card__visual">
                                  <img
                                    src={slide.lm.image}
                                    alt={slide.lm.nameZh}
                                    loading="lazy"
                                  />
                                  <div class="landmark-card__overlay"></div>
                                  <div class="landmark-card__name-overlay">
                                    <p class="landmark-card__name">{slide.lm.nameZh}</p>
                                    <p class="landmark-card__name-zh">{slide.lm.name}</p>
                                  </div>
                                </div>
                                <div class="landmark-card__body">
                                  <p class="landmark-card__background">{slide.lm.backgroundZh ?? slide.lm.background}</p>
                                </div>
                              </div>
                            )}
                          </div>
                        ))}

                      </div>
                    </div>

                    {d.slides.length > 1 && (
                      <div class="landmark-carousel__dots" style="margin-top:0.5rem;">
                        {d.slides.map((_slide, i) => (
                          <span class={`landmark-carousel__dot${i === 0 ? ' is-active' : ''}`} data-carousel-dot></span>
                        ))}
                      </div>
                    )}
                    <button class="landmark-carousel__btn landmark-carousel__btn--prev" data-carousel-prev aria-label="上一张">←</button>
                    <button class="landmark-carousel__btn landmark-carousel__btn--next" data-carousel-next aria-label="下一张">→</button>
                  </div>
                )}
              </div>
            </div>
          </div>
      ))}
    </div>
  </section>

  <!-- Included / Not Included -->
  <section class="section incl-grid">
    <article class="incl-card incl-card--yes">
      <h2 class="incl-card__title">包含内容</h2>
      <ul class="incl-list">
        {includedZh.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--yes">✓</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
    <article class="incl-card incl-card--no">
      <h2 class="incl-card__title">不包含内容</h2>
      <ul class="incl-list">
        {notIncludedZh.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--no">✗</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
  </section>

  <!-- Videos -->
  <section class="section card tone-blue">
    <h2 class="section-title">出发前可以先看的视频</h2>
    <div class="grid cols-3 video-grid">
      {recommendedVideos.map((video) => {
        const ytId = video.url.match(/[?&]v=([^&]+)/)?.[1] || '';
        return (
          <a href={video.url} target="_blank" rel="noopener" class="video-card">
            <div class="video-card__thumb">
              <img src={`https://img.youtube.com/vi/${ytId}/hqdefault.jpg`} alt={video.titleZh} loading="lazy" />
              <div class="video-card__play">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.6)"/><path d="M19 15l14 9-14 9V15z" fill="#fff"/></svg>
              </div>
            </div>
            <div class="video-card__info">
              <h3 class="video-card__title">{video.titleZh}</h3>
              <p class="video-card__creator">{video.creator}</p>
              <p class="video-card__note">{video.noteZh}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- FAQ (accordion, consistent with homepage) -->
  <section id="faq" class="faq">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">常见问题</p>
        <h2 class="section-title">常见问题解答</h2>
      </div>
      <div class="faq__list">
        {faqZh.map((f, i) => (
          <div class="faq__item" id={`trip-faq-${i}`}>
            <button class="faq__q" aria-expanded="false" aria-controls={`trip-faq-answer-${i}`}>
              <span>{f.q}</span>
              <svg class="faq__icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <div class="faq__a" id={`trip-faq-answer-${i}`} role="region" aria-labelledby={`trip-faq-${i}`}>
              <div class="faq__a-inner">{f.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="apply" class="route-apply">
    <div class="container" style="text-align:center; padding-top:0; padding-bottom:0;">
      <p class="section-eyebrow" style="color:rgba(255,255,255,0.6);">申请</p>
      <h2 class="section-title" style="color:#fff; margin-bottom:1rem;">准备好了吗？</h2>
      <p style="color:rgba(255,255,255,0.72); font-size:clamp(0.95rem,2vw,1.05rem); line-height:1.75; max-width:460px; margin:0 auto 2rem;">
        告诉我们一些关于你的信息，以及你感兴趣的行程——我们将在5个工作日内回复。
      </p>
      <a href="/apply"
        style="display:inline-block; background:var(--color-red,#c8102e); color:#fff; padding:0.9rem 2.5rem; font-size:0.875rem; font-weight:600; letter-spacing:0.08em; text-decoration:none; text-transform:uppercase; transition:background 0.2s;"
        onmouseover="this.style.background='#a00d24'"
        onmouseout="this.style.background='var(--color-red,#c8102e)'">
        立即申请 →
      </a>
    </div>
  </section>
</Layout>

<style>
.trip-hero {
  position: relative;
  height: 420px;
  overflow: hidden;
}
.trip-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.trip-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 2.5rem;
  text-align: center;
}
.trip-hero__title {
  color: #fff;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  font-family: var(--font-display);
  line-height: 1.1;
  margin-bottom: 0.75rem;
}
.trip-hero__sub {
  color: rgba(255,255,255,0.85);
  font-size: 1.1rem;
  max-width: 640px;
  line-height: 1.7;
}
</style>

<script is:inline>
// ── FAQ accordion ──────────────────────────────────────
document.querySelectorAll('.faq__item').forEach(item => {
  const btn = item.querySelector('.faq__q');
  const answer = item.querySelector('.faq__a');
  btn?.addEventListener('click', () => {
    const open = item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    if (answer) answer.style.maxHeight = open ? answer.scrollHeight + 'px' : '0';
  });
});

// ── Itinerary day accordion ────────────────────────────
document.querySelectorAll('.itinerary-day').forEach(day => {
  const header = day.querySelector('[data-day-toggle]');
  const body = day.querySelector('[data-day-body]');
  if (!header || !body) return;
  header.addEventListener('click', () => {
    const open = body.classList.toggle('is-open');
    header.setAttribute('aria-expanded', String(open));
  });
});

// ── Landmark carousels ─────────────────────────────────
document.querySelectorAll('[data-carousel]').forEach(carousel => {
  const track = carousel.querySelector('[data-carousel-track]');
  const slides = carousel.querySelectorAll('.landmark-carousel__slide');
  const prevBtn = carousel.querySelector('[data-carousel-prev]');
  const nextBtn = carousel.querySelector('[data-carousel-next]');
  const dots = carousel.querySelectorAll('[data-carousel-dot]');
  if (!track || slides.length === 0) return;

  let idx = 0;
  const total = slides.length;
  const slideWidth = 88;

  function goTo(n) {
    idx = Math.max(0, Math.min(n, total - 1));
    track.style.transform = `translateX(-${idx * slideWidth}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
    if (prevBtn) prevBtn.disabled = idx === 0;
    if (nextBtn) nextBtn.disabled = idx === total - 1;
  }

  prevBtn?.addEventListener('click', () => goTo(idx - 1));
  nextBtn?.addEventListener('click', () => goTo(idx + 1));

  let touchX = 0;
  carousel.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, { passive: true });
  carousel.addEventListener('touchend', e => {
    const delta = touchX - e.changedTouches[0].clientX;
    if (Math.abs(delta) > 40) goTo(idx + (delta > 0 ? 1 : -1));
  });

  goTo(0);
});
</script>
