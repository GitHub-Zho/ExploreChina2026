---
import Layout from '../../../layouts/Layout.astro';
import { tripsMeta } from '../../../data/trips-meta.ts';
---

<Layout
  title="即将出发的行程 | Explore China 2026"
  description="浏览所有 Explore China 为加拿大大学生设计的旅行线路。"
  lang="zh"
  canonical="/zh/trips"
  alternateHref="/trips"
  alternateLabel="English"
>
  <section style="padding: var(--section-gap) 0 clamp(2rem,5vw,4rem);">
    <div class="container" style="text-align:center;">
      <p class="section-eyebrow">我们的线路</p>
      <h1 class="section-title">所有行程</h1>
      <p class="section-sub" style="text-align:center;">
        三条线路，三种中国。选择最适合你的方式出发。
      </p>
    </div>
  </section>

  <section class="trips-list">
    <div class="container">

      {tripsMeta.map((trip) => (
        trip.status === 'open' ? (
          <a href={trip.hrefZh} class="trip-listing-card">
            <div class="trip-listing-card__img">
              {trip.image && <img src={trip.image} alt={trip.imageAltZh} loading="lazy" />}
            </div>
            <div class="trip-listing-card__body">
              <div class="trip-listing-card__top">
                <div>
                  <h2 class="trip-listing-card__title">{trip.titleZh}</h2>
                  <p class="trip-listing-card__subtitle">{trip.subtitleZh}</p>
                </div>
                <span class="trip-badge trip-badge--open">开放报名</span>
              </div>
              <p class="trip-listing-card__desc">{trip.descriptionZh}</p>
              <div class="trip-listing-card__stats">
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">天数</span>
                  <span class="trip-listing-card__stat-value">{trip.durationZh}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">城市</span>
                  <span class="trip-listing-card__stat-value">{trip.citiesZh}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">出发</span>
                  <span class="trip-listing-card__stat-value">{trip.departureZh}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">费用</span>
                  <span class="trip-listing-card__stat-value trip-listing-card__stat-value--price">{trip.price}</span>
                </div>
              </div>
              <div class="trip-listing-card__footer">
                <span class="trip-cta">查看行程 →</span>
              </div>
            </div>
          </a>
        ) : (
          <div class="trip-listing-card trip-listing-card--soon">
            <div class="trip-listing-card__img">
              {trip.image
                ? <img src={trip.image} alt={trip.imageAltZh} loading="lazy" />
                : <div class="trip-listing-card__img-placeholder"></div>
              }
            </div>
            <div class="trip-listing-card__body">
              <div class="trip-listing-card__top">
                <div>
                  <h2 class="trip-listing-card__title">{trip.titleZh}</h2>
                  <p class="trip-listing-card__subtitle">{trip.subtitleZh}</p>
                </div>
                <span class="trip-badge trip-badge--soon">即将开放</span>
              </div>
              <p class="trip-listing-card__desc">{trip.descriptionZh}</p>
              <div class="trip-listing-card__stats">
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">天数</span>
                  <span class="trip-listing-card__stat-value">{trip.durationZh}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">城市</span>
                  <span class="trip-listing-card__stat-value">{trip.citiesZh}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">出发</span>
                  <span class="trip-listing-card__stat-value">{trip.departureZh}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">费用</span>
                  <span class="trip-listing-card__stat-value">{trip.price}</span>
                </div>
              </div>
              <div class="trip-listing-card__footer">
                <span style="color:#a8a29e; font-size:0.875rem;">详情即将公布</span>
              </div>
            </div>
          </div>
        )
      ))}

    </div>
  </section>
</Layout>

<style>
.trip-listing-card--soon {
  opacity: 0.72;
  cursor: default;
}
.trip-listing-card__img-placeholder {
  width: 100%;
  height: 100%;
  background: #e7e5e0;
}
</style>
