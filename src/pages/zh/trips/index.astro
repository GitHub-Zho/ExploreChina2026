---
import Layout from '../../../layouts/Layout.astro';
import { tripsMeta } from '../../../data/registry';
---

<Layout
  title="即将出发的行程 | Explore China 2026"
  description="浏览所有 Explore China 为加拿大大学生设计的旅行线路。"
  lang="zh"
  canonical="/zh/trips"
  alternateHref="/trips"
  alternateLabel="English"
>
  <section class="trips-header">
    <div class="container">
      <p class="section-eyebrow">我们的线路</p>
      <h1 class="section-title">所有行程</h1>
      <p class="section-sub" style="text-align:center;">
        三条线路，三种中国。选择最适合你的方式出发。
      </p>
    </div>
  </section>

  <section class="trips-list">
    <div class="trips-stack">

      {tripsMeta.map((trip, i) => (
        trip.status === 'open' ? (
          <a href={trip.hrefZh} class="tlc">
            <div class="tlc__img">
              {trip.image
                ? <img src={trip.image} alt={trip.imageAltZh} loading="lazy" />
                : <div class="tlc__img-empty"><span>{trip.sealChar}</span></div>
              }
            </div>
            <div class="tlc__body">
              <div class="tlc__meta">
                <div class="tlc__meta-left">
                  <span class="tlc__arc">{trip.arcTitleZh}</span>
                  <span class="tlc__badge tlc__badge--open">开放报名</span>
                </div>
                <div class="tlc__seal" aria-hidden="true">{trip.sealChar}</div>
              </div>

              <h2 class="tlc__title">{trip.titleZh}</h2>
              <p class="tlc__route">{trip.subtitleZh}</p>
              <p class="tlc__focus">{trip.culturalFocusZh}</p>
              <p class="tlc__desc">{trip.descriptionZh}</p>

              <div class="tlc__stats">
                <div class="tlc__stat">
                  <span class="tlc__stat-label">天数</span>
                  <span class="tlc__stat-value">{trip.durationZh}</span>
                </div>
                <div class="tlc__stat">
                  <span class="tlc__stat-label">城市</span>
                  <span class="tlc__stat-value">{trip.citiesZh}</span>
                </div>
                <div class="tlc__stat">
                  <span class="tlc__stat-label">出发</span>
                  <span class="tlc__stat-value">{trip.departureZh}</span>
                </div>
              </div>

              <div class="tlc__footer">
                <div class="tlc__price-block">
                  <span class="tlc__price">{trip.price}</span>
                  <span class="tlc__price-note">每人 · 不含国际机票</span>
                </div>
                <span class="tlc__cta">查看行程 →</span>
              </div>
            </div>
          </a>
        ) : (
          <div class="tlc tlc--soon">
            <div class="tlc__img">
              {trip.image
                ? <img src={trip.image} alt={trip.imageAltZh} loading="lazy" />
                : <div class="tlc__img-empty"><span>{trip.sealChar}</span></div>
              }
            </div>
            <div class="tlc__body">
              <div class="tlc__meta">
                <div class="tlc__meta-left">
                  <span class="tlc__arc">{trip.arcTitleZh}</span>
                  <span class="tlc__badge tlc__badge--soon">即将开放</span>
                </div>
                <div class="tlc__seal" aria-hidden="true">{trip.sealChar}</div>
              </div>

              <h2 class="tlc__title">{trip.titleZh}</h2>
              <p class="tlc__route">{trip.subtitleZh}</p>
              <p class="tlc__focus">{trip.culturalFocusZh}</p>
              <p class="tlc__desc">{trip.descriptionZh}</p>

              <div class="tlc__stats">
                <div class="tlc__stat">
                  <span class="tlc__stat-label">天数</span>
                  <span class="tlc__stat-value">{trip.durationZh}</span>
                </div>
                <div class="tlc__stat">
                  <span class="tlc__stat-label">城市</span>
                  <span class="tlc__stat-value">{trip.citiesZh}</span>
                </div>
                <div class="tlc__stat">
                  <span class="tlc__stat-label">出发</span>
                  <span class="tlc__stat-value">{trip.departureZh}</span>
                </div>
              </div>

              <div class="tlc__footer">
                <div class="tlc__price-block">
                  <span class="tlc__price tlc__price--pending">{trip.price}</span>
                  <span class="tlc__price-note">价格待公布</span>
                </div>
                <span class="tlc__coming-soon-note">详情即将公布</span>
              </div>
            </div>
          </div>
        )
      ))}

    </div>
  </section>
</Layout>

<style>
.trips-header {
  padding: var(--section-gap) 0 clamp(2rem, 5vw, 4rem);
  text-align: center;
}

.trips-stack {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: #e5e0d8;
  padding-bottom: clamp(3rem, 6vw, 5rem);
  max-width: 1500px;
  margin-inline: auto;
  width: 100%;
}

/* ── Card ── */
.tlc {
  display: grid;
  grid-template-columns: 40% 1fr;
  min-height: clamp(320px, 36vw, 420px);
  background: var(--color-surface);
  position: relative;
  overflow: hidden;
  transition: box-shadow 0.3s;
  text-decoration: none;
  color: inherit;
}
a.tlc:hover { box-shadow: 0 8px 40px rgba(0,0,0,0.12); z-index: 1; }
.tlc--soon { opacity: 0.72; cursor: default; }

/* ── Image ── */
.tlc__img { position: relative; overflow: hidden; }
.tlc__img img {
  width: 100%; height: 100%; object-fit: cover; object-position: center;
  transition: transform 0.65s cubic-bezier(0.25,0.46,0.45,0.94);
}
a.tlc:hover .tlc__img img { transform: scale(1.05); }
.tlc__img-empty {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #e8dfc8 0%, #cfc2a4 100%);
  display: flex; align-items: center; justify-content: center;
}
.tlc__img-empty span {
  font-family: 'Ma Shan Zheng', 'Noto Serif SC', 'Songti SC', serif;
  font-size: clamp(4rem, 8vw, 8rem);
  color: rgba(180,140,80,0.28);
  font-weight: 700;
  line-height: 1;
}

/* ── Body ── */
.tlc__body {
  padding: clamp(1.75rem, 3.5vw, 2.75rem);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 0.75rem;
}

/* ── Meta row: arc title + badge left, seal right ── */
.tlc__meta {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
}
.tlc__meta-left {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.tlc__arc {
  font-size: clamp(0.58rem, 0.9vw, 0.68rem);
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-red);
}
.tlc__badge {
  display: inline-block;
  padding: 0.18rem 0.6rem;
  font-size: clamp(0.52rem, 0.82vw, 0.6rem);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #fff;
  white-space: nowrap;
  width: fit-content;
}
.tlc__badge--open { background: var(--color-red); }
.tlc__badge--soon { background: var(--color-gold); }

/* ── Seal chop — floods red on hover ── */
.tlc__seal {
  width: clamp(3rem, 4.5vw, 3.8rem);
  height: clamp(3rem, 4.5vw, 3.8rem);
  border: 2px solid var(--color-red);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: clamp(1.5rem, 2.2vw, 2rem);
  color: var(--color-red);
  font-family: 'Ma Shan Zheng', 'Noto Serif SC', 'Songti SC', serif;
  font-weight: 700;
  flex-shrink: 0;
  transition: background 0.25s, color 0.25s;
  line-height: 1;
}
a.tlc:hover .tlc__seal {
  background: var(--color-red);
  color: #fff;
}

/* ── Title ── */
.tlc__title {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 2.8vw, 2.2rem);
  font-weight: 700;
  line-height: 1.1;
  color: var(--color-ink);
  margin: 0;
}

/* ── City route ── */
.tlc__route {
  font-size: clamp(0.6rem, 0.9vw, 0.7rem);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-ink-muted);
  margin: -0.1rem 0 0;
}

/* ── Cultural focus (gold italic) ── */
.tlc__focus {
  font-size: clamp(0.72rem, 1.1vw, 0.82rem);
  color: var(--color-gold);
  font-style: italic;
  font-family: var(--font-display);
  letter-spacing: 0.02em;
  margin: 0;
}

/* ── Description ── */
.tlc__desc {
  color: var(--color-ink-muted);
  line-height: 1.78;
  font-size: clamp(0.82rem, 1.25vw, 0.92rem);
  max-width: 54ch;
  margin: 0;
}

/* ── Stats (Duration · Cities · Departure) ── */
.tlc__stats {
  display: flex;
  gap: clamp(1.25rem, 2.5vw, 2.25rem);
  flex-wrap: wrap;
  padding-top: 1rem;
  border-top: 1px solid #ece8e1;
  margin-top: auto;
}
.tlc__stat { display: flex; flex-direction: column; gap: 0.2rem; }
.tlc__stat-label {
  font-size: clamp(0.55rem, 0.82vw, 0.63rem);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--color-ink-muted);
}
.tlc__stat-value { font-size: clamp(0.8rem, 1.2vw, 0.88rem); font-weight: 600; }

/* ── Footer: price prominent + CTA ── */
.tlc__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  padding-top: 0.75rem;
}
.tlc__price-block {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}
.tlc__price {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2vw, 1.45rem);
  font-weight: 700;
  color: var(--color-red);
  line-height: 1;
  letter-spacing: -0.01em;
}
.tlc__price--pending { color: var(--color-ink-muted); }
.tlc__price-note {
  font-size: clamp(0.55rem, 0.82vw, 0.63rem);
  color: var(--color-ink-muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.tlc__cta {
  display: inline-flex; align-items: center; gap: 0.35rem;
  background: var(--color-red); color: #fff;
  padding: 0.65rem 1.5rem;
  font-size: clamp(0.65rem, 0.95vw, 0.76rem);
  font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
  border: 2px solid var(--color-red);
  transition: background 0.2s, border-color 0.2s;
  white-space: nowrap;
}
a.tlc:hover .tlc__cta { background: var(--color-red-dark); border-color: var(--color-red-dark); }
.tlc__coming-soon-note {
  color: #a8a29e;
  font-size: clamp(0.75rem, 1.1vw, 0.85rem);
}

/* ── Stacked layout (mobile + narrow desktop) ── */
@media (max-width: 900px) {
  .tlc { grid-template-columns: 1fr; grid-template-rows: 240px auto; min-height: 0; }
  .tlc__desc { max-width: none; }
  .tlc__body { gap: 0.8rem; }
  .tlc__footer { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
}
</style>

<script>
(function () {
  function equalizeCards() {
    var cards = Array.from(document.querySelectorAll<HTMLElement>('.tlc'));
    if (!cards.length) return;
    cards.forEach(function (c) { c.style.height = ''; });
    if (window.innerWidth <= 900) return;
    var maxH = Math.max.apply(null, cards.map(function (c) { return c.offsetHeight; }));
    cards.forEach(function (c) { c.style.height = maxH + 'px'; });
  }
  equalizeCards();
  window.addEventListener('resize', equalizeCards);
}());
</script>
