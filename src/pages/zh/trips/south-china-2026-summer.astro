---
import Layout from '../../../layouts/Layout.astro';
import {
  southChinaTrip,
  southChinaItinerary,
  southChinaCityGuides,
  southChinaFaqZh,
  southChinaIncludedZh,
  southChinaNotIncludedZh,
  southChinaVideos,
} from '../../../data/south-china.ts';

const currentTrip     = southChinaTrip;
const itinerary       = southChinaItinerary;
const cityGuides      = southChinaCityGuides;
const faq             = southChinaFaqZh;
const included        = southChinaIncludedZh;
const notIncluded     = southChinaNotIncludedZh;
const recommendedVideos = southChinaVideos;

const tripStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: currentTrip.titleZh,
    description:
      '探索中国华南线路——10天走访厦门、潮汕、深圳与香港，文化深度、海岸气息与东西交融的城市张力。',
    itinerary: itinerary.map((day) => `${day.dayZh}: ${day.cityZh} - ${day.titleZh}`),
    touristType: '来自加拿大的在校学生与年轻旅行者',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.explorechina.ca/' },
      { '@type': 'ListItem', position: 2, name: '华南线路', item: 'https://www.explorechina.ca/zh/trips/south-china-2026-summer' },
    ],
  },
];
---
<Layout
  title="华南线路 · 探索中国 2026"
  description="探索中国华南线路——10天走访厦门、潮汕、深圳与香港，文化深度、海岸气息与东西交融的城市张力。"
  lang="zh"
  alternateHref="/trips/south-china-2026-summer"
  alternateLabel="English"
  canonical="/zh/trips/south-china-2026-summer"
  structuredData={tripStructuredData}
  darkNav={true}
>

  <div class="trip-hero">
    <img
      src="https://images.unsplash.com/photo-1506812574058-fc75fa93fead?auto=format&fit=crop&w=1600&q=80"
      alt="厦门海岸黄昏"
      class="trip-hero__img"
    />
    <div class="trip-hero__overlay">
      <h1 class="trip-hero__title">{currentTrip.titleZh}</h1>
      <p class="trip-hero__sub">{currentTrip.subtitleZh}</p>
    </div>
  </div>

  <section id="overview" class="trip-strip">
    <div class="trip-strip__inner">
      <div class="trip-strip__facts">
        <div class="trip-strip__fact"><span class="trip-strip__label">路线</span><span class="trip-strip__val">{currentTrip.subtitleZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">出发时间</span><span class="trip-strip__val">{currentTrip.departureWindowZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">费用</span><span class="trip-strip__val trip-strip__val--price">{currentTrip.priceCadZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">团队人数</span><span class="trip-strip__val">{currentTrip.groupSizeZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">报名截止</span><span class="trip-strip__val">{currentTrip.applicationDeadlineZh}</span></div>
      </div>
      <div class="trip-strip__actions">
        <a class="trip-cta" href="#apply">立即报名</a>
      </div>
    </div>
  </section>

  <!-- Highlights Strip -->
  <section class="highlights-strip" aria-label="行程亮点">

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1574285013029-29296a71930e?auto=format&fit=crop&w=600&q=80" alt="鼓浪屿殖民建筑" loading="lazy" />
      <p class="highlights-strip__caption">十三国领事馆驻扎过的海岛，岛上没有汽车</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1569050467447-ce54b3bbc37d?auto=format&fit=crop&w=600&q=80" alt="厦门沙茶面" loading="lazy" />
      <p class="highlights-strip__caption">厦门人的一碗沙茶面——花生与香料的秘方</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1547981609-4b6bfe67ca0b?auto=format&fit=crop&w=600&q=80" alt="潮州古城门楼" loading="lazy" />
      <p class="highlights-strip__caption">两千六百年文明，藏在一座古城墙之内</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1557872943-16a5ac26437e?auto=format&fit=crop&w=600&q=80" alt="潮汕牛肉火锅" loading="lazy" />
      <p class="highlights-strip__caption">刚从市场送来的鲜牛肉，涮进清汤里</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1512632578888-169bbbc64f33?auto=format&fit=crop&w=600&q=80" alt="深圳现代天际线" loading="lazy" />
      <p class="highlights-strip__caption">三十年前的渔村，如今住着一千七百万人</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1536240478700-b869ad10e128?auto=format&fit=crop&w=600&q=80" alt="香港维多利亚港天星小轮" loading="lazy" />
      <p class="highlights-strip__caption">十一分钟的渡轮，两座截然不同的城市</p>
    </div>

  </section>

  <section class="route-intro">
  <div class="route-intro__inner">
    <div class="route-intro__rule"></div>

    <p class="route-intro__headline">
      四座城市。四种截然不同的中国。
    </p>

    <div class="route-intro__body">
      <p>
        华南线路穿越的，是大多数旅行者从未抵达的那个中国：厦门的海风与闽南离散情结、潮汕沉积千年的潮州文明、深圳用三十年造出来的城市雄心，还有香港——那个东方与西方不再只是比喻、而是真实地化为街道、食档与生活方式的地方。
      </p>
      <span class="route-intro__pivot">阅读完整故事 ↓</span>
    </div>

    <button class="route-intro__toggle" id="route-intro-toggle" aria-expanded="false">
      阅读完整故事 ↓
    </button>

    <div class="route-intro__expandable" id="route-intro-body">
      <div class="route-intro__body">

        <span class="route-intro__city-label">厦门</span>
        <p>厦门是中国把频率调低了几格之后的样子。海永远在那里——在早晨的空气里，在渡往鼓浪屿的轮渡汽笛声里。1842年它被迫开埠，此后将近一个世纪，对岸那座小岛上驻扎着13国的领事馆。那段历史今天仍写在建筑里、食物里、以及那些不断回来的闽南海外后裔脸上。</p>

        <span class="route-intro__city-label">潮汕</span>
        <p>潮汕不是一座城——它是一个地域，一种身份认同，是1500万散落在东南亚的潮州人，他们至今仍寄钱回家、返乡奔丧。走进潮州，就是走进2600年不曾中断的文明。这里的一场功夫茶要喝三个小时。没有人看手机。</p>

        <span class="route-intro__city-label">深圳</span>
        <p>1980年，深圳是一个3万人的渔村。今天它有1700万人。那场冲刺——早年GDP年增长率58%——是这座城市的核心事实，写在它的每一处：建筑从不假装古老，居民来自天南地北，那股劲儿至今像是还在向什么证明自己。它也是中国中位年龄最年轻的一线城市。</p>

        <span class="route-intro__city-label">香港</span>
        <p>香港是156年英国管治叠加在粤语文明之上——没有消除任何一方，而是造出了真正新颖的东西。它有自己的法律体系、货币、出入境管制，以及一种有别于大陆的粤语身份认同。叮叮车沿花园道吱呀作响。天星小轮的汽笛声在高楼之间回荡。在深水埗，你仍能找到来自另一个时代的布料。这座城市密不透风，层次丰富，而且完全真实。</p>

      </div>

      <p class="route-intro__colophon">
        10天 &nbsp;·&nbsp; 厦门 · 潮汕 · 深圳 · 香港
      </p>
    </div>
  </div>
</section>

<script>
  const toggle = document.getElementById('route-intro-toggle');
  const body = document.getElementById('route-intro-body');
  if (toggle && body) {
    toggle.addEventListener('click', () => {
      const isOpen = body.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.textContent = isOpen ? '收起 ↑' : '阅读完整故事 ↓';
    });
  }
</script>

  <section id="who-is-this-for" class="section" style="padding: 4rem 2rem;">
    <div style="max-width:48rem; margin:0 auto;">
      <h2 style="font-size:clamp(20px,3vw,30px); font-weight:700; font-family:var(--font-display); line-height:1.2; margin-bottom:1.25rem;">这条路线，专为想看深层中国的人。</h2>
      <p class="muted" style="font-size:clamp(0.9rem,1.5vw,1.05rem); line-height:1.85; margin-bottom:1rem;">一场慢茶、一次过境、一座渔村、一座坐船才能抵达的世界文化遗产岛。</p>
      <p class="muted" style="font-size:clamp(0.9rem,1.5vw,1.05rem); line-height:1.85; margin-bottom:1rem;">不需要中文，不需要提前了解中国。那些复杂的部分——支付、SIM卡、深港过境——我们都已经处理好了。</p>
      <p class="muted" style="font-size:clamp(0.9rem,1.5vw,1.05rem); line-height:1.85; padding-bottom:1.5rem;">好奇心就够了。</p>
    </div>
  </section>

  <section class="section card tone-blue city-tabs-section" id="city-guides" data-city-tabs>
    <div class="city-tabs-section__header">
      <p class="section-eyebrow">城市指南</p>
      <h2 class="section-title">出发前，先认识这几座城市</h2>
      <p class="section-sub">切换标签，获取每一站的文化故事、在地体感与实用锚点。</p>
    </div>

    <div class="city-tabs__nav" role="tablist" aria-label="城市指南标签">
      {cityGuides.map((city, idx) => (
        <button
          type="button"
          class={`city-tabs__tab ${idx === 0 ? 'is-active' : ''}`}
          id={`city-tab-${city.city.toLowerCase()}`}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          aria-controls={`city-panel-${city.city.toLowerCase()}`}
          data-city-tab={city.city.toLowerCase()}
          tabindex={idx === 0 ? '0' : '-1'}
        >
          <span>{city.cityZh}</span>
          <span class="city-tabs__tab-sub">{city.city}</span>
        </button>
      ))}
    </div>

    {cityGuides.map((city, idx) => (
      <article
        class={`city-tabs__panel ${idx === 0 ? 'is-active' : ''}`}
        id={`city-panel-${city.city.toLowerCase()}`}
        role="tabpanel"
        aria-labelledby={`city-tab-${city.city.toLowerCase()}`}
        hidden={idx !== 0}
        data-city-panel={city.city.toLowerCase()}
      >
        <div class="city-tabs__panel-grid">
          <figure class="card city-tabs__hero">
            <img class="photo media-wide" src={city.heroImage} alt={city.heroAlt} loading={idx === 0 ? 'eager' : 'lazy'} />
          </figure>
          <div class="city-tabs__story">
            <p class="pill">{city.cityZh} · {city.city}</p>
            <h3 class="city-tabs__title">这座城市在路线中的意义</h3>
            <p class="city-tabs__lead">{city.contextZh}</p>
            <p class="city-tabs__text">{city.feelingZh}</p>
          </div>
        </div>

        <div class="city-tabs__highlights">
          {city.explore.slice(0, 4).map((spot) => (
            <article class="card city-tabs__highlight" style={spot.image ? `--highlight-bg: url(${spot.image})` : ''}>
              {spot.image && <div class="highlight-img" aria-hidden="true"></div>}
              <div class="highlight-content">
                <p class="label">关键亮点</p>
                <h4>{spot.titleZh}</h4>
                <p class="muted">{spot.descriptionZh}</p>
              </div>
            </article>
          ))}
        </div>
      </article>
    ))}
  </section>

  <section id="itinerary" class="section card tone-sand">
    <h2 class="section-title">十天行程一览</h2>
    <div class="trip-timeline">
      {itinerary.map((d) => (
        <div class="trip-timeline__row">
          <div class="trip-timeline__day">{d.dayZh}</div>
          <div class="trip-timeline__dot"></div>
          <div class="trip-timeline__content">
            <strong class="trip-timeline__city">{d.cityZh}</strong>
            <span class="trip-timeline__title">{d.titleZh}</span>
            <p class="trip-timeline__plan">{d.planZh}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section incl-grid">
    <article class="incl-card incl-card--yes">
      <h2 class="incl-card__title">已包含</h2>
      <ul class="incl-list">
        {included.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--yes">✓</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
    <article class="incl-card incl-card--no">
      <h2 class="incl-card__title">不含</h2>
      <ul class="incl-list">
        {notIncluded.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--no">×</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
  </section>

  <section class="section card tone-blue">
    <div class="grid cols-3 video-grid">
      {recommendedVideos.map((video) => {
        const ytId = video.url.match(/[?&]v=([^&]+)/)?.[1] || '';
        return (
          <a href={video.url} target="_blank" rel="noopener" class="video-card">
            <div class="video-card__thumb">
              <img src={`https://img.youtube.com/vi/${ytId}/hqdefault.jpg`} alt={video.titleZh} loading="lazy" />
              <div class="video-card__play">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.6)"/><path d="M19 15l14 9-14 9V15z" fill="#fff"/></svg>
              </div>
            </div>
            <div class="video-card__info">
              <h3 class="video-card__title">{video.titleZh}</h3>
              <p class="video-card__creator">{video.creator}</p>
              <p class="video-card__note">{video.noteZh}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- SEO context -->
  <section class="section" style="padding: 1.5rem 2rem 0;">
    <div style="max-width:54rem; margin:0 auto; border-top:1px solid #e8e5e0; padding-top:1.5rem;">
      <p style="font-size:13px; line-height:1.9; color:#9a9590; text-align:center;">从多伦多或加拿大其他城市计划华南之旅？先读 <a href="/handbook" style="color:#b8524a;">行前手册</a>，了解 <a href="/about" style="color:#b8524a;">团队背景</a> 与 <a href="/privacy" style="color:#b8524a;">隐私政策</a>。</p>
    </div>
  </section>

  <section id="faq" class="faq">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">常见问题</p>
        <h2 class="section-title">常见问题解答</h2>
      </div>
      <div class="faq__list">
        {faq.map((f, i) => (
          <div class="faq__item" id={`sc-faq-${i}`}>
            <button class="faq__q" aria-expanded="false" aria-controls={`sc-faq-answer-${i}`}>
              <span>{f.q}</span>
              <svg class="faq__icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <div class="faq__a" id={`sc-faq-answer-${i}`} role="region" aria-labelledby={`sc-faq-${i}`}>
              <div class="faq__a-inner">{f.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="apply" class="route-apply">
    <div class="container" style="text-align:center; padding-top:0; padding-bottom:0;">
      <p class="section-eyebrow" style="color:rgba(255,255,255,0.6);">报名</p>
      <h2 class="section-title" style="color:#fff; margin-bottom:1rem;">准备好出发了吗？</h2>
      <p style="color:rgba(255,255,255,0.72); font-size:clamp(0.95rem,2vw,1.05rem); line-height:1.75; max-width:460px; margin:0 auto 2rem;">
        告诉我们一些关于你的信息，以及你感兴趣的行程——我们将在5个工作日内回复。
      </p>
      <a href="/apply"
        style="display:inline-block; background:var(--color-red,#c8102e); color:#fff; padding:0.9rem 2.5rem; font-size:0.875rem; font-weight:600; letter-spacing:0.08em; text-decoration:none; text-transform:uppercase; transition:background 0.2s;"
        onmouseover="this.style.background='#a00d24'"
        onmouseout="this.style.background='var(--color-red,#c8102e)'">
        立即申请 →
      </a>
    </div>
  </section>
</Layout>

<style>
.trip-hero {
  position: relative;
  height: 420px;
  overflow: hidden;
}
.trip-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.trip-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 2.5rem;
  text-align: center;
}
.trip-hero__title {
  color: #fff;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  font-family: var(--font-display);
  line-height: 1.1;
  margin-bottom: 0.75rem;
}
.trip-hero__sub {
  color: rgba(255,255,255,0.85);
  font-size: 1.1rem;
  max-width: 640px;
  line-height: 1.7;
}
</style>

<script is:inline>
  document.querySelectorAll('.faq__q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq__q').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      if (!expanded) btn.setAttribute('aria-expanded', 'true');
    });
  });

  document.querySelectorAll('[data-city-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll('[data-city-tab]'));
    const panels = Array.from(root.querySelectorAll('[data-city-panel]'));

    const activateTab = (key) => {
      tabs.forEach((tab) => {
        const active = tab.getAttribute('data-city-tab') === key;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.setAttribute('tabindex', active ? '0' : '-1');
      });

      panels.forEach((panel) => {
        const active = panel.getAttribute('data-city-panel') === key;
        panel.classList.toggle('is-active', active);
        panel.hidden = !active;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activateTab(tab.getAttribute('data-city-tab')));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const nextIndex = event.key === 'ArrowRight'
          ? (index + 1) % tabs.length
          : (index - 1 + tabs.length) % tabs.length;
        const nextTab = tabs[nextIndex];
        nextTab.focus();
        activateTab(nextTab.getAttribute('data-city-tab'));
      });
    });
  });

  /* ── Mobile: IntersectionObserver reveals highlight images on scroll ── */
  if (window.matchMedia('(max-width: 768px)').matches || 'ontouchstart' in window) {
    const highlightCards = document.querySelectorAll('.city-tabs__highlight');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
        } else {
          e.target.classList.remove('in-view');
        }
      });
    }, { threshold: 0.5 });
    highlightCards.forEach((card) => io.observe(card));
  }
</script>
