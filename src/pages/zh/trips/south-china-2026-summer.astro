---
import Layout from '../../../layouts/Layout.astro';
import { getTripById } from '../../../data/registry';
import TripRundown from '../../../components/v1/TripRundown.astro';
import TripPriceBreakdown from '../../../components/v1/TripPriceBreakdown.astro';
import { SOUTH_CHINA_PRICE_CAD } from '../../../data/registry';
import {
  southChinaItinerary,
  southChinaCityGuides,
  southChinaFaqZh,
  southChinaIncludedZh,
  southChinaNotIncludedZh,
  southChinaVideos,
} from '../../../data/south-china.ts';

const trip            = getTripById('south-china-2026-summer')!;
const itinerary       = southChinaItinerary;
const cityGuides      = southChinaCityGuides;
const faq             = southChinaFaqZh;
const included        = southChinaIncludedZh;
const notIncluded     = southChinaNotIncludedZh;
const recommendedVideos = southChinaVideos;

// Pre-compute slides for each day in the frontmatter
type LandmarkItemZh = { name: string; nameZh: string; image: string; background: string; backgroundZh: string };
type CitySlideZh = { type: 'city'; guide: typeof cityGuides[0] };
type LandmarkSlideZh = { type: 'landmark'; lm: LandmarkItemZh };
type DaySlideZh = CitySlideZh | LandmarkSlideZh;

const itineraryWithSlides = itinerary.map((d, idx) => {
  const isFirstCityDay = idx === 0 || itinerary[idx - 1].city !== d.city;
  const cityGuide = cityGuides.find(g => g.city === d.city);
  const landmarks: LandmarkItemZh[] = (d as any).landmarks ?? [];
  const slides: DaySlideZh[] = [
    ...(isFirstCityDay && cityGuide ? [{ type: 'city' as const, guide: cityGuide }] : []),
    ...landmarks.map(lm => ({ type: 'landmark' as const, lm })),
  ];
  return { ...d, isFirstCityDay, slides };
});

const tripStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: trip.titleZh,
    description:
      '探索中国华南线路——10天走访厦门、泉州、潮汕与深圳，海上丝路、妈祖信仰、功夫茶文化与中国速度最快的新兴城市。',
    itinerary: itinerary.map((day) => `${day.dayZh}: ${day.cityZh} - ${day.titleZh}`),
    touristType: '来自加拿大的在校学生与年轻旅行者',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: 'https://www.explorechina.ca/' },
      { '@type': 'ListItem', position: 2, name: '华南线路', item: 'https://www.explorechina.ca/zh/trips/south-china-2026-summer' },
    ],
  },
];
---
<Layout
  title={`${trip.titleZh} · 探索中国 2026`}
  description="探索中国华南线路——10天走访厦门、泉州、潮汕与深圳，海上丝路、妈祖信仰、功夫茶文化与中国速度最快的新兴城市。"
  lang="zh"
  alternateHref="/trips/south-china-2026-summer"
  alternateLabel="English"
  canonical="/zh/trips/south-china-2026-summer"
  structuredData={tripStructuredData}
  darkNav={true}
