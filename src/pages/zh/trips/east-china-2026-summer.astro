---
import Layout from '../../../layouts/Layout.astro';
import { getTripById } from '../../../data/registry';
import TripWhyUs from '../../../components/v1/TripWhyUs.astro';
import TripPriceBreakdown from '../../../components/v1/TripPriceBreakdown.astro';
import {
  faqZh,
  includedZh,
  notIncludedZh,
  cityGuides,
  itinerary,
  recommendedVideos,
} from '../../../data/site';

const trip = getTripById('east-china-2026-summer')!;

// Pre-compute slides for each day in the frontmatter
type LandmarkItemEC = { name: string; nameZh: string; image: string; background: string; backgroundZh: string };
type CitySlidEC = { type: 'city'; guide: typeof cityGuides[0] };
type LandmarkSlidEC = { type: 'landmark'; lm: LandmarkItemEC };
type DaySlidEC = CitySlidEC | LandmarkSlidEC;

const itineraryWithSlides = itinerary.map((d, idx) => {
  const isFirstCityDay = idx === 0 || itinerary[idx - 1].city !== d.city;
  const cityGuide = cityGuides.find(g => g.city === d.city);
  const landmarks: LandmarkItemEC[] = (d as any).landmarks ?? [];
  const slides: DaySlidEC[] = [
    ...(isFirstCityDay && cityGuide ? [{ type: 'city' as const, guide: cityGuide }] : []),
    ...landmarks.map(lm => ({ type: 'landmark' as const, lm })),
  ];
  return { ...d, isFirstCityDay, slides };
});
---
<Layout
  title={trip.titleZh}
  description="2026 年学生带队中国夏季行程，从加拿大出发，10 天走访上海、苏州、杭州与北京。"
  lang="zh"
  alternateHref="/trips/east-china-2026-summer"
  alternateLabel="EN"
  canonical="/zh/trips/east-china-2026-summer"
  darkNav={true}
>

  <!-- Hero Banner -->
  <div class="trip-hero">
    <img
      src="/images/highlights/forbidden-city.jpg"
      alt="北京故宫鸟瞰"
      class="trip-hero__img"
    />
    <div class="trip-hero__overlay">
      <h1 class="trip-hero__title">{trip.titleZh}</h1>
      <p class="trip-hero__sub">{trip.summaryZh}</p>
    </div>
  </div>

  <!-- Overview — compact info strip -->
  <section id="overview" class="trip-strip">
    <div class="trip-strip__inner">
      <div class="trip-strip__facts">
        <div class="trip-strip__fact"><span class="trip-strip__label">路线</span><span class="trip-strip__val">{trip.routeNameZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">出发</span><span class="trip-strip__val">{trip.departureWindowZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">价格</span><span class="trip-strip__val trip-strip__val--price">{trip.priceCadZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">人数</span><span class="trip-strip__val">{trip.groupSizeZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">截止</span><span class="trip-strip__val">{trip.applicationDeadlineZh}</span></div>
      </div>
      <div class="trip-strip__actions">
        <a class="trip-cta" href="#apply">立即申请</a>
      </div>
    </div>
  </section>

  <section class="highlights-strip" aria-label="路线亮点">
    <div class="highlights-strip__header">
      <p class="highlights-strip__eyebrow">行程亮点</p>
      <h2 class="highlights-strip__title">这些等着你</h2>
    </div>
    <div class="highlights-strip__stage">

      <!-- 第一行 → 向左（图1–9）-->
