---
import Layout from '../../../layouts/Layout.astro';
import { getTripById } from '../../../data/registry';
import TripRundown from '../../../components/v1/TripRundown.astro';
import TripPriceBreakdown from '../../../components/v1/TripPriceBreakdown.astro';
import type { CityGuide, Landmark } from '../../../data/types';

const trip = getTripById('east-china-2026-summer')!;
const { itinerary, cityGuides } = trip;
const faqZh = trip.faqZh;
const includedZh = trip.includesZh;
const notIncludedZh = trip.excludesZh;
const recommendedVideos = trip.videos;
const routeIntro = trip.routeIntro!;
const stripRows = trip.highlightStrip!.zh;

// Pre-compute slides for each day in the frontmatter
type CitySlidEC = { type: 'city'; guide: CityGuide };
type LandmarkSlidEC = { type: 'landmark'; lm: Landmark };
type DaySlidEC = CitySlidEC | LandmarkSlidEC;

const itineraryWithSlides = itinerary.map((d, idx) => {
  const isFirstCityDay = idx === 0 || itinerary[idx - 1].city !== d.city;
  const cityGuide = cityGuides.find(g => g.city === d.city);
  const slides: DaySlidEC[] = [
    ...(isFirstCityDay && cityGuide ? [{ type: 'city' as const, guide: cityGuide }] : []),
    ...d.landmarks.map(lm => ({ type: 'landmark' as const, lm })),
  ];
  return { ...d, isFirstCityDay, slides };
});
---
<Layout
  title={trip.titleZh}
  description={trip.seo.descriptionZh}
  lang="zh"
  alternateHref="/trips/east-china-2026-summer"
  alternateLabel="EN"
  canonical="/zh/trips/east-china-2026-summer"
  darkNav={true}
>

  <!-- Hero Banner -->
  <div class="trip-hero">
    <img
      src={trip.heroImage}
      alt={trip.heroImageAltZh}
      class="trip-hero__img"
    />
    <div class="trip-hero__overlay">
      <h1 class="trip-hero__title">{trip.titleZh}</h1>
      <p class="trip-hero__sub">{trip.summaryZh}</p>
    </div>
  </div>

  <!-- Overview — compact info strip -->
  <section id="overview" class="trip-strip">
    <div class="trip-strip__inner">
      <div class="trip-strip__facts">
        <div class="trip-strip__fact"><span class="trip-strip__label">路线</span><span class="trip-strip__val">{trip.routeNameZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">出发</span><span class="trip-strip__val">{trip.departureWindowZh}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">价格</span><span class="trip-strip__val trip-strip__val--price">{trip.priceDisplayZh}</span></div>
        <div class="trip-strip__fact">
          <span class="trip-strip__label">人数</span>
          <span class="trip-strip__val">
            {trip.groupSizeZh}
            <span class="grp-tip">
              <span class="grp-tip__icon" tabindex="0" aria-label="补充说明">
                <svg width="9" height="9" viewBox="0 0 9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                  <circle cx="4.5" cy="4.5" r="4"/>
                  <line x1="4.5" y1="4" x2="4.5" y2="6.5"/>
                  <circle cx="4.5" cy="2.5" r="0.4" fill="currentColor" stroke="none"/>
                </svg>
              </span>
              <span class="grp-tip__text">每项活动无需跟团——随时可以自由离开，按自己的节奏探索城市。</span>
            </span>
          </span>
        </div>
        <div class="trip-strip__fact"><span class="trip-strip__label">截止</span><span class="trip-strip__val">{trip.applicationDeadlineZh}</span></div>
      </div>
      <div class="trip-strip__actions">
        <a class="trip-cta" href="#apply">立即申请</a>
      </div>
    </div>
  </section>

  <section class="highlights-strip" aria-label="路线亮点">
    <div class="highlights-strip__header">
      <p class="highlights-strip__eyebrow">行程亮点</p>
      <h2 class="highlights-strip__title">这些等着你</h2>
    </div>
    <div class="highlights-strip__stage">

      <!-- 第一行 → 向左（图1–9）-->
      <div class="highlights-strip__row highlights-strip__row--1">
        <div class="highlights-strip__track">
          {stripRows[0].map(h => (
            <div class="highlights-strip__card"><img src={h.src} alt={h.alt} loading="lazy" /><p class="highlights-strip__caption">{h.caption}</p></div>
          ))}
          <!-- 复制（无障碍隐藏）-->
          {stripRows[0].map(h => (
            <div class="highlights-strip__card" aria-hidden="true"><img src={h.src} alt="" loading="lazy" /><p class="highlights-strip__caption">{h.caption}</p></div>
          ))}
        </div>
      </div>

      <!-- 第二行 → 向右（图10–18）-->
      <div class="highlights-strip__row highlights-strip__row--2">
        <div class="highlights-strip__track">
          {stripRows[1].map(h => (
            <div class="highlights-strip__card"><img src={h.src} alt={h.alt} loading="lazy" /><p class="highlights-strip__caption">{h.caption}</p></div>
          ))}
          <!-- 复制 -->
          {stripRows[1].map(h => (
            <div class="highlights-strip__card" aria-hidden="true"><img src={h.src} alt="" loading="lazy" /><p class="highlights-strip__caption">{h.caption}</p></div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <section class="route-intro">
  <div class="route-intro__inner">
    <div class="route-intro__rule"></div>

    <p class="route-intro__headline">
      {routeIntro.headlineZh}
    </p>

    <div class="route-intro__body">
      <p>
        {routeIntro.bodyZh}
      </p>
      <span class="route-intro__pivot">{routeIntro.pivotZh}</span>
    </div>

    <div class="route-intro__selector">
      <div class="route-intro__city-list">
        {routeIntro.panels.map((p, i) => (
          <button class="route-intro__city-item" data-city={i}>
            <span class="route-intro__city-name">{p.cityZh}</span>
            <div class="route-intro__dots"><span class="route-intro__dot"></span><span class="route-intro__dot"></span><span class="route-intro__dot"></span></div>
          </button>
        ))}
      </div>
      <div class="route-intro__city-content">
        {routeIntro.panels.map((p, i) => (
          <div class="route-intro__city-panel" data-panel={i}>
            <p>{p.proseZh}</p>
          </div>
        ))}
      </div>
    </div>

    <p class="route-intro__colophon" set:html={routeIntro.colophonHtmlZh}></p>
  </div>
</section>

<script>
(function () {
  const DURATION = 8000;
  const INK_MS   = 1800;
  const selector = document.querySelector('.route-intro__selector');
  if (!selector) return;
  const items  = Array.from(selector.querySelectorAll('.route-intro__city-item'));
  const panels = Array.from(selector.querySelectorAll('.route-intro__city-panel'));
  let current = 0, timer = null, paused = false;
  function rnd(min, max) { return (Math.random() * (max - min) + min).toFixed(1) + '%'; }
  function activate(index) {
    current = index;
    panels.forEach(p => { p.style.transition = 'none'; p.classList.remove('is-active'); });
    items.forEach((item, i) => {
      item.classList.toggle('is-active', i === index);
      item.querySelectorAll('.route-intro__dot').forEach(d => {
        d.style.background = i === index ? 'var(--color-red)' : '';
      });
    });
    const panel = panels[index];
    panel.style.setProperty('--clip-origin', `${rnd(25, 75)} ${rnd(25, 75)}`);
    requestAnimationFrame(() => {
      panel.style.transition = `clip-path ${INK_MS}ms cubic-bezier(0.16, 1, 0.3, 1)`;
      panel.classList.add('is-active');
    });
    clearTimeout(timer);
    if (!paused) timer = setTimeout(() => activate((current + 1) % items.length), DURATION);
  }
  items.forEach((item, i) => item.addEventListener('click', () => { paused = false; activate(i); }));
  selector.addEventListener('mouseenter', () => { paused = true; clearTimeout(timer); });
  selector.addEventListener('mouseleave', () => {
    paused = false;
    timer = setTimeout(() => activate((current + 1) % items.length), DURATION);
  });
  activate(0);
})();
</script>

  <TripRundown lang="zh" />

  <TripPriceBreakdown lang="zh" price={trip.priceCad} items={trip.priceBreakdown} />

  <section id="itinerary" class="section card tone-sand">
    <h2 class="section-title">十天行程一览</h2>
    <p class="section-sub" style="margin-bottom:2rem;">点击每一天，探索沿途的城市与景点。</p>

    <div class="itinerary-accordion">
      {itineraryWithSlides.map((d, idx) => (
          <div
            class={`itinerary-day${d.isFirstCityDay ? ' itinerary-day--city-start' : ''}`}
            data-day-idx={idx}
          >
            <button class="itinerary-day__header" data-day-toggle aria-expanded="false">
              <span class="itinerary-day__number">{d.dayZh}</span>
              <span class="itinerary-day__dot"></span>
              <div class="itinerary-day__meta">
                <span class="itinerary-day__city">{d.cityZh}</span>
                <h3 class="itinerary-day__title">{d.titleZh ?? d.title}</h3>
                <p class="itinerary-day__plan">{d.planZh ?? d.plan}</p>
              </div>
              <span class="itinerary-day__toggle-icon" aria-hidden="true">+</span>
            </button>

            <div class="itinerary-day__body" data-day-body>
              <div class="itinerary-day__body-inner">
                {d.slides.length > 0 && (
                  <div class="landmark-carousel" data-carousel>
                    <div class="landmark-carousel__track-wrap">
                      <div class="landmark-carousel__track" data-carousel-track>

                        {d.slides.map((slide) => (
                          <div class="landmark-carousel__slide">
                            {slide.type === 'city' ? (
                              <div class="city-intro-card">
                                <div class="city-intro-card__image">
                                  <img
                                    src={slide.guide.heroImage}
                                    alt={slide.guide.heroAlt}
                                    loading="lazy"
                                  />
                                </div>
                                <div class="city-intro-card__content">
                                  <span class="city-intro-card__label">城市概览</span>
                                  <h3 class="city-intro-card__city">{slide.guide.cityZh}</h3>
                                  <p class="city-intro-card__desc">{slide.guide.contextZh}</p>
                                </div>
                              </div>
                            ) : (
                              <div class="landmark-card">
                                <div class="landmark-card__visual">
                                  <img
                                    src={slide.lm.image}
                                    alt={slide.lm.nameZh}
                                    loading="lazy"
                                  />
                                </div>
                                <div class="landmark-card__base-overlay"></div>
                                <div class="landmark-card__name-overlay">
                                  <p class="landmark-card__name">{slide.lm.nameZh}</p>
                                  <p class="landmark-card__name-zh">{slide.lm.name}</p>
                                </div>
                                <div class="landmark-card__overlay"></div>
                                <div class="landmark-card__body">
                                  <p class="landmark-card__body-name">{slide.lm.nameZh}</p>
                                  <p class="landmark-card__body-name-zh">{slide.lm.name}</p>
                                  <p class="landmark-card__background">{slide.lm.backgroundZh ?? slide.lm.background}</p>
                                </div>
                              </div>
                            )}
                          </div>
                        ))}

                      </div>
                    </div>

                    {d.slides.length > 1 && (
                      <div class="landmark-carousel__dots" style="margin-top:0.5rem;">
                        {d.slides.map((_slide, i) => (
                          <span class={`landmark-carousel__dot${i === 0 ? ' is-active' : ''}`} data-carousel-dot></span>
                        ))}
                      </div>
                    )}
                    <button class="landmark-carousel__btn landmark-carousel__btn--prev" data-carousel-prev aria-label="上一张">←</button>
                    <button class="landmark-carousel__btn landmark-carousel__btn--next" data-carousel-next aria-label="下一张">→</button>
                  </div>
                )}
              </div>
            </div>
          </div>
      ))}
    </div>
  </section>

  <!-- Included / Not Included -->
  <section class="section incl-grid">
    <article class="incl-card incl-card--yes">
      <h2 class="incl-card__title">包含内容</h2>
      <ul class="incl-list">
        {includedZh.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--yes">✓</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
    <article class="incl-card incl-card--no">
      <h2 class="incl-card__title">不包含内容</h2>
      <ul class="incl-list">
        {notIncludedZh.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--no">✗</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
  </section>

  <!-- Videos -->
  <section class="section card tone-blue">
    <h2 class="section-title">出发前可以先看的视频</h2>
    <div class="grid cols-3 video-grid">
      {recommendedVideos.map((video) => {
        const ytId = video.url.match(/[?&]v=([^&]+)/)?.[1] || '';
        return (
          <a href={video.url} target="_blank" rel="noopener" class="video-card">
            <div class="video-card__thumb">
              <img src={`https://img.youtube.com/vi/${ytId}/hqdefault.jpg`} alt={video.titleZh} loading="lazy" />
              <div class="video-card__play">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.6)"/><path d="M19 15l14 9-14 9V15z" fill="#fff"/></svg>
              </div>
            </div>
            <div class="video-card__info">
              <h3 class="video-card__title">{video.titleZh}</h3>
              <p class="video-card__creator">{video.creator}</p>
              <p class="video-card__note">{video.noteZh}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- FAQ (accordion, consistent with homepage) -->
  <section id="faq" class="faq">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">常见问题</p>
        <h2 class="section-title">常见问题解答</h2>
      </div>
      <div class="faq__list">
        {faqZh.map((f, i) => (
          <div class="faq__item" id={`trip-faq-${i}`}>
            <button class="faq__q" aria-expanded="false" aria-controls={`trip-faq-answer-${i}`}>
              <span>{f.q}</span>
              <svg class="faq__icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <div class="faq__a" id={`trip-faq-answer-${i}`} role="region" aria-labelledby={`trip-faq-${i}`}>
              <div class="faq__a-inner">{f.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="apply" class="route-apply">
    <div class="container" style="text-align:center; padding-top:0; padding-bottom:0;">
      <p class="section-eyebrow" style="color:rgba(255,255,255,0.6);">申请</p>
      <h2 class="section-title" style="color:#fff; margin-bottom:1rem;">准备好了吗？</h2>
      <p style="color:rgba(255,255,255,0.72); font-size:clamp(0.95rem,2vw,1.05rem); line-height:1.75; max-width:460px; margin:0 auto 2rem;">
        告诉我们一些关于你的信息，以及你感兴趣的行程——我们将在5个工作日内回复。
      </p>
      <a href="/apply"
        style="display:inline-block; background:var(--color-red,#c8102e); color:#fff; padding:0.9rem 2.5rem; font-size:0.875rem; font-weight:600; letter-spacing:0.08em; text-decoration:none; text-transform:uppercase; transition:background 0.2s;"
        onmouseover="this.style.background='#a00d24'"
        onmouseout="this.style.background='var(--color-red,#c8102e)'">
        立即申请 →
      </a>
    </div>
  </section>
</Layout>

<style>
.trip-hero {
  position: relative;
  height: clamp(480px, 65vh, 720px);
  overflow: hidden;
}
.trip-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.trip-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 2.5rem;
  text-align: center;
}
.trip-hero__title {
  color: #fff;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  font-family: var(--font-display);
  line-height: 1.1;
  margin-bottom: 0.75rem;
}
.trip-hero__sub {
  color: rgba(255,255,255,0.85);
  font-size: 1.1rem;
  max-width: 640px;
  line-height: 1.7;
}
</style>

<script is:inline>
// ── FAQ accordion ──────────────────────────────────────
document.querySelectorAll('.faq__item').forEach(item => {
  const btn = item.querySelector('.faq__q');
  const answer = item.querySelector('.faq__a');
  btn?.addEventListener('click', () => {
    const open = item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    if (answer) answer.style.maxHeight = open ? answer.scrollHeight + 'px' : '0';
  });
});

// ── Itinerary day accordion ────────────────────────────
document.querySelectorAll('.itinerary-day').forEach(day => {
  const header = day.querySelector('[data-day-toggle]');
  const body = day.querySelector('[data-day-body]');
  if (!header || !body) return;
  header.addEventListener('click', () => {
    const open = body.classList.toggle('is-open');
    header.setAttribute('aria-expanded', String(open));
  });
});

// ── Highlights marquee — tap to pause (mobile) ─────────
document.querySelectorAll('.highlights-strip__stage').forEach(stage => {
  stage.addEventListener('click', (e) => {
    const card = e.target.closest('.highlights-strip__card');
    const allCards = stage.querySelectorAll('.highlights-strip__card');
    if (card) {
      const isActive = card.classList.contains('is-active');
      allCards.forEach(c => c.classList.remove('is-active'));
      if (isActive) {
        stage.classList.remove('is-paused');
      } else {
        stage.classList.add('is-paused');
        card.classList.add('is-active');
      }
    } else {
      stage.classList.remove('is-paused');
      allCards.forEach(c => c.classList.remove('is-active'));
    }
  });
});

// ── Landmark carousels ─────────────────────────────────
document.querySelectorAll('[data-carousel]').forEach(carousel => {
  const track = carousel.querySelector('[data-carousel-track]');
  const slides = carousel.querySelectorAll('.landmark-carousel__slide');
  const prevBtn = carousel.querySelector('[data-carousel-prev]');
  const nextBtn = carousel.querySelector('[data-carousel-next]');
  const dots = carousel.querySelectorAll('[data-carousel-dot]');
  if (!track || slides.length === 0) return;

  let idx = 0;
  const total = slides.length;
  const slideWidth = 88;

  function goTo(n) {
    idx = Math.max(0, Math.min(n, total - 1));
    track.style.transform = `translateX(-${idx * slideWidth}%)`;
    dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
    if (prevBtn) prevBtn.disabled = idx === 0;
    if (nextBtn) nextBtn.disabled = idx === total - 1;
  }

  prevBtn?.addEventListener('click', () => goTo(idx - 1));
  nextBtn?.addEventListener('click', () => goTo(idx + 1));

  let touchX = 0;
  carousel.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, { passive: true });
  carousel.addEventListener('touchend', e => {
    const delta = touchX - e.changedTouches[0].clientX;
    if (Math.abs(delta) > 40) goTo(idx + (delta > 0 ? 1 : -1));
  });

  goTo(0);
});
</script>
