---
import Layout from '../layouts/Layout.astro';
import { aboutContent, site } from '../data/site';
---
<Layout
  title="About Us | Explore China Student Travel"
  description="Learn about the student-led Explore China program for Canada-based travelers and the team behind the route."
  lang="en"
  alternateHref="/zh/about"
  alternateLabel="中文"
  canonical="/about"
  heroNav={true}
>

  <!-- ═══ HERO — full-width image like trip page ═══ -->
  <section class="about-hero">
    <img
      src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1920&q=85"
      alt="Friends traveling together"
      class="about-hero__img"
      fetchpriority="high"
    />
    <div class="about-hero__overlay"></div>
    <div class="about-hero__content">
      <p class="about-hero__eyebrow">About Us</p>
      <h1 class="about-hero__title">Built by students.<br/>For students.</h1>
      <p class="about-hero__sub">{aboutContent.heroSub}</p>
    </div>
  </section>

  <!-- ═══ STORY — the origin ═══ -->
  <section class="about-story">
    <div class="about-story__inner">
      <h2 class="about-story__heading">How it started</h2>
      <div class="about-story__body">
        <p class="about-story__lead">{aboutContent.heroText}</p>
        <p class="about-story__text">{aboutContent.story}</p>
        <a href="/#story-section" class="about-story__link">Read our full story →</a>
      </div>
    </div>
  </section>

  <!-- ═══ TEAM (moved up — people want to know who's behind it) ═══ -->
  <section class="about-team">
    <div class="about-team__inner">
      <h2 class="about-section-title">The team</h2>
      <p class="about-team__intro">A small crew of students who've lived and traveled in China — and want to help others do the same.</p>
      <div class="about-team__grid">
        {aboutContent.team.map((member) => (
          <article class="about-team-card">
            <div class="about-team-card__avatar">
              <span class="about-team-card__initial">{member.name.charAt(0)}</span>
            </div>
            <p class="about-team-card__role">{member.role}</p>
            <h3 class="about-team-card__name">{member.name}</h3>
            <p class="about-team-card__bio">{member.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ VALUES — what we believe ═══ -->
  <section class="about-values">
    <div class="about-values__inner">
      <h2 class="about-section-title">What we believe</h2>
      <div class="about-values__grid">
        <div class="about-value-card">
          <span class="about-value-card__icon">🌏</span>
          <h3 class="about-value-card__title">Travel is personal</h3>
          <p class="about-value-card__text">The best trips change how you see the world — and yourself. We design for moments that stay with you, not just photos for your feed.</p>
        </div>
        <div class="about-value-card">
          <span class="about-value-card__icon">🤝</span>
          <h3 class="about-value-card__title">People make the trip</h3>
          <p class="about-value-card__text">The group matters as much as the route. We bring together curious, open-minded people who want to share the experience — not just tick boxes.</p>
        </div>
        <div class="about-value-card">
          <span class="about-value-card__icon">🔑</span>
          <h3 class="about-value-card__title">Structure without restriction</h3>
          <p class="about-value-card__text">Enough planning so you feel safe. Enough freedom so it still feels like discovery. That balance is everything.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHY — emotional closer ═══ -->
  <section class="about-why">
    <div class="about-why__inner">
      <h2 class="about-why__heading">Why we built this</h2>
      <p class="about-why__text">{aboutContent.whoWeAre}</p>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="about-cta">
    <div class="about-cta__inner">
      <h2 class="about-cta__heading">Ready to go?</h2>
      <p class="about-cta__text">Check the itinerary, read the handbook, or just say hi.</p>
      <div class="about-cta__buttons">
        <a href="/trips/east-china-2026-summer" class="btn btn--primary">See the trip</a>
        <a href="/apply" class="btn btn--ghost">Apply now</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ── Hero ────────────────────────────────────── */
.about-hero {
  position: relative;
  height: clamp(420px, 60vh, 600px);
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 3rem 2rem;
}
.about-hero__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
}
.about-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.1) 100%);
}
.about-hero__content {
  position: relative;
  z-index: 1;
  max-width: 680px;
}
.about-hero__eyebrow {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: rgba(255,255,255,0.7);
  margin-bottom: 0.5rem;
  font-weight: 500;
}
.about-hero__title {
  font-size: clamp(2rem, 5vw, 3.2rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.15;
  margin: 0 0 1rem;
  font-family: var(--font-display, system-ui);
}
.about-hero__sub {
  font-size: clamp(1rem, 2vw, 1.15rem);
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
  max-width: 560px;
}

/* ── Story ───────────────────────────────────── */
.about-story {
  padding: 5rem 2rem;
  background: #fdfcfb;
}
.about-story__inner {
  max-width: 720px;
  margin: 0 auto;
}
.about-story__heading {
  font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  font-weight: 700;
  font-family: var(--font-display, system-ui);
  color: #1c1917;
  margin-bottom: 1.5rem;
}
.about-story__lead {
  font-size: clamp(1.1rem, 2.2vw, 1.35rem);
  font-weight: 500;
  color: #44403c;
  line-height: 1.65;
  margin-bottom: 1.5rem;
}
.about-story__text {
  font-size: 1.05rem;
  color: #78716c;
  line-height: 1.8;
}
.about-story__link {
  display: inline-block;
  margin-top: 1.5rem;
  font-size: 0.95rem;
  font-weight: 500;
  color: #b91c1c;
  text-decoration: none;
  transition: color 0.2s;
}
.about-story__link:hover {
  color: #991b1b;
}

/* ── Values ──────────────────────────────────── */
.about-values {
  padding: 4rem 2rem 5rem;
  background: #f5f1eb;
}
.about-values__inner {
  max-width: 960px;
  margin: 0 auto;
}
.about-section-title {
  font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  font-weight: 700;
  font-family: var(--font-display, system-ui);
  color: #1c1917;
  text-align: center;
  margin-bottom: 2.5rem;
}
.about-values__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}
.about-value-card {
  background: #fff;
  border-radius: 12px;
  padding: 2rem 1.5rem;
  text-align: center;
}
.about-value-card__icon {
  font-size: 2rem;
  display: block;
  margin-bottom: 0.75rem;
}
.about-value-card__title {
  font-size: 1.1rem;
  font-weight: 600;
  color: #1c1917;
  margin-bottom: 0.6rem;
}
.about-value-card__text {
  font-size: 0.95rem;
  color: #78716c;
  line-height: 1.65;
}

/* ── Team ────────────────────────────────────── */
.about-team {
  padding: 5rem 2rem;
  background: #fdfcfb;
}
.about-team__inner {
  max-width: 960px;
  margin: 0 auto;
}
.about-team__intro {
  text-align: center;
  color: #78716c;
  font-size: 1.05rem;
  line-height: 1.7;
  max-width: 560px;
  margin: -1.5rem auto 2.5rem;
}
.about-team__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
}
.about-team-card {
  background: #fff;
  border: 1px solid #e7e5e4;
  border-radius: 12px;
  padding: 2rem 1.5rem;
  text-align: center;
}
.about-team-card__avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: linear-gradient(135deg, #d6cfc7, #a8998a);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1rem;
}
.about-team-card__initial {
  font-size: 1.3rem;
  font-weight: 600;
  color: #fff;
}
.about-team-card__role {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #a8a29e;
  font-weight: 500;
  margin-bottom: 0.3rem;
}
.about-team-card__name {
  font-size: 1.15rem;
  font-weight: 600;
  color: #1c1917;
  margin-bottom: 0.5rem;
}
.about-team-card__bio {
  font-size: 0.92rem;
  color: #78716c;
  line-height: 1.6;
}

/* ── Why ─────────────────────────────────────── */
.about-why {
  padding: 5rem 2rem;
  background: #292524;
  color: #fff;
}
.about-why__inner {
  max-width: 680px;
  margin: 0 auto;
  text-align: center;
}
.about-why__heading {
  font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  font-weight: 700;
  font-family: var(--font-display, system-ui);
  margin-bottom: 1.5rem;
}
.about-why__text {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.8);
  line-height: 1.8;
}

/* ── CTA ─────────────────────────────────────── */
.about-cta {
  padding: 4rem 2rem 5rem;
  background: #fdfcfb;
}
.about-cta__inner {
  max-width: 560px;
  margin: 0 auto;
  text-align: center;
}
.about-cta__heading {
  font-size: clamp(1.5rem, 3.5vw, 2rem);
  font-weight: 700;
  font-family: var(--font-display, system-ui);
  color: #1c1917;
  margin-bottom: 0.5rem;
}
.about-cta__text {
  color: #78716c;
  font-size: 1.05rem;
  margin-bottom: 1.5rem;
}
.about-cta__buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}
.about-cta__buttons .btn--primary {
  background: #b91c1c;
  color: #fff;
  padding: 0.75rem 2rem;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  font-size: 0.95rem;
  transition: background 0.2s;
}
.about-cta__buttons .btn--primary:hover { background: #991b1b; }
.about-cta__buttons .btn--ghost {
  border: 1.5px solid #d6d3d1;
  color: #44403c;
  padding: 0.75rem 2rem;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  font-size: 0.95rem;
  transition: border-color 0.2s, background 0.2s;
}
.about-cta__buttons .btn--ghost:hover {
  border-color: #a8a29e;
  background: rgba(0,0,0,0.02);
}

/* ── Mobile ──────────────────────────────────── */
@media (max-width: 640px) {
  .about-hero { height: clamp(320px, 55vh, 480px); padding: 2rem 1.5rem; }
  .about-story, .about-team, .about-cta { padding: 3rem 1.5rem; }
  .about-values { padding: 3rem 1.5rem; }
  .about-why { padding: 3.5rem 1.5rem; }
}
</style>
