---
import Layout from '../../layouts/Layout.astro';
import { getTripById } from '../../data/registry';
import TripRundown from '../../components/v1/TripRundown.astro';
import TripPriceBreakdown from '../../components/v1/TripPriceBreakdown.astro';
import { SOUTH_CHINA_PRICE_CAD } from '../../data/registry';
import {
  southChinaItinerary,
  southChinaCityGuides,
  southChinaFaq,
  southChinaIncluded,
  southChinaNotIncluded,
  southChinaVideos,
} from '../../data/south-china.ts';

const trip            = getTripById('south-china-2026-summer')!;
const itinerary       = southChinaItinerary;
const cityGuides      = southChinaCityGuides;
const faq             = southChinaFaq;
const included        = southChinaIncluded;
const notIncluded     = southChinaNotIncluded;
const recommendedVideos = southChinaVideos;

// Pre-compute slides for each day in the frontmatter (TypeScript safe)
type LandmarkItem = { name: string; nameZh: string; image: string; background: string; backgroundZh: string };
type CitySlide = { type: 'city'; guide: typeof cityGuides[0] };
type LandmarkSlide = { type: 'landmark'; lm: LandmarkItem };
type DaySlide = CitySlide | LandmarkSlide;

const scHighlights = [
  { src: '/images/places/south-china-tower-forest.jpg',      alt: 'Quanzhou East Pagoda rising above city trees',           caption: 'A Song Dynasty pagoda that outlasted every empire that built around it' },
  { src: '/images/places/south-china-aerial-clock-tower.jpg',alt: 'Xiamen Zhongshan Road clock tower at dusk',              caption: 'Zhongshan Road at dusk — colonial grid still running on foot traffic' },
  { src: '/images/highlights/xiamen-shacha-noodles-top.jpg', alt: 'Xiamen shacha noodles',                                  caption: 'A bowl of peanut broth that Xiamen calls its own' },
  { src: '/images/places/south-china-building-red.jpg',      alt: 'Southern Fujian temple with curved red-tile roof',       caption: 'The oldest temples in southern Fujian still draw worshippers every morning' },
  { src: '/images/places/south-china-city-hilltop.jpg',      alt: 'Xiamen coastal skyline panorama from the hills',         caption: 'The city that kept facing the sea it sent its emigrants across' },
  { src: '/images/places/south-china-temple-statue.jpg',     alt: 'Mazu goddess statue above colourful temple rooftops',    caption: 'Mazu watches over the coast she has protected for a thousand years' },
  { src: '/images/places/south-china-shenzhen-night.jpg',    alt: 'Tencent headquarters towers lit up at night in Shenzhen',caption: 'Shenzhen after midnight — a city that built itself in forty years on this shoreline' },
  { src: '/images/places/south-china-food-dimsum.jpg',       alt: 'Rows of bamboo steamers filled with Cantonese dim sum',  caption: 'Cantonese dim sum — a table of steamers that keeps arriving until you say stop' },
  { src: '/images/places/south-china-food-bowls.jpg',        alt: 'Oysters, clams and abalone on a coastal seafood table',  caption: 'Oysters, clams, abalone — pulled from water you can still see from the table' },
];
const scHighlightsRev = [...scHighlights].reverse();

const itineraryWithSlides = itinerary.map((d, idx) => {
  const isFirstCityDay = idx === 0 || itinerary[idx - 1].city !== d.city;
  const cityGuide = cityGuides.find(g => g.city === d.city);
  const landmarks: LandmarkItem[] = (d as any).landmarks ?? [];
  const slides: DaySlide[] = [
    ...(isFirstCityDay && cityGuide ? [{ type: 'city' as const, guide: cityGuide }] : []),
    ...landmarks.map(lm => ({ type: 'landmark' as const, lm })),
  ];
  return { ...d, isFirstCityDay, slides };
});

const tripStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: trip.title,
    description:
      'A 10-day student travel route through Xiamen, Quanzhou, Chaoshan and Shenzhen — diaspora coast, Mazu maritime faith, Gongfu tea, and China\'s fastest-built city.',
    itinerary: itinerary.map((day) => `${day.day}: ${day.city} - ${day.title}`),
    touristType: 'Students and young travelers from Canada',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.explorechina.ca/' },
      { '@type': 'ListItem', position: 2, name: 'South China Route', item: 'https://www.explorechina.ca/trips/south-china-2026-summer' },
    ],
  },
];
---
<Layout
  title={`${trip.title} · Explore China 2026`}
  description="A 10-day student travel route through Xiamen, Quanzhou, Chaoshan and Shenzhen — diaspora coast, Mazu maritime faith, Gongfu tea, and China's fastest-built city."
  lang="en"
  alternateHref="/zh/trips/south-china-2026-summer"
  alternateLabel="中文"
  canonical="/trips/south-china-2026-summer"
  structuredData={tripStructuredData}
  darkNav={true}
>

  <div class="trip-hero">
    <img
      src="/images/places/south-china-tower-forest.jpg"
      alt="Quanzhou East Pagoda above city trees"
      class="trip-hero__img"
    />
    <div class="trip-hero__overlay">
      <h1 class="trip-hero__title">{trip.title}</h1>
      <p class="trip-hero__sub">{trip.summary}</p>
    </div>
  </div>

  <section id="overview" class="trip-strip">
    <div class="trip-strip__inner">
      <div class="trip-strip__facts">
        <div class="trip-strip__fact"><span class="trip-strip__label">Route</span><span class="trip-strip__val">{trip.routeName}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Departure</span><span class="trip-strip__val">{trip.departureWindow}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Price</span><span class="trip-strip__val trip-strip__val--price">{trip.priceCad}</span></div>
        <div class="trip-strip__fact">
          <span class="trip-strip__label">Group</span>
          <span class="trip-strip__val">
            {trip.groupSize}
            <span class="grp-tip">
              <span class="grp-tip__icon" aria-label="More info">
                <svg width="9" height="9" viewBox="0 0 9 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                  <circle cx="4.5" cy="4.5" r="4"/>
                  <line x1="4.5" y1="4" x2="4.5" y2="6.5"/>
                  <circle cx="4.5" cy="2.5" r="0.4" fill="currentColor" stroke="none"/>
                </svg>
              </span>
              <span class="grp-tip__text">You don't have to follow the group for every activity — you can leave any time to explore the city on your own.</span>
            </span>
          </span>
        </div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Deadline</span><span class="trip-strip__val">{trip.applicationDeadline}</span></div>
      </div>
      <div class="trip-strip__actions">
        <a class="trip-cta" href="#apply">Apply for This Trip</a>
      </div>
    </div>
  </section>

  <!-- Highlights Strip -->
  <section class="highlights-strip" aria-label="Route highlights">
    <div class="highlights-strip__header">
      <p class="highlights-strip__eyebrow">Route Highlights</p>
      <h2 class="highlights-strip__title">What you'll see</h2>
    </div>
    <div class="highlights-strip__stage">

      <!-- Row 1 → left -->
      <div class="highlights-strip__row highlights-strip__row--1 hs-cycle3">
        <div class="highlights-strip__track">
          {scHighlights.map(h => (
            <div class="highlights-strip__card"><img src={h.src} alt={h.alt} loading="lazy" /><p class="highlights-strip__caption">{h.caption}</p></div>
          ))}
          {[...scHighlights, ...scHighlights].map(h => (
            <div class="highlights-strip__card" aria-hidden="true"><img src={h.src} alt="" loading="lazy" /><p class="highlights-strip__caption">{h.caption}</p></div>
          ))}
        </div>
      </div>

      <!-- Row 2 → right (reversed) -->
      <div class="highlights-strip__row highlights-strip__row--2 hs-cycle3">
        <div class="highlights-strip__track">
          {scHighlightsRev.map(h => (
            <div class="highlights-strip__card"><img src={h.src} alt={h.alt} loading="lazy" /><p class="highlights-strip__caption">{h.caption}</p></div>
          ))}
          {[...scHighlightsRev, ...scHighlightsRev].map(h => (
            <div class="highlights-strip__card" aria-hidden="true"><img src={h.src} alt="" loading="lazy" /><p class="highlights-strip__caption">{h.caption}</p></div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <section class="route-intro">
  <div class="route-intro__inner">
    <div class="route-intro__rule"></div>

    <p class="route-intro__headline">
      Four cities. Four different Chinas.
    </p>

    <div class="route-intro__body">
      <p>
        The South China Route moves through the coast that the world's Chinatowns came from.
        Xiamen's sea-worn lanes and diaspora nostalgia, Quanzhou — once the world's busiest
        port — where Mazu temples and stone mosques stand on the same street, Chaoshan's
        ancient Teochew civilization still running on tea and beef and thousand-year-old rituals,
        and Shenzhen: forty years old, seventeen million people, still figuring out what it is.
      </p>
    </div>

    <div class="route-intro__selector">
      <div class="route-intro__city-list">
        <button class="route-intro__city-item" data-city="0">
          <span class="route-intro__city-name">Xiamen</span>
          <div class="route-intro__dots"><span class="route-intro__dot"></span><span class="route-intro__dot"></span><span class="route-intro__dot"></span></div>
        </button>
        <button class="route-intro__city-item" data-city="1">
          <span class="route-intro__city-name">Quanzhou</span>
          <div class="route-intro__dots"><span class="route-intro__dot"></span><span class="route-intro__dot"></span><span class="route-intro__dot"></span></div>
        </button>
        <button class="route-intro__city-item" data-city="2">
          <span class="route-intro__city-name">Chaoshan</span>
          <div class="route-intro__dots"><span class="route-intro__dot"></span><span class="route-intro__dot"></span><span class="route-intro__dot"></span></div>
        </button>
        <button class="route-intro__city-item" data-city="3">
          <span class="route-intro__city-name">Shenzhen</span>
          <div class="route-intro__dots"><span class="route-intro__dot"></span><span class="route-intro__dot"></span><span class="route-intro__dot"></span></div>
        </button>
      </div>
      <div class="route-intro__city-content">
        <div class="route-intro__city-panel" data-panel="0">
          <p>The sea arrives before the city does. You smell it first — salt and rain and something faintly sweet that turns out to be incense from the temple at the end of the lane. On Gulangyu the streets are too narrow for cars, which means you hear everything: piano scales from a second-floor window, the clatter of a bicycle, someone's grandmother arguing with a fruit seller. The pace is different here. You will notice it by the end of the first afternoon.</p>
        </div>
        <div class="route-intro__city-panel" data-panel="1">
          <p>Marco Polo called this harbour the finest he had ever seen. That was the thirteenth century. The Tang dynasty mosque still stands. The Song dynasty temple still holds its incense smoke. In the side streets you find stone carvings in Arabic and Tamil alongside Chinese characters — because this was the port the whole world passed through, and it kept the marks. The diaspora that built Chinatowns from Vancouver to Singapore started leaving from docks like these.</p>
        </div>
        <div class="route-intro__city-panel" data-panel="2">
          <p>Chaoshan moves at the speed of tea. A session here is not a tourist activity — it's how people talk. Your host will fill the tiny cup before it empties; refusing means you want to leave. Sit long enough and the conversation finds its own rhythm. The beef at dinner was in a paddock this morning. The noodles were made by hand two hours ago. Everything is closer to its source than you expect.</p>
        </div>
        <div class="route-intro__city-panel" data-panel="3">
          <p>Shenzhen announces itself through scale. The buildings are enormous and new and completely unapologetic about it. There is no nostalgia here — the city is 45 years old and knows it. What you find instead is energy: the electronics market where engineers source components at 8am, the art district that appeared in a former factory compound, the young residents who came from everywhere else and are still figuring out what kind of place this is.</p>
        </div>
      </div>
    </div>

    <p class="route-intro__colophon">
      10 days &nbsp;·&nbsp; Xiamen · Quanzhou · Chaoshan · Shenzhen
    </p>
  </div>
</section>

<script>
(function () {
  const DURATION = 8000;
  const INK_MS   = 1800;
  const selector = document.querySelector('.route-intro__selector');
  if (!selector) return;
  const items  = Array.from(selector.querySelectorAll('.route-intro__city-item'));
  const panels = Array.from(selector.querySelectorAll('.route-intro__city-panel'));
  let current = 0, timer = null, paused = false;

  function rnd(min, max) { return (Math.random() * (max - min) + min).toFixed(1) + '%'; }

  function activate(index) {
    current = index;
    panels.forEach(p => { p.style.transition = 'none'; p.classList.remove('is-active'); });
    items.forEach((item, i) => {
      item.classList.toggle('is-active', i === index);
      item.querySelectorAll('.route-intro__dot').forEach(d => {
        d.style.background = i === index ? 'var(--color-red)' : '';
      });
    });
    const panel = panels[index];
    panel.style.setProperty('--clip-origin', `${rnd(25, 75)} ${rnd(25, 75)}`);
    requestAnimationFrame(() => {
      panel.style.transition = `clip-path ${INK_MS}ms cubic-bezier(0.16, 1, 0.3, 1)`;
      panel.classList.add('is-active');
    });
    clearTimeout(timer);
    if (!paused) timer = setTimeout(() => activate((current + 1) % items.length), DURATION);
  }

  items.forEach((item, i) => item.addEventListener('click', () => { paused = false; activate(i); }));
  selector.addEventListener('mouseenter', () => { paused = true; clearTimeout(timer); });
  selector.addEventListener('mouseleave', () => {
    paused = false;
    timer = setTimeout(() => activate((current + 1) % items.length), DURATION);
  });
  activate(0);
})();
</script>

  <TripRundown lang="en" route="south" />

  <TripPriceBreakdown lang="en" route="south" price={SOUTH_CHINA_PRICE_CAD} />

  <section id="itinerary" class="section card tone-sand">
    <h2 class="section-title">10-day route at a glance</h2>
    <p class="section-sub" style="margin-bottom:2rem;">Click any day to explore the places you'll visit.</p>

    <div class="itinerary-accordion">
      {itineraryWithSlides.map((d, idx) => (
          <div
            class={`itinerary-day${d.isFirstCityDay ? ' itinerary-day--city-start' : ''}`}
            data-day-idx={idx}
          >
            <button class="itinerary-day__header" data-day-toggle aria-expanded="false">
              <span class="itinerary-day__number">{d.day}</span>
              <span class="itinerary-day__dot"></span>
              <div class="itinerary-day__meta">
                <span class="itinerary-day__city">{d.city}</span>
                <h3 class="itinerary-day__title">{d.title}</h3>
                <p class="itinerary-day__plan">{d.plan}</p>
              </div>
              <span class="itinerary-day__toggle-icon" aria-hidden="true">+</span>
            </button>

            <div class="itinerary-day__body" data-day-body>
              <div class="itinerary-day__body-inner">
                {d.slides.filter((s: DaySlide) => s.type === 'landmark').length > 0 && (
                  <ul class="stop-list">
                    {d.slides.filter((s: DaySlide) => s.type === 'landmark').map((slide: DaySlide) => (
                      <li class="stop-list__item">
                        <span class="stop-list__name">{(slide as LandmarkSlide).lm.name}</span>
                        <p class="stop-list__desc">{(slide as LandmarkSlide).lm.background.match(/[^.!?]+[.!?]+/g)?.slice(0,2).join(' ') ?? (slide as LandmarkSlide).lm.background}</p>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
      ))}
    </div>
  </section>

  <section class="section incl-grid">
    <article class="incl-card incl-card--yes">
      <h2 class="incl-card__title">Included</h2>
      <ul class="incl-list">
        {included.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--yes">✓</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
    <article class="incl-card incl-card--no">
      <h2 class="incl-card__title">Not included</h2>
      <ul class="incl-list">
        {notIncluded.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--no">×</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
  </section>

  <section class="section card tone-blue">
    <h2 class="section-title">Video references before you decide</h2>
    <div class="grid cols-3 video-grid">
      {recommendedVideos.map((video) => {
        const ytId = video.url.match(/[?&]v=([^&]+)/)?.[1] || '';
        return (
          <a href={video.url} target="_blank" rel="noopener" class="video-card">
            <div class="video-card__thumb">
              <img src={`https://img.youtube.com/vi/${ytId}/hqdefault.jpg`} alt={video.title} loading="lazy" />
              <div class="video-card__play">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.6)"/><path d="M19 15l14 9-14 9V15z" fill="#fff"/></svg>
              </div>
            </div>
            <div class="video-card__info">
              <h3 class="video-card__title">{video.title}</h3>
              <p class="video-card__creator">{video.creator}</p>
              <p class="video-card__note">{video.note}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- SEO context — visually subtle, content-rich for search engines -->
  <section class="section" style="padding: 1.5rem 2rem 0;">
    <div style="max-width:54rem; margin:0 auto; border-top:1px solid #e8e5e0; padding-top:1.5rem;">
      <p style="font-size:13px; line-height:1.9; color:#9a9590; text-align:center;">Planning a South China trip from Toronto or elsewhere in Canada? Start with the <a href="/handbook" style="color:#b8524a;">handbook</a>, then check the <a href="/about" style="color:#b8524a;">team background</a> and <a href="/privacy" style="color:#b8524a;">privacy policy</a>.</p>
    </div>
  </section>

  <section id="faq" class="faq">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">FAQ</p>
        <h2 class="section-title">Frequently Asked Questions</h2>
      </div>
      <div class="faq__list">
        {faq.map((f, i) => (
          <div class="faq__item" id={`sc-faq-${i}`}>
            <button class="faq__q" aria-expanded="false" aria-controls={`sc-faq-answer-${i}`}>
              <span>{f.q}</span>
              <svg class="faq__icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <div class="faq__a" id={`sc-faq-answer-${i}`} role="region" aria-labelledby={`sc-faq-${i}`}>
              <div class="faq__a-inner">{f.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="apply" class="route-apply">
    <div class="container" style="text-align:center; padding-top:0; padding-bottom:0;">
      <p class="section-eyebrow" style="color:rgba(255,255,255,0.6);">Apply</p>
      <h2 class="section-title" style="color:#fff; margin-bottom:1rem;">Ready to go?</h2>
      <p style="color:rgba(255,255,255,0.72); font-size:clamp(0.95rem,2vw,1.05rem); line-height:1.75; max-width:460px; margin:0 auto 1.25rem;">
        Tell us about yourself and which trip you're interested in — we'll follow up within 5 business days.
      </p>
      <p style="color:rgba(255,255,255,0.55); font-size:clamp(0.8rem,1.6vw,0.875rem); line-height:1.7; max-width:420px; margin:0 auto 2rem;">
        The route ends in Shenzhen — but on Day 10, participants can also depart from Hong Kong International Airport (45 min away). Let us know your preference when you apply.
      </p>
      <a href="/apply"
        style="display:inline-block; background:var(--color-red,#c8102e); color:#fff; padding:0.9rem 2.5rem; font-size:0.875rem; font-weight:600; letter-spacing:0.08em; text-decoration:none; text-transform:uppercase; transition:background 0.2s;"
        onmouseover="this.style.background='#a00d24'"
        onmouseout="this.style.background='var(--color-red,#c8102e)'">
        Apply Now →
      </a>
    </div>
  </section>
</Layout>

<style>
.trip-hero {
  position: relative;
  height: clamp(480px, 65vh, 720px);
  overflow: hidden;
}
.trip-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.trip-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 2.5rem;
  text-align: center;
}
.trip-hero__title {
  color: #fff;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  font-family: var(--font-display);
  line-height: 1.1;
  margin-bottom: 0.75rem;
}
.trip-hero__sub {
  color: rgba(255,255,255,0.85);
  font-size: 1.1rem;
  max-width: 640px;
  line-height: 1.7;
}
</style>

<script is:inline>
// ── FAQ accordion ──────────────────────────────────────
document.querySelectorAll('.faq__item').forEach(item => {
  const btn = item.querySelector('.faq__q');
  const answer = item.querySelector('.faq__a');
  btn?.addEventListener('click', () => {
    const open = item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    if (answer) answer.style.maxHeight = open ? answer.scrollHeight + 'px' : '0';
  });
});

// ── Itinerary day accordion ────────────────────────────
document.querySelectorAll('.itinerary-day').forEach(day => {
  const header = day.querySelector('[data-day-toggle]');
  const body = day.querySelector('[data-day-body]');
  if (!header || !body) return;
  header.addEventListener('click', () => {
    const open = body.classList.toggle('is-open');
    header.setAttribute('aria-expanded', String(open));
  });
});

// ── Highlights marquee (JS rAF — works in Safari) ──────
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  document.querySelectorAll('.highlights-strip__stage').forEach(function (stage) {
    var rows = stage.querySelectorAll('.highlights-strip__row');

    rows.forEach(function (row, i) {
      var track = row.querySelector('.highlights-strip__track');
      if (!track) return;

      var originals = track.querySelectorAll('.highlights-strip__card:not([aria-hidden="true"])');
      if (!originals.length) return;
      var cardW = originals[0].offsetWidth;
      var gap = 12;
      var setWidth = originals.length * (cardW + gap);

      var isRight = (i === 1);
      var speed = isRight ? 0.45 : 0.55;
      var pos = isRight ? -setWidth : 0;
      var paused = false;

      row.addEventListener('mouseenter', function () { paused = true; });
      row.addEventListener('mouseleave', function () { paused = false; });

      row.addEventListener('click', function (e) {
        var card = e.target.closest('.highlights-strip__card');
        var allCards = stage.querySelectorAll('.highlights-strip__card');
        if (card) {
          var wasActive = card.classList.contains('is-active');
          allCards.forEach(function (c) { c.classList.remove('is-active'); });
          if (!wasActive) { card.classList.add('is-active'); paused = true; }
          else { paused = false; }
        } else {
          allCards.forEach(function (c) { c.classList.remove('is-active'); });
          paused = false;
        }
      });

      track.style.transform = 'translate3d(' + pos + 'px, 0, 0)';

      function tick() {
        if (!paused) {
          pos += isRight ? speed : -speed;
          if (!isRight && pos <= -setWidth) pos += setWidth;
          if (isRight  && pos >= 0)         pos  = -setWidth;
          track.style.transform = 'translate3d(' + pos + 'px, 0, 0)';
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  });
}());

</script>
