---
import Layout from '../../layouts/Layout.astro';
import { getTripById } from '../../data/registry';
import {
  southChinaItinerary,
  southChinaCityGuides,
  southChinaFaq,
  southChinaIncluded,
  southChinaNotIncluded,
  southChinaVideos,
} from '../../data/south-china.ts';

const trip            = getTripById('south-china-2026-summer')!;
const itinerary       = southChinaItinerary;
const cityGuides      = southChinaCityGuides;
const faq             = southChinaFaq;
const included        = southChinaIncluded;
const notIncluded     = southChinaNotIncluded;
const recommendedVideos = southChinaVideos;

// Pre-compute slides for each day in the frontmatter (TypeScript safe)
type LandmarkItem = { name: string; nameZh: string; image: string; background: string; backgroundZh: string };
type CitySlide = { type: 'city'; guide: typeof cityGuides[0] };
type LandmarkSlide = { type: 'landmark'; lm: LandmarkItem };
type DaySlide = CitySlide | LandmarkSlide;

const itineraryWithSlides = itinerary.map((d, idx) => {
  const isFirstCityDay = idx === 0 || itinerary[idx - 1].city !== d.city;
  const cityGuide = cityGuides.find(g => g.city === d.city);
  const landmarks: LandmarkItem[] = (d as any).landmarks ?? [];
  const slides: DaySlide[] = [
    ...(isFirstCityDay && cityGuide ? [{ type: 'city' as const, guide: cityGuide }] : []),
    ...landmarks.map(lm => ({ type: 'landmark' as const, lm })),
  ];
  return { ...d, isFirstCityDay, slides };
});

const tripStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: trip.title,
    description:
      'A 10-day student travel route through Xiamen, Chaoshan, Shenzhen and Hong Kong — cultural depth, coastal energy, and East-meets-West intensity.',
    itinerary: itinerary.map((day) => `${day.day}: ${day.city} - ${day.title}`),
    touristType: 'Students and young travelers from Canada',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.explorechina.ca/' },
      { '@type': 'ListItem', position: 2, name: 'South China Route', item: 'https://www.explorechina.ca/trips/south-china-2026-summer' },
    ],
  },
];
---
<Layout
  title={`${trip.title} · Explore China 2026`}
  description="A 10-day student travel route through Xiamen, Chaoshan, Shenzhen and Hong Kong — cultural depth, coastal energy, and East-meets-West intensity."
  lang="en"
  alternateHref="/zh/trips/south-china-2026-summer"
  alternateLabel="中文"
  canonical="/trips/south-china-2026-summer"
  structuredData={tripStructuredData}
  darkNav={true}
>

  <div class="trip-hero">
    <img
      src="https://images.unsplash.com/photo-1506812574058-fc75fa93fead?auto=format&fit=crop&w=1600&q=80"
      alt="Xiamen coastal view at dusk"
      class="trip-hero__img"
    />
    <div class="trip-hero__overlay">
      <h1 class="trip-hero__title">{trip.title}</h1>
      <p class="trip-hero__sub">{trip.summary}</p>
    </div>
  </div>

  <section id="overview" class="trip-strip">
    <div class="trip-strip__inner">
      <div class="trip-strip__facts">
        <div class="trip-strip__fact"><span class="trip-strip__label">Route</span><span class="trip-strip__val">{trip.routeName}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Departure</span><span class="trip-strip__val">{trip.departureWindow}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Price</span><span class="trip-strip__val trip-strip__val--price">{trip.priceCad}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Group</span><span class="trip-strip__val">{trip.groupSize}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Deadline</span><span class="trip-strip__val">{trip.applicationDeadline}</span></div>
      </div>
      <div class="trip-strip__actions">
        <a class="trip-cta" href="#apply">Apply for This Trip</a>
      </div>
    </div>
  </section>

  <!-- Highlights Strip -->
  <section class="highlights-strip" aria-label="Route highlights">

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1574285013029-29296a71930e?auto=format&fit=crop&w=600&q=80" alt="Gulangyu Island colonial architecture" loading="lazy" />
      <p class="highlights-strip__caption">An island with 13 former consulates and no cars</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1569050467447-ce54b3bbc37d?auto=format&fit=crop&w=600&q=80" alt="Satay noodles Xiamen" loading="lazy" />
      <p class="highlights-strip__caption">A bowl of peanut broth that Xiamen calls its own</p>
    </div>

    <div class="highlights-strip__card">
      <img src="/images/places/quanzhou-temple-1.jpg" alt="Quanzhou ancient temple architecture" loading="lazy" />
      <p class="highlights-strip__caption">2,600 years of continuous civilization in one walled city</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1557872943-16a5ac26437e?auto=format&fit=crop&w=600&q=80" alt="Chaoshan beef hotpot" loading="lazy" />
      <p class="highlights-strip__caption">Fresh-cut beef, still warm from the market, in clear broth</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1512632578888-169bbbc64f33?auto=format&fit=crop&w=600&q=80" alt="Shenzhen modern skyline" loading="lazy" />
      <p class="highlights-strip__caption">A fishing village of 30,000 that became a city of 17 million</p>
    </div>

    <div class="highlights-strip__card">
      <img src="https://images.unsplash.com/photo-1536240478700-b869ad10e128?auto=format&fit=crop&w=600&q=80" alt="Hong Kong harbour star ferry" loading="lazy" />
      <p class="highlights-strip__caption">Eleven minutes across the harbour. Two very different cities.</p>
    </div>

  </section>

  <section class="route-intro">
  <div class="route-intro__inner">
    <div class="route-intro__rule"></div>

    <p class="route-intro__headline">
      Four cities. Four different Chinas.
    </p>

    <div class="route-intro__body">
      <p>
        The South China Route moves through a register of the country that most travelers miss:
        Xiamen's colonial sea air and diaspora nostalgia, the ancient Teochew civilization of
        Chaoshan, Shenzhen's speed-built ambition, and finally Hong Kong — the place where East
        and West stopped being a metaphor and became actual streets, food stalls, and a way of
        moving through the world.
      </p>
      <span class="route-intro__pivot">Read the full story ↓</span>
    </div>

    <button class="route-intro__toggle" id="route-intro-toggle" aria-expanded="false">
      Read the full story ↓
    </button>

    <div class="route-intro__expandable" id="route-intro-body">
      <div class="route-intro__body">

        <span class="route-intro__city-label">Xiamen</span>
        <p>The sea arrives before the city does. You smell it first — salt and rain and something faintly sweet that turns out to be incense from the temple at the end of the lane. On Gulangyu the streets are too narrow for cars, which means you hear everything: piano scales from a second-floor window, the clatter of a bicycle, someone's grandmother arguing with a fruit seller. The pace is different here. You will notice it by the end of the first afternoon.</p>

        <span class="route-intro__city-label">Chaoshan</span>
        <p>Chaoshan moves at the speed of tea. A session here is not a tourist activity — it's how people talk. Your host will fill the tiny cup before it empties; refusing means you want to leave. Sit long enough and the conversation finds its own rhythm. The beef at dinner was in a paddock this morning. The noodles were made by hand two hours ago. Everything is closer to its source than you expect.</p>

        <span class="route-intro__city-label">Shenzhen</span>
        <p>Shenzhen announces itself through scale. The buildings are enormous and new and completely unapologetic about it. There is no nostalgia here — the city is 45 years old and knows it. What you find instead is energy: the electronics market where engineers source components at 8am, the art district that appeared in a former factory compound, the young residents who came from everywhere else and are still figuring out what kind of place this is.</p>

        <span class="route-intro__city-label">Hong Kong</span>
        <p>Hong Kong runs on compression. The trams move slowly through streets packed tight with signage in three scripts. The Star Ferry costs almost nothing and takes ten minutes and gives you the full sweep of the harbour in both directions. In the wet market at dawn the fish are still moving. In the evening the light from ten thousand windows turns the harbour gold. The city is dense and real and entirely itself.</p>

      </div>

      <p class="route-intro__colophon">
        10 days &nbsp;·&nbsp; Xiamen · Chaoshan · Shenzhen · Hong Kong
      </p>
    </div>
  </div>
</section>

<script>
  const toggle = document.getElementById('route-intro-toggle');
  const body = document.getElementById('route-intro-body');
  if (toggle && body) {
    toggle.addEventListener('click', () => {
      const isOpen = body.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.textContent = isOpen ? 'Close ↑' : 'Read the full story ↓';
    });
  }
</script>

  <section id="who-is-this-for" class="section" style="padding: 4rem 2rem;">
    <div style="max-width:48rem; margin:0 auto;">
      <h2 style="font-size:clamp(20px,3vw,30px); font-weight:700; font-family:var(--font-display); line-height:1.2; margin-bottom:1.25rem;">This route is for people who want the version of China that takes a little more effort to reach.</h2>
      <p class="muted" style="font-size:clamp(0.9rem,1.5vw,1.05rem); line-height:1.85; margin-bottom:1rem;">A slower tea ceremony. A border crossing. A fishing village. A UNESCO island you reach by ferry.</p>
      <p class="muted" style="font-size:clamp(0.9rem,1.5vw,1.05rem); line-height:1.85; margin-bottom:1rem;">No prior China experience required. No Mandarin. The complicated parts — payments, SIM cards, cross-border logistics — are already handled.</p>
      <p class="muted" style="font-size:clamp(0.9rem,1.5vw,1.05rem); line-height:1.85; padding-bottom:1.5rem;">Curiosity is enough.</p>
    </div>
  </section>

  <section id="itinerary" class="section card tone-sand">
    <h2 class="section-title">10-day route at a glance</h2>
    <p class="section-sub" style="margin-bottom:2rem;">Click any day to explore the places you'll visit.</p>

    <div class="itinerary-accordion">
      {itineraryWithSlides.map((d, idx) => (
          <div
            class={`itinerary-day${d.isFirstCityDay ? ' itinerary-day--city-start' : ''}`}
            data-day-idx={idx}
          >
            <button class="itinerary-day__header" data-day-toggle aria-expanded="false">
              <span class="itinerary-day__number">{d.day}</span>
              <span class="itinerary-day__dot"></span>
              <div class="itinerary-day__meta">
                <span class="itinerary-day__city">{d.city}</span>
                <h3 class="itinerary-day__title">{d.title}</h3>
                <p class="itinerary-day__plan">{d.plan}</p>
              </div>
              <span class="itinerary-day__toggle-icon" aria-hidden="true">+</span>
            </button>

            <div class="itinerary-day__body" data-day-body>
              <div class="itinerary-day__body-inner">
                {d.slides.length > 0 && (
                  <div class="landmark-carousel">
                    <button class="landmark-carousel__btn landmark-carousel__btn--prev" aria-label="Previous">←</button>
                    <div class="landmark-carousel__track-wrap">
                      <div class="landmark-carousel__track">

                        {d.slides.map((slide) => (
                          <div class="landmark-carousel__slide">
                            {slide.type === 'city' ? (
                              <div class="city-intro-card">
                                <div class="city-intro-card__image">
                                  <img
                                    src={slide.guide.heroImage}
                                    alt={slide.guide.heroAlt}
                                    loading="lazy"
                                  />
                                </div>
                                <div class="city-intro-card__content">
                                  <span class="city-intro-card__label">City overview</span>
                                  <h3 class="city-intro-card__city">{slide.guide.city}</h3>
                                  <p class="city-intro-card__desc">{slide.guide.context}</p>
                                </div>
                              </div>
                            ) : (
                              <div class="landmark-card">
                                <div class="landmark-card__visual">
                                  <img
                                    src={slide.lm.image}
                                    alt={slide.lm.name}
                                    loading="lazy"
                                  />
                                </div>
                                <div class="landmark-card__base-overlay"></div>
                                <div class="landmark-card__name-overlay">
                                  <p class="landmark-card__name">{slide.lm.name}</p>
                                  <p class="landmark-card__name-zh">{slide.lm.nameZh}</p>
                                </div>
                                <div class="landmark-card__overlay"></div>
                                <div class="landmark-card__body">
                                  <p class="landmark-card__body-name">{slide.lm.name}</p>
                                  <p class="landmark-card__body-name-zh">{slide.lm.nameZh}</p>
                                  <p class="landmark-card__background">{slide.lm.background}</p>
                                </div>
                              </div>
                            )}
                          </div>
                        ))}

                      </div>
                    </div>
                    <button class="landmark-carousel__btn landmark-carousel__btn--next" aria-label="Next">→</button>
                  </div>
                )}
              </div>
            </div>
          </div>
      ))}
    </div>
  </section>

  <section class="section incl-grid">
    <article class="incl-card incl-card--yes">
      <h2 class="incl-card__title">Included</h2>
      <ul class="incl-list">
        {included.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--yes">✓</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
    <article class="incl-card incl-card--no">
      <h2 class="incl-card__title">Not included</h2>
      <ul class="incl-list">
        {notIncluded.map((item) => (
          <li class="incl-item"><i class="incl-icon incl-icon--no">×</i><span>{item}</span></li>
        ))}
      </ul>
    </article>
  </section>

  <section class="section card tone-blue">
    <h2 class="section-title">Video references before you decide</h2>
    <div class="grid cols-3 video-grid">
      {recommendedVideos.map((video) => {
        const ytId = video.url.match(/[?&]v=([^&]+)/)?.[1] || '';
        return (
          <a href={video.url} target="_blank" rel="noopener" class="video-card">
            <div class="video-card__thumb">
              <img src={`https://img.youtube.com/vi/${ytId}/hqdefault.jpg`} alt={video.title} loading="lazy" />
              <div class="video-card__play">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.6)"/><path d="M19 15l14 9-14 9V15z" fill="#fff"/></svg>
              </div>
            </div>
            <div class="video-card__info">
              <h3 class="video-card__title">{video.title}</h3>
              <p class="video-card__creator">{video.creator}</p>
              <p class="video-card__note">{video.note}</p>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- SEO context — visually subtle, content-rich for search engines -->
  <section class="section" style="padding: 1.5rem 2rem 0;">
    <div style="max-width:54rem; margin:0 auto; border-top:1px solid #e8e5e0; padding-top:1.5rem;">
      <p style="font-size:13px; line-height:1.9; color:#9a9590; text-align:center;">Planning a South China trip from Toronto or elsewhere in Canada? Start with the <a href="/handbook" style="color:#b8524a;">handbook</a>, then check the <a href="/about" style="color:#b8524a;">team background</a> and <a href="/privacy" style="color:#b8524a;">privacy policy</a>.</p>
    </div>
  </section>

  <section id="faq" class="faq">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">FAQ</p>
        <h2 class="section-title">Frequently Asked Questions</h2>
      </div>
      <div class="faq__list">
        {faq.map((f, i) => (
          <div class="faq__item" id={`sc-faq-${i}`}>
            <button class="faq__q" aria-expanded="false" aria-controls={`sc-faq-answer-${i}`}>
              <span>{f.q}</span>
              <svg class="faq__icon" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <div class="faq__a" id={`sc-faq-answer-${i}`} role="region" aria-labelledby={`sc-faq-${i}`}>
              <div class="faq__a-inner">{f.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="apply" class="route-apply">
    <div class="container" style="text-align:center; padding-top:0; padding-bottom:0;">
      <p class="section-eyebrow" style="color:rgba(255,255,255,0.6);">Apply</p>
      <h2 class="section-title" style="color:#fff; margin-bottom:1rem;">Ready to go?</h2>
      <p style="color:rgba(255,255,255,0.72); font-size:clamp(0.95rem,2vw,1.05rem); line-height:1.75; max-width:460px; margin:0 auto 2rem;">
        Tell us about yourself and which trip you're interested in — we'll follow up within 5 business days.
      </p>
      <a href="/apply"
        style="display:inline-block; background:var(--color-red,#c8102e); color:#fff; padding:0.9rem 2.5rem; font-size:0.875rem; font-weight:600; letter-spacing:0.08em; text-decoration:none; text-transform:uppercase; transition:background 0.2s;"
        onmouseover="this.style.background='#a00d24'"
        onmouseout="this.style.background='var(--color-red,#c8102e)'">
        Apply Now →
      </a>
    </div>
  </section>
</Layout>

<style>
.trip-hero {
  position: relative;
  height: 420px;
  overflow: hidden;
}
.trip-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.trip-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 2.5rem;
  text-align: center;
}
.trip-hero__title {
  color: #fff;
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  font-family: var(--font-display);
  line-height: 1.1;
  margin-bottom: 0.75rem;
}
.trip-hero__sub {
  color: rgba(255,255,255,0.85);
  font-size: 1.1rem;
  max-width: 640px;
  line-height: 1.7;
}
</style>

<script is:inline>
// ── FAQ accordion ──────────────────────────────────────
document.querySelectorAll('.faq__item').forEach(item => {
  const btn = item.querySelector('.faq__q');
  const answer = item.querySelector('.faq__a');
  btn?.addEventListener('click', () => {
    const open = item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(open));
    if (answer) answer.style.maxHeight = open ? answer.scrollHeight + 'px' : '0';
  });
});

// ── Itinerary day accordion ────────────────────────────
document.querySelectorAll('.itinerary-day').forEach(day => {
  const header = day.querySelector('[data-day-toggle]');
  const body = day.querySelector('[data-day-body]');
  if (!header || !body) return;
  header.addEventListener('click', () => {
    const open = body.classList.toggle('is-open');
    header.setAttribute('aria-expanded', String(open));
  });
});

// ── Landmark carousels ─────────────────────────────────
document.querySelectorAll('.landmark-carousel').forEach(carousel => {
  const track = carousel.querySelector('.landmark-carousel__track');
  const slides = carousel.querySelectorAll('.landmark-carousel__slide');
  const prevBtn = carousel.querySelector('.landmark-carousel__btn--prev');
  const nextBtn = carousel.querySelector('.landmark-carousel__btn--next');
  if (!track || slides.length === 0) return;

  let current = 0;
  const total = slides.length;

  function goTo(n) {
    current = Math.max(0, Math.min(n, total - 1));
    const slideWidth = slides[0].offsetWidth + 12;
    track.style.transform = `translateX(-${current * slideWidth}px)`;
  }

  prevBtn?.addEventListener('click', () => goTo(current - 1));
  nextBtn?.addEventListener('click', () => goTo(current + 1));

  let touchX = 0;
  carousel.addEventListener('touchstart', e => { touchX = e.touches[0].clientX; }, { passive: true });
  carousel.addEventListener('touchend', e => {
    const delta = touchX - e.changedTouches[0].clientX;
    if (Math.abs(delta) > 40) goTo(current + (delta > 0 ? 1 : -1));
  });
});
</script>
