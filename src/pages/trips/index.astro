---
import Layout from '../../layouts/Layout.astro';
import { tripsMeta } from '../../data/trips-meta.ts';
---

<Layout
  title="Upcoming Trips | Explore China 2026"
  description="Browse all Explore China trip routes for Canadian university students."
  lang="en"
  canonical="/trips"
  alternateHref="/zh/trips"
  alternateLabel="中文"
>
  <section style="padding: var(--section-gap) 0 clamp(2rem,5vw,4rem);">
    <div class="container" style="text-align:center;">
      <p class="section-eyebrow">Our Routes</p>
      <h1 class="section-title">Upcoming Trips</h1>
      <p class="section-sub" style="text-align:center;">
        Three routes. Different Chinas. Choose the one that fits how you want to travel.
      </p>
    </div>
  </section>

  <section class="trips-list">
    <div class="container">

      {tripsMeta.map((trip) => (
        trip.status === 'open' ? (
          <a href={trip.href} class="trip-listing-card">
            <div class="trip-listing-card__img">
              {trip.image && <img src={trip.image} alt={trip.imageAlt} loading="lazy" />}
            </div>
            <div class="trip-listing-card__body">
              <div class="trip-listing-card__top">
                <div>
                  <h2 class="trip-listing-card__title">{trip.title}</h2>
                  <p class="trip-listing-card__subtitle">{trip.subtitle}</p>
                </div>
                <span class="trip-badge trip-badge--open">Open</span>
              </div>
              <p class="trip-listing-card__desc">{trip.description}</p>
              <div class="trip-listing-card__stats">
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">Duration</span>
                  <span class="trip-listing-card__stat-value">{trip.duration}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">Cities</span>
                  <span class="trip-listing-card__stat-value">{trip.cities}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">Departure</span>
                  <span class="trip-listing-card__stat-value">{trip.departure}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">From</span>
                  <span class="trip-listing-card__stat-value trip-listing-card__stat-value--price">{trip.price}</span>
                </div>
              </div>
              <div class="trip-listing-card__footer">
                <span class="trip-cta">View Itinerary →</span>
              </div>
            </div>
          </a>
        ) : (
          <div class="trip-listing-card trip-listing-card--soon">
            <div class="trip-listing-card__img">
              {trip.image
                ? <img src={trip.image} alt={trip.imageAlt} loading="lazy" />
                : <div class="trip-listing-card__img-placeholder"></div>
              }
            </div>
            <div class="trip-listing-card__body">
              <div class="trip-listing-card__top">
                <div>
                  <h2 class="trip-listing-card__title">{trip.title}</h2>
                  <p class="trip-listing-card__subtitle">{trip.subtitle}</p>
                </div>
                <span class="trip-badge trip-badge--soon">Coming Soon</span>
              </div>
              <p class="trip-listing-card__desc">{trip.description}</p>
              <div class="trip-listing-card__stats">
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">Duration</span>
                  <span class="trip-listing-card__stat-value">{trip.duration}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">Cities</span>
                  <span class="trip-listing-card__stat-value">{trip.cities}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">Departure</span>
                  <span class="trip-listing-card__stat-value">{trip.departure}</span>
                </div>
                <div class="trip-listing-card__stat">
                  <span class="trip-listing-card__stat-label">Price</span>
                  <span class="trip-listing-card__stat-value">{trip.price}</span>
                </div>
              </div>
              <div class="trip-listing-card__footer">
                <span style="color:#a8a29e; font-size:0.875rem;">Details coming soon</span>
              </div>
            </div>
          </div>
        )
      ))}

    </div>
  </section>
</Layout>

<style>
.trip-listing-card--soon {
  opacity: 0.72;
  cursor: default;
}
.trip-listing-card__img-placeholder {
  width: 100%;
  height: 100%;
  background: #e7e5e0;
}
</style>
