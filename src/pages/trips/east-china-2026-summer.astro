---
import Layout from '../../layouts/Layout.astro';
import { getTripById } from '../../data/registry';
import TripWhyUs from '../../components/v1/TripWhyUs.astro';
import TripPriceBreakdown from '../../components/v1/TripPriceBreakdown.astro';
import {
  faq,
  included,
  notIncluded,
  cityGuides,
  itinerary,
  recommendedVideos,
} from '../../data/site';

const trip = getTripById('east-china-2026-summer')!;

// Pre-compute slides for each day in the frontmatter (TypeScript safe)
type LandmarkItem = { name: string; nameZh: string; image: string; background: string; backgroundZh: string };
type CitySlide = { type: 'city'; guide: typeof cityGuides[0] };
type LandmarkSlide = { type: 'landmark'; lm: LandmarkItem };
type DaySlide = CitySlide | LandmarkSlide;

const itineraryWithSlides = itinerary.map((d, idx) => {
  const isFirstCityDay = idx === 0 || itinerary[idx - 1].city !== d.city;
  const cityGuide = cityGuides.find(g => g.city === d.city);
  const landmarks: LandmarkItem[] = (d as any).landmarks ?? [];
  const slides: DaySlide[] = [
    ...(isFirstCityDay && cityGuide ? [{ type: 'city' as const, guide: cityGuide }] : []),
    ...landmarks.map(lm => ({ type: 'landmark' as const, lm })),
  ];
  return { ...d, isFirstCityDay, slides };
});

const tripStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: trip.title,
    description:
      'A 10-day student-led China summer trip from Canada covering Shanghai, Suzhou, Hangzhou, and Beijing.',
    itinerary: itinerary.map((day) => `${day.day}: ${day.city} - ${day.title}`),
    touristType: 'Students and young travelers from Canada',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.explorechina.ca/' },
      { '@type': 'ListItem', position: 2, name: 'Trip', item: 'https://www.explorechina.ca/trips/east-china-2026-summer' },
    ],
  },
];
---
<Layout
  title={trip.title}
  description="2026 summer student trip to China from Canada. 10-day route: Shanghai, Suzhou, Hangzhou, Beijing. Includes accommodation, transport, cultural activities. ~CAD $3,000."
  lang="en"
  alternateHref="/zh/trips/east-china-2026-summer"
  alternateLabel="中文"
  canonical="/trips/east-china-2026-summer"
  structuredData={tripStructuredData}
  darkNav={true}
>

  <div class="trip-hero">
    <img
      src="/images/highlights/forbidden-city.jpg"
      alt="Forbidden City, Beijing"
      class="trip-hero__img"
    />
    <div class="trip-hero__overlay">
      <h1 class="trip-hero__title">{trip.title}</h1>
      <p class="trip-hero__sub">{trip.summary}</p>
    </div>
  </div>

  <section id="overview" class="trip-strip">
    <div class="trip-strip__inner">
      <div class="trip-strip__facts">
        <div class="trip-strip__fact"><span class="trip-strip__label">Route</span><span class="trip-strip__val">{trip.routeName}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Departure</span><span class="trip-strip__val">{trip.departureWindow}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Price</span><span class="trip-strip__val trip-strip__val--price">{trip.priceCad}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Group</span><span class="trip-strip__val">{trip.groupSize}</span></div>
        <div class="trip-strip__fact"><span class="trip-strip__label">Deadline</span><span class="trip-strip__val">{trip.applicationDeadline}</span></div>
      </div>
      <div class="trip-strip__actions">
        <a class="trip-cta" href="#apply">Apply for This Trip</a>
      </div>
    </div>
  </section>

  <!-- Highlights Strip -->
  <section class="highlights-strip" aria-label="Route highlights">
    <div class="highlights-strip__header">
      <p class="highlights-strip__eyebrow">Route Highlights</p>
      <h2 class="highlights-strip__title">What you'll see</h2>
    </div>
    <div class="highlights-strip__stage">

      <!-- Row 1 → left (images 1–9) -->
      <div class="highlights-strip__row highlights-strip__row--1">
        <div class="highlights-strip__track">
          <div class="highlights-strip__card"><img src="/images/highlights/ec-bund.jpg" alt="Shanghai Bund skyline at night" loading="lazy" /><p class="highlights-strip__caption">A waterfront that rewrote the skyline and never looked back</p></div>
          <div class="highlights-strip__card"><img src="/images/highlights/ec-suzhou-garden.jpg" alt="Suzhou classical garden" loading="lazy" /><p class="highlights-strip__caption">Where every rock, pond, and gate was placed with intention</p></div>
          <div class="highlights-strip__card"><img src="/images/highlights/ec-forbidden-city.jpg" alt="Forbidden City Beijing" loading="lazy" /><p class="highlights-strip__caption">A city within walls, built for emperors and time itself</p></div>
          <div class="highlights-strip__card"><img src="/images/highlights/ec-pingjiang-canal.jpg" alt="Suzhou Pingjiang Road canal at night" loading="lazy" /><p class="highlights-strip__caption">Canal streets where time slows to a quiet rhythm</p></div>
          <div class="highlights-strip__card"><img src="/images/highlights/ec-west-lake.jpg" alt="West Lake Hangzhou" loading="lazy" /><p class="highlights-strip__caption">Lake light, willow shade, and a calm that settles before you do</p></div>
          <div class="highlights-strip__card"><img src="/images/highlights/ec-lingyin-temple.jpg" alt="Lingyin Temple Hangzhou" loading="lazy" /><p class="highlights-strip__caption">Stillness held in stone, incense, and hillside air</p></div>
          <div class="highlights-strip__card"><img src="/images/highlights/ec-summer-palace.jpg" alt="Summer Palace Beijing" loading="lazy" /><p class="highlights-strip__caption">Painted beams stretching further than you expect, step after step</p></div>
