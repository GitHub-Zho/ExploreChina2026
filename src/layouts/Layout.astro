---
import '../styles/global.css';
import Navbar from '../components/v1/Navbar.astro';
import Footer from '../components/v1/Footer.astro';
import { site, analytics } from '../data/site';

const {
  title = 'Explore China',
  description,
  lang = 'en',
  canonical,
  ogImage,
  alternateHref,
  alternateLabel,
  minimalNav = false,
  minimalShowApply = true,
  darkNav = true,
  heroNav = false,
  noindex = false,
  structuredData = [],
} = Astro.props as {
  title?: string;
  description?: string;
  lang?: 'en' | 'zh';
  canonical?: string;
  ogImage?: string;
  alternateHref: string;
  alternateLabel: string;
  minimalNav?: boolean;
  minimalShowApply?: boolean;
  darkNav?: boolean;
  heroNav?: boolean;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const pageDescription =
  description ??
  (lang === 'zh'
    ? '面向加拿大学生与年轻旅行者的中国文化旅行项目。2026暑期路线涵盖上海、苏州、杭州、北京及云南（昆明、大理、丽江），由多伦多大学学生团队组织。'
    : 'Student-led China travel program for university students from Canada. Summer 2026 routes cover Shanghai, Suzhou, Hangzhou, Beijing, and Yunnan (Kunming, Dali, Lijiang). Organized by UofT students.');

const canonicalUrl = canonical ? new URL(canonical, Astro.site).toString() : Astro.url.href;
const alternateUrl = new URL(alternateHref, Astro.site).toString();
// x-default should point at the EN version of THIS page, not the homepage.
const xDefaultUrl = lang === 'zh' ? alternateUrl : canonicalUrl;
const socialImageUrl = new URL(
  ogImage ?? '/images/highlights/forbidden-city.jpg',
  Astro.site
).toString();

const baseStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: 'https://www.explorechina.ca/',
    email: site.email,
    sameAs: [site.instagramUrl, site.instagramLegacyUrl],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: pageDescription,
    url: canonicalUrl,
    inLanguage: lang === 'zh' ? 'zh-CN' : 'en-CA',
  },
];

const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = JSON.stringify(
  [...baseStructuredData, ...pageStructuredData.filter(Boolean)],
  null,
  2
);
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&display=swap" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alternateUrl} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Explore China" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={jsonLd}></script>
    <title>{title}</title>

    <!-- ── Tracking helper + UTM capture (always present; providers optional) ── -->
    <script is:inline>
      // ecTrack(event, params): safe fan-out to whichever providers are loaded.
      // 'apply_submitted' maps to Meta's standard Lead event (ad optimization).
      window.ecTrack = function (event, params) {
        try {
          if (window.gtag) window.gtag('event', event, params || {});
          if (window.fbq) {
            if (event === 'apply_submitted') window.fbq('track', 'Lead', params || {});
            else window.fbq('trackCustom', event, params || {});
          }
        } catch (e) { /* tracking must never break the page */ }
      };
      // Capture ad UTM parameters on landing; the apply form attaches them
      // to the submission payload so the Google Sheet gets attribution.
      (function () {
        try {
          var q = new URLSearchParams(location.search);
          var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
          var got = {}; var any = false;
          keys.forEach(function (k) { var v = q.get(k); if (v) { got[k] = v; any = true; } });
          if (any) sessionStorage.setItem('ec_utm', JSON.stringify(got));
        } catch (e) { /* ignore */ }
      })();
    </script>

    {analytics.ga4MeasurementId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics.ga4MeasurementId}`}></script>
    )}
    {analytics.ga4MeasurementId && (
      <script is:inline define:vars={{ gaId: analytics.ga4MeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}
    {analytics.metaPixelId && (
      <script is:inline define:vars={{ pixelId: analytics.metaPixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body {...(darkNav ? { 'data-navbar-dark': '' } : {})}>
    <Navbar
      lang={lang}
      alternateHref={alternateHref}
      alternateLabel={alternateLabel}
      minimal={minimalNav}
      minimalShowApply={minimalShowApply}
      hero={heroNav}
    />
    <main class="pt-16 md:pt-20">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
